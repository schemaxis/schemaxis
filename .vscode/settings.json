{
  "json.schemas": [
    {
      "fileMatch": ["/input.json", "/inputs/**/*.json", "**/*.schemaxis.json", "/examples/schemaxis/*.json", "/examples/cfd-postprocess/*.json"],
      "url": "./docs/generated/schemaxis-authored.schema.json"
    }
  ],
  "yaml.schemas": {
    "./docs/generated/schemaxis-authored.schema.json": [
      "/input.yaml", "/input.yml", "/inputs/**/*.yaml", "/inputs/**/*.yml",
      "**/*.schemaxis.yaml", "**/*.schemaxis.yml",
      "/examples/schemaxis/*.yaml", "/examples/schemaxis/*.yml",
      "/examples/cfd-postprocess/*.yaml", "/examples/cfd-postprocess/*.yml"
    ]
  }
}
