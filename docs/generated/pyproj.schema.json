{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.pyproj/1"
    },
    "operation": {
      "const": "routeStations"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "ellipsoid": {
      "enum": [
        "WGS84"
      ]
    },
    "coordinateOrder": {
      "enum": [
        "lonLat"
      ]
    },
    "spacing_m": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1000000.0
    },
    "closed": {
      "type": "boolean",
      "default": false
    },
    "requirements": {
      "type": "object",
      "properties": {
        "totalLength_m": {
          "type": "object",
          "properties": {
            "minimum": {
              "type": "number",
              "minimum": 0,
              "maximum": 20000000.0
            },
            "maximum": {
              "type": "number",
              "minimum": 0,
              "maximum": 20000000.0
            }
          },
          "additionalProperties": false
        },
        "endpointGap_m": {
          "type": "object",
          "properties": {
            "maximum": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000000.0
            }
          },
          "additionalProperties": false,
          "required": [
            "maximum"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "source",
    "ellipsoid",
    "coordinateOrder",
    "spacing_m"
  ]
}
