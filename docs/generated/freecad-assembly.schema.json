{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schemaxis assembly literal settings",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.freecad.assembly/1"
    },
    "units": {
      "const": "mm"
    },
    "parts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "type": {
                "const": "box"
              },
              "options": {
                "type": "object",
                "properties": {
                  "length": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 10000,
                    "default": 10
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 10000,
                    "default": 10
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 10000,
                    "default": 10
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "type": {
                "const": "cylinder"
              },
              "options": {
                "type": "object",
                "properties": {
                  "radius": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 10000,
                    "default": 5
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 10000,
                    "default": 10
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "mounts": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 16,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "position": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "number",
                            "minimum": -100000,
                            "maximum": 100000
                          },
                          {
                            "type": "object",
                            "properties": {
                              "terms": {
                                "type": "object",
                                "minProperties": 1,
                                "maxProperties": 4,
                                "propertyNames": {
                                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                                },
                                "additionalProperties": {
                                  "type": "number",
                                  "minimum": -1000000,
                                  "maximum": 1000000,
                                  "not": {
                                    "const": 0
                                  }
                                }
                              },
                              "offset": {
                                "type": "number",
                                "minimum": -1000000,
                                "maximum": 1000000,
                                "default": 0
                              }
                            },
                            "additionalProperties": false,
                            "required": [
                              "terms"
                            ]
                          }
                        ]
                      },
                      "minItems": 3,
                      "maxItems": 3,
                      "default": [
                        0,
                        0,
                        0
                      ]
                    },
                    "z": {
                      "enum": [
                        "+X",
                        "-X",
                        "+Y",
                        "-Y",
                        "+Z",
                        "-Z"
                      ],
                      "default": "+Z"
                    },
                    "x": {
                      "enum": [
                        "+X",
                        "-X",
                        "+Y",
                        "-Y",
                        "+Z",
                        "-Z"
                      ],
                      "default": "+X"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "mounts"
            ],
            "title": "Modelled part"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 32
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "part": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              0,
              0,
              0
            ]
          },
          "rotation": {
            "type": "number",
            "minimum": -360,
            "maximum": 360,
            "default": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "part"
        ]
      },
      "minItems": 2,
      "maxItems": 32
    },
    "grounded": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "joints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "type": {
            "const": "fixed"
          },
          "parent": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "face": {
                "enum": [
                  "top",
                  "bottom"
                ]
              },
              "mount": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              }
            },
            "additionalProperties": false,
            "required": [
              "component"
            ],
            "oneOf": [
              {
                "required": [
                  "face"
                ],
                "not": {
                  "required": [
                    "mount"
                  ]
                }
              },
              {
                "required": [
                  "mount"
                ],
                "not": {
                  "required": [
                    "face"
                  ]
                }
              }
            ]
          },
          "child": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "face": {
                "enum": [
                  "top",
                  "bottom"
                ]
              },
              "mount": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              }
            },
            "additionalProperties": false,
            "required": [
              "component"
            ],
            "oneOf": [
              {
                "required": [
                  "face"
                ],
                "not": {
                  "required": [
                    "mount"
                  ]
                }
              },
              {
                "required": [
                  "mount"
                ],
                "not": {
                  "required": [
                    "face"
                  ]
                }
              }
            ]
          },
          "offset": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              0,
              0,
              0
            ]
          },
          "clocking": {
            "type": "number",
            "minimum": -360,
            "maximum": 360,
            "default": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "parent",
          "child"
        ]
      },
      "minItems": 1,
      "maxItems": 31
    },
    "dimensions": {
      "$ref": "#/$defs/json"
    },
    "definitions": {
      "$ref": "#/$defs/json"
    },
    "settings": {
      "$ref": "#/$defs/json"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "parts",
    "components",
    "grounded",
    "joints"
  ]
}
