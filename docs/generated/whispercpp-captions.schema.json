{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schemaxis whispercpp-captions literal settings",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.whispercpp.captions/1"
    },
    "operation": {
      "const": "layout"
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "sourceSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "maxLineCodePoints": {
      "type": "integer",
      "minimum": 8,
      "maximum": 80
    },
    "maxLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "source",
    "sourceSha256",
    "maxLineCodePoints",
    "maxLines"
  ]
}
