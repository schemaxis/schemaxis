{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "maxWorkers": {
      "type": "integer",
      "minimum": 1
    },
    "cpus": {
      "type": "integer",
      "minimum": 1
    },
    "memoryMB": {
      "type": "integer",
      "minimum": 1
    },
    "gpus": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
