{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.tesseract/1"
    },
    "operation": {
      "const": "recognizePage"
    },
    "image": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ]
    },
    "origin": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "mupdf-review"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "page"
      ]
    },
    "language": {
      "enum": [
        "eng"
      ],
      "default": "eng"
    },
    "pageSegmentation": {
      "enum": [
        "uniform-block",
        "single-line"
      ],
      "default": "uniform-block"
    },
    "dpi": {
      "type": "integer",
      "minimum": 70,
      "maximum": 2400
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "image",
    "model"
  ]
}
