{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.gnuplot/1"
    },
    "operation": {
      "const": "plot"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "unit"
        ]
      },
      "minItems": 2,
      "maxItems": 12
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "x": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "y": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "colour": {
            "enum": [
              "red",
              "blue",
              "green",
              "purple"
            ],
            "default": "red"
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "x",
          "y"
        ]
      },
      "minItems": 1,
      "maxItems": 4
    },
    "xAxis": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "range": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1e+100,
            "maximum": 1e+100
          },
          "minItems": 2,
          "maxItems": 2
        },
        "scale": {
          "enum": [
            "linear",
            "log10"
          ],
          "default": "linear"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "unit",
        "range"
      ]
    },
    "yAxis": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "range": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1e+100,
            "maximum": 1e+100
          },
          "minItems": 2,
          "maxItems": 2
        },
        "scale": {
          "enum": [
            "linear",
            "log10"
          ],
          "default": "linear"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "unit",
        "range"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 640,
      "maximum": 1600,
      "default": 800
    },
    "height": {
      "type": "integer",
      "minimum": 480,
      "maximum": 1200,
      "default": 600
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "title",
    "source",
    "columns",
    "series",
    "xAxis",
    "yAxis"
  ]
}
