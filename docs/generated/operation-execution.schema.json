{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "threads": {
      "type": "integer",
      "minimum": 1
    },
    "ranks": {
      "type": "integer",
      "minimum": 1
    },
    "memoryMB": {
      "type": "integer",
      "minimum": 1
    },
    "gpus": {
      "type": "integer",
      "minimum": 0
    },
    "timeChunkSize": {
      "type": "integer",
      "minimum": 1
    },
    "mpiexec": {
      "$ref": "#/$defs/json"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ranks": {
            "minimum": 2
          }
        },
        "required": [
          "ranks"
        ]
      },
      "then": {
        "required": [
          "mpiexec"
        ],
        "properties": {
          "mpiexec": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    }
  ]
}
