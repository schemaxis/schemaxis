{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.meshio/1"
    },
    "operation": {
      "const": "convert"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sourceFormat": {
      "enum": [
        "vtu",
        "vtk"
      ]
    },
    "targetFormat": {
      "enum": [
        "vtu",
        "vtk"
      ]
    },
    "sourceUnits": {
      "enum": [
        "m",
        "cm",
        "mm",
        "in"
      ]
    },
    "targetUnits": {
      "enum": [
        "m",
        "cm",
        "mm",
        "in"
      ]
    },
    "lossPolicy": {
      "enum": [
        "strict"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "source",
    "sourceFormat",
    "targetFormat",
    "sourceUnits",
    "targetUnits",
    "lossPolicy"
  ]
}
