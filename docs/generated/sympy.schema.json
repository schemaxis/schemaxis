{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.sympy/1"
    },
    "operation": {
      "const": "isolateRealRoots"
    },
    "coefficients": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 82
      },
      "minItems": 2,
      "maxItems": 13
    },
    "maximumIntervalWidth": {
      "type": "string",
      "minLength": 1,
      "maxLength": 82,
      "default": "1/1000"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "coefficients"
  ]
}
