{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.infozip/1"
    },
    "operation": {
      "const": "bundle"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 53,
            "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])\\.)[a-z][a-z0-9_-]{0,47}\\.(?:txt|json|srt|vtt|wav|flac|m4a|png|html|docx|epub|pdf)$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "source"
        ]
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "files"
  ]
}
