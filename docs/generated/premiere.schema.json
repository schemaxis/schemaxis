{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.premiere/1",
      "description": "Experimental Premiere contract version."
    },
    "operation": {
      "enum": [
        "sequenceContract",
        "sequenceLayout"
      ]
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sequenceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60,
      "default": 25,
      "enum": [
        24,
        25,
        30,
        50,
        60
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8192,
      "default": 1920
    },
    "height": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8192,
      "default": 1080
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Exact absolute native source path identity; no source-content readback."
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000,
            "default": 0,
            "description": "Zero-based source frame at the sequence timebase; default 0."
          },
          "frameCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600,
            "description": "Positive duration in sequence frames; out points are exclusive."
          }
        },
        "additionalProperties": false,
        "required": [
          "sourcePath",
          "frameCount"
        ]
      },
      "minItems": 1,
      "maxItems": 128,
      "description": "Ordered contiguous clips on the sole unmuted video track, at zero-based timeline positions."
    },
    "endFrame": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourcePath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "startFrame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 0
                },
                "frameCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "timelineFrame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 599
                }
              },
              "additionalProperties": false,
              "required": [
                "sourcePath",
                "frameCount",
                "timelineFrame"
              ]
            },
            "minItems": 0,
            "maxItems": 128
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "clips"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1,
            "maxItems": 8
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 599
          },
          "frameCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "minimumActiveTracks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "tracks",
          "startFrame",
          "frameCount"
        ]
      },
      "minItems": 0,
      "maxItems": 32,
      "default": []
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "projectPath",
    "sequenceName"
  ],
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "sequenceContract"
        }
      },
      "required": [
        "clips"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "endFrame"
            ]
          },
          {
            "required": [
              "tracks"
            ]
          },
          {
            "required": [
              "requirements"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "operation": {
          "const": "sequenceLayout"
        }
      },
      "required": [
        "endFrame",
        "tracks"
      ],
      "not": {
        "required": [
          "clips"
        ]
      }
    }
  ]
}
