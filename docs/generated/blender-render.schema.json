{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schemaxis saved-scene-render literal settings",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.blender.render/1"
    },
    "sceneFile": {
      "type": "string",
      "minLength": 1
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "direction": {
            "anyOf": [
              {
                "type": "string",
                "title": "axis token such as 'x+' or 'z-'"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "title": "vector [x, y, z]"
              },
              {
                "type": "object",
                "properties": {
                  "axis": {
                    "type": "string",
                    "description": "Axis token such as 'x+'"
                  },
                  "azimuth": {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360,
                    "description": "Degrees about the up axis from the reference axis"
                  },
                  "elevation": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180,
                    "description": "Degrees tilted from the plane perpendicular to up"
                  },
                  "vector": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "title": "vector [x, y, z]"
                  },
                  "up": {
                    "anyOf": [
                      {
                        "type": "string",
                        "title": "axis token such as 'z+'"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3,
                        "title": "vector [x, y, z]"
                      }
                    ],
                    "title": "up direction"
                  }
                },
                "additionalProperties": false,
                "title": "direction object"
              }
            ],
            "default": [
              1,
              0,
              0
            ],
            "title": "direction",
            "description": "An axis token, a vector, or an azimuth and elevation about an up axis"
          },
          "up": {
            "anyOf": [
              {
                "type": "string",
                "title": "axis token such as 'x+' or 'z-'"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "title": "vector [x, y, z]"
              },
              {
                "type": "object",
                "properties": {
                  "axis": {
                    "type": "string",
                    "description": "Axis token such as 'x+'"
                  },
                  "azimuth": {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360,
                    "description": "Degrees about the up axis from the reference axis"
                  },
                  "elevation": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180,
                    "description": "Degrees tilted from the plane perpendicular to up"
                  },
                  "vector": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "title": "vector [x, y, z]"
                  },
                  "up": {
                    "anyOf": [
                      {
                        "type": "string",
                        "title": "axis token such as 'z+'"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3,
                        "title": "vector [x, y, z]"
                      }
                    ],
                    "title": "up direction"
                  }
                },
                "additionalProperties": false,
                "title": "direction object"
              }
            ],
            "default": [
              0,
              0,
              1
            ],
            "title": "direction",
            "description": "An axis token, a vector, or an azimuth and elevation about an up axis"
          },
          "focalPoint": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "parallel": {
            "type": "boolean",
            "default": true
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "distance": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          },
          "padding": {
            "type": "number",
            "minimum": 0,
            "default": 0.1
          }
        },
        "additionalProperties": false
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "device": {
          "enum": [
            "CPU",
            "CUDA",
            "OPTIX"
          ],
          "default": "CPU"
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 8
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 4
        },
        "denoise": {
          "type": "boolean",
          "default": false
        },
        "transparent": {
          "type": "boolean",
          "default": false
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0
        },
        "worldColour": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0.8,
            0.8,
            0.8
          ]
        },
        "worldStrength": {
          "type": "number",
          "minimum": 0,
          "default": 0.8
        },
        "lightEnergy": {
          "type": "number",
          "minimum": 0,
          "default": 1000
        },
        "lightPosition": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            4,
            -4,
            6
          ]
        },
        "lightSize": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 32,
        "maximum": 2048
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "sceneFile",
    "cameras"
  ]
}
