{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.mupdf/1"
    },
    "operation": {
      "const": "review"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 128
      },
      "minItems": 1,
      "maxItems": 16
    },
    "dpi": {
      "type": "integer",
      "minimum": 36,
      "maximum": 300,
      "default": 72
    },
    "rotation": {
      "enum": [
        0,
        90,
        180,
        270
      ],
      "default": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "source",
    "pages"
  ]
}
