{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.gdal/1"
    },
    "operation": {
      "const": "window"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "x": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "y": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "outputWidth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "outputHeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "epsg": {
      "enum": [
        4326,
        3857
      ]
    },
    "units": {
      "enum": [
        "m",
        "K",
        "1"
      ]
    },
    "nodata": {
      "type": "number"
    },
    "resampling": {
      "enum": [
        "nearest"
      ]
    },
    "lossPolicy": {
      "enum": [
        "strict"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "source",
    "x",
    "y",
    "width",
    "height",
    "outputWidth",
    "outputHeight",
    "epsg",
    "units",
    "nodata",
    "resampling",
    "lossPolicy"
  ]
}
