{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "schemaxis.sox/1"
    },
    "operation": {
      "const": "assemble"
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144,
            "default": 0
          },
          "frameCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144
          },
          "gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 4,
            "default": 1
          },
          "fadeInFrames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144,
            "default": 0
          },
          "fadeOutFrames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144,
            "default": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "source",
          "frameCount"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "clips"
  ]
}
