{
  "version": "schemaxis.workflow/1",
  "dimensions": {
    "length": 20,
    "width": 10,
    "height": 5
  },
  "operations": [
    {
      "id": "design",
      "document": {
        "version": "schemaxis.freecad/1",
        "units": "mm",
        "nodes": [
          {
            "id": "body",
            "filter": "box",
            "options": {
              "length": {
                "$document": "/dimensions/length",
                "scope": "workflow"
              },
              "width": {
                "$document": "/dimensions/width",
                "scope": "workflow"
              },
              "height": {
                "$document": "/dimensions/height",
                "scope": "workflow"
              }
            }
          }
        ],
        "output": "body",
        "measurements": [
          {
            "id": "height",
            "node": "body",
            "quantity": "extentZ"
          }
        ]
      }
    },
    {
      "id": "mesh",
      "document": {
        "version": "schemaxis.gmsh/1",
        "units": "mm",
        "nodes": [
          {
            "id": "solid",
            "filter": "readSTEP",
            "options": {
              "file": {
                "$artifact": "design",
                "index": 0
              }
            }
          },
          {
            "id": "mesh",
            "filter": "tetrahedral",
            "inputs": {
              "input": "solid"
            },
            "options": {
              "size": {
                "$expr": {
                  "op": "multiply",
                  "args": [
                    {
                      "$value": "design",
                      "artifact": 3,
                      "path": "/measurements/height/value"
                    },
                    0.4
                  ]
                }
              },
              "volumeTolerance": 0.01
            }
          }
        ],
        "output": "mesh"
      }
    },
    {
      "id": "table",
      "document": {
        "version": "schemaxis.octave/1",
        "nodes": [
          {
            "id": "height",
            "filter": "samples",
            "options": {
              "x": [
                0,
                1
              ],
              "y": [
                {
                  "$expr": {
                    "op": "divide",
                    "args": [
                      {
                        "$value": "mesh",
                        "artifact": 3,
                        "path": "/volume"
                      },
                      {
                        "$expr": {
                          "op": "multiply",
                          "args": [
                            {
                              "$document": "/dimensions/length",
                              "scope": "workflow"
                            },
                            {
                              "$document": "/dimensions/width",
                              "scope": "workflow"
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "$expr": {
                    "op": "divide",
                    "args": [
                      {
                        "$value": "mesh",
                        "artifact": 3,
                        "path": "/volume"
                      },
                      {
                        "$expr": {
                          "op": "multiply",
                          "args": [
                            {
                              "$document": "/dimensions/length",
                              "scope": "workflow"
                            },
                            {
                              "$document": "/dimensions/width",
                              "scope": "workflow"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ],
        "outputs": [
          "height"
        ]
      }
    },
    {
      "id": "revise",
      "document": {
        "version": "schemaxis.freecad/1",
        "units": "mm",
        "nodes": [
          {
            "id": "body",
            "filter": "box",
            "options": {
              "length": {
                "$document": "/dimensions/length",
                "scope": "workflow"
              },
              "width": {
                "$document": "/dimensions/width",
                "scope": "workflow"
              },
              "height": {
                "$value": "table",
                "artifact": 0,
                "path": "/rows/0/1"
              }
            }
          }
        ],
        "output": "body"
      }
    }
  ]
}
