{
  "version": "artifact.filename-rules/1",
  "rules": [
    {
      "name": "Slices",
      "enabled": true,
      "pattern": "[sS]lices[._-]([XYZ])[._-]([0-9]+)",
      "columns": [
        {
          "index": 1,
          "key": "axis",
          "type": "text"
        },
        {
          "index": 2,
          "key": "number",
          "type": "number"
        }
      ]
    },
    {
      "name": "Dot-separated tags",
      "enabled": true,
      "pattern": "-tags-([^-]+)-enclosedByDashes-",
      "columns": [
        {
          "index": 1,
          "key": "tags",
          "type": "tags",
          "separator": "."
        }
      ]
    },
    {
      "name": "File code and index",
      "enabled": true,
      "pattern": "file-([A-Z]+)-([0-9]+)-",
      "columns": [
        {
          "index": 1,
          "key": "code",
          "type": "text"
        },
        {
          "index": 2,
          "key": "index",
          "type": "number"
        }
      ]
    }
  ]
}
