{
  "version": "schemaxis.gnuplot/1",
  "operation": "plot",
  "title": "Logarithmic response",
  "source": "/replace/with/logarithmic.csv",
  "columns": [
    {
      "name": "time",
      "unit": "s"
    },
    {
      "name": "reading",
      "unit": "V"
    },
    {
      "name": "uncertainty",
      "unit": "V"
    }
  ],
  "series": [
    {
      "label": "Measured",
      "x": "time",
      "y": "reading",
      "error": "uncertainty",
      "colour": "red"
    }
  ],
  "xAxis": {
    "label": "Time",
    "unit": "s",
    "range": [
      1,
      100
    ],
    "scale": "log10"
  },
  "yAxis": {
    "label": "Reading",
    "unit": "V",
    "range": [
      1,
      1000
    ],
    "scale": "log10"
  },
  "width": 800,
  "height": 600
}
