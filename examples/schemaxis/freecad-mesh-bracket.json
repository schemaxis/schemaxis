{
  "version": "schemaxis.freecad/1",
  "nodes": [
    {
      "id": "casting",
      "filter": "importMesh",
      "options": {
        "file": "examples/schemaxis/freecad-mesh-bracket.stl",
        "units": "mm",
        "refine": true
      }
    },
    {
      "id": "drill",
      "filter": "cylinder",
      "options": {
        "radius": 2.5,
        "height": 30,
        "origin": [
          21.0,
          10.0,
          -5
        ]
      }
    },
    {
      "id": "bracket",
      "filter": "cut",
      "inputs": {
        "base": "casting",
        "tool": "drill"
      }
    }
  ],
  "output": "bracket"
}
