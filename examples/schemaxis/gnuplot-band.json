{
  "version": "schemaxis.gnuplot/1",
  "operation": "plot",
  "title": "Reported range envelope",
  "source": "/replace/with/band.csv",
  "columns": [
    {
      "name": "time",
      "unit": "s"
    },
    {
      "name": "mean",
      "unit": "V"
    },
    {
      "name": "lower",
      "unit": "V"
    },
    {
      "name": "upper",
      "unit": "V"
    }
  ],
  "series": [
    {
      "label": "Mean",
      "x": "time",
      "y": "mean",
      "bounds": {
        "lower": "lower",
        "upper": "upper"
      },
      "colour": "red"
    }
  ],
  "xAxis": {
    "label": "Time",
    "unit": "s",
    "range": [
      0,
      2
    ],
    "scale": "linear"
  },
  "yAxis": {
    "label": "Reading",
    "unit": "V",
    "range": [
      0,
      3
    ],
    "scale": "linear"
  },
  "width": 800,
  "height": 600
}
