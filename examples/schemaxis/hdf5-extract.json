{
  "version": "schemaxis.hdf5/1",
  "operation": "extractData",
  "source": "/replace/with/hdf5-fixtures/vendor-export.h5",
  "extracts": [
    {"id": "frame_pixels", "dataset": "/acquisition/frames", "selection": {"kind": "hyperslab", "start": [1, 0, 1], "count": [2, 2, 2], "stride": [2, 1, 1], "block": [1, 1, 1]}, "format": "json"},
    {"id": "first_column", "dataset": "/acquisition/frames", "selection": {"kind": "slices", "slices": [{"start": 0, "stop": 4}, {"start": 0, "stop": 1}, {"start": 0, "stop": 1}]}},
    {"id": "log_events", "dataset": "/acquisition/log", "fields": ["frame", "event"]},
    {"id": "time", "dataset": "/acquisition/time", "format": "npy"}
  ]
}
