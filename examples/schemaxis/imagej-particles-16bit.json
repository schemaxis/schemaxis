{
  "version": "schemaxis.imagej/1",
  "operation": "analyzeParticles",
  "image": "/replace-with-your-input/particles-16bit.tif",
  "calibration": {
    "pixelWidth": 0.5,
    "pixelHeight": 0.5,
    "unit": "um"
  },
  "threshold": {
    "lower": 10000,
    "upper": 65535
  },
  "connectivity": "eight",
  "includeHoles": false,
  "excludeEdges": false,
  "minimumArea": 0
}
