{
  "version": "schemaxis.blender/1",
  "nodes": [
    {"id": "paint", "filter": "material", "options": {
      "colour": {"$analytic": {"type": "values", "sync": "shape",
        "values": [[0.05, 0.3, 0.8, 1], [0.8, 0.2, 0.05, 1]]}}}},
    {"id": "box", "filter": "cube", "inputs": {"material": {"$object": "paint"}}, "options": {
      "size": {"$analytic": {"type": "linear", "sync": "shape", "start": 2, "end": 3, "count": 2}}}},
    {"id": "rounded", "filter": "bevel", "inputs": {"input": "box"}, "options": {"width": 0.15, "segments": 3}},
    {"id": "unusedPaint", "filter": "material"}
  ],
  "scenes": [{"id": "demo", "visible": ["rounded"], "images": [{
    "id": "orbit", "size": [240, 180],
    "cameras": {"$analytic": {"type": "orbit", "start": 30, "end": 150, "count": 3, "elevation": 25}}
  }]}]
}
