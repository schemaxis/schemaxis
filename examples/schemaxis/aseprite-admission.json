{
  "version": "schemaxis.aseprite/1",
  "nodes": [
    {
      "id": "canvas",
      "filter": "sprite",
      "options": {
        "width": 4,
        "height": 4
      }
    },
    {
      "id": "paint",
      "filter": "rect",
      "inputs": {
        "sprite": "canvas"
      },
      "options": {
        "layer": "base",
        "x": 0,
        "y": 0,
        "width": 4,
        "height": 4,
        "colour": [
          255,
          0,
          0,
          255
        ]
      }
    }
  ],
  "output": "paint"
}
