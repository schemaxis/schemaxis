{
  "version": "schemaxis.qgis/1",
  "nodes": [
    {
      "id": "sites",
      "filter": "readVector",
      "options": {
        "file": "/replace-with-your-input/sites.geojson"
      }
    },
    {
      "id": "metric",
      "filter": "reproject",
      "inputs": {
        "input": "sites"
      },
      "options": {
        "crs": "EPSG:3857"
      }
    }
  ],
  "output": "metric",
  "preview": false
}
