{
  "version": "schemaxis/1",
  "maxPublications": 200,
  "nodes": [
    {
      "id": "source",
      "filter": "wavelet"
    },
    {
      "id": "velocity",
      "filter": "calculator",
      "inputs": {
        "input": "source"
      },
      "options": {
        "expression": "iHat",
        "result": "velocity"
      }
    },
    {
      "id": "scalar",
      "filter": "calculator",
      "inputs": {
        "input": "velocity"
      },
      "options": {
        "expression": "coordsX",
        "result": "positionX"
      }
    },
    {
      "id": "cut",
      "filter": "slice",
      "inputs": {
        "input": "scalar"
      },
      "options": {
        "origin": {
          "$axis": "height"
        },
        "normal": [
          0,
          0,
          1
        ]
      }
    },
    {
      "id": "iso",
      "filter": "contour",
      "inputs": {
        "input": "scalar"
      },
      "options": {
        "field": [
          "POINTS",
          "positionX"
        ],
        "values": {
          "$axis": "level"
        }
      }
    },
    {
      "id": "outline",
      "filter": "outline",
      "inputs": {
        "input": "source"
      }
    },
    {
      "id": "unused",
      "filter": "sphere",
      "options": {
        "radius": 100
      }
    },
    {
      "id": "focus",
      "filter": "sphere",
      "options": {
        "radius": 4,
        "centre": [
          1,
          0,
          0
        ]
      }
    }
  ],
  "axes": [
    {
      "name": "height",
      "values": [
        [
          0,
          0,
          -2
        ],
        [
          0,
          0,
          2
        ]
      ]
    },
    {
      "name": "level",
      "values": [
        [
          -3
        ],
        [
          3
        ]
      ]
    }
  ],
  "scenes": [
    {
      "id": "framing",
      "geometry": [
        "cut"
      ],
      "visible": {
        "cut": {
          "field": [
            "POINTS",
            "RTData"
          ],
          "range": {
            "$observe": "scalar",
            "path": [
              "fields",
              "POINTS",
              "RTData",
              "range"
            ]
          },
          "legend": true,
          "legendTitle": "RTData",
          "preset": "Cool to Warm",
          "logScale": true
        }
      },
      "images": [
        {
          "id": "detail",
          "size": [
            640,
            480
          ],
          "cameras": [
            {
              "direction": [
                1,
                -1,
                1
              ],
              "bounds": {
                "$observe": "focus",
                "path": [
                  "bounds"
                ]
              }
            },
            {
              "direction": [
                1,
                -1,
                1
              ],
              "focalPoint": {
                "$calc": "midpoint",
                "args": [
                  {
                    "$observe": "cut",
                    "path": [
                      "bounds"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
