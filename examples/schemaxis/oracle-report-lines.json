{
  "version": "schemaxis.oracle/1",
  "operation": "report",
  "connection": {"profile": "free_local"},
  "tables": [
    {
      "name": "customers",
      "columns": [
        {"name": "id", "type": "number", "precision": 10, "scale": 0},
        {"name": "name", "type": "varchar2", "length": 40},
        {"name": "region", "type": "varchar2", "length": 12, "nullable": true},
        {"name": "credit", "type": "number", "precision": 12, "scale": 2}
      ],
      "primaryKey": ["id"],
      "source": {"path": "/replace/with/customers.json"}
    },
    {
      "name": "orders",
      "columns": [
        {"name": "id", "type": "number", "precision": 10, "scale": 0},
        {"name": "customer_id", "type": "number", "precision": 10, "scale": 0, "nullable": true},
        {"name": "placed", "type": "date"},
        {"name": "total", "type": "number", "precision": 12, "scale": 2, "nullable": true}
      ],
      "primaryKey": ["id"],
      "foreignKeys": [{"columns": ["customer_id"], "table": "customers", "references": ["id"], "onDelete": "setNull"}],
      "source": {"path": "/replace/with/orders.json"}
    },
    {
      "name": "order_lines",
      "columns": [
        {"name": "id", "type": "number", "precision": 10, "scale": 0},
        {"name": "order_id", "type": "number", "precision": 10, "scale": 0},
        {"name": "sku", "type": "varchar2", "length": 12},
        {"name": "quantity", "type": "number", "precision": 6, "scale": 0},
        {"name": "unit_price", "type": "number", "precision": 10, "scale": 2},
        {"name": "packed_at", "type": "timestampTz", "fraction": 3, "nullable": true}
      ],
      "primaryKey": ["id"],
      "foreignKeys": [{"columns": ["order_id"], "table": "orders", "references": ["id"], "onDelete": "cascade"}],
      "source": {"path": "/replace/with/order_lines.csv", "format": "csv"}
    }
  ],
  "report": {
    "selects": [
      {
        "from": {"table": "orders", "alias": "o"},
        "joins": [{"type": "inner", "table": "order_lines", "alias": "l", "on": [{"left": "o.id", "right": "l.order_id"}]}],
        "computed": [{"name": "line_total", "function": "multiply", "arguments": [{"column": "l.quantity"}, {"column": "l.unit_price"}]}],
        "groupBy": [{"column": "o.id"}],
        "measures": [
          {"name": "lines", "function": "countAll"},
          {"name": "units", "function": "sum", "argument": {"column": "l.quantity"}},
          {"name": "amount", "function": "sum", "argument": {"derived": "line_total"}}
        ],
        "conditions": [{"name": "big", "terms": [{"left": {"measure": "amount"}, "operator": "greaterThan", "right": {"literal": {"type": "number", "value": "90"}}}]}],
        "having": "big",
        "columns": [
          {"name": "order_id", "operand": {"column": "o.id"}},
          {"name": "lines", "operand": {"measure": "lines"}},
          {"name": "units", "operand": {"measure": "units"}},
          {"name": "amount", "operand": {"measure": "amount"}}
        ]
      }
    ],
    "windows": [{"name": "position", "function": "rank", "orderBy": [{"column": "amount", "direction": "descending"}]}],
    "orderBy": [{"column": "position"}]
  }
}
