{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "signal",
      "document": {
        "version": "schemaxis.octave/1",
        "nodes": [
          {
            "id": "wave",
            "filter": "wave",
            "options": {
              "count": 128,
              "step": 0.0078125,
              "frequency": 2,
              "amplitude": 0.6
            }
          },
          {
            "id": "spectrum",
            "filter": "fft",
            "inputs": {
              "input": "wave"
            }
          }
        ],
        "outputs": [
          "wave",
          "spectrum"
        ]
      }
    },
    {
      "id": "curve",
      "document": {
        "version": "schemaxis.blender/1",
        "nodes": [
          {
            "id": "paint",
            "filter": "material",
            "options": {
              "colour": [
                0.06,
                0.35,
                0.75,
                1
              ],
              "metallic": 0.3,
              "roughness": 0.25,
              "coat": 0.4
            }
          },
          {
            "id": "curve",
            "filter": "curveFromCSV",
            "inputs": {
              "material": "paint"
            },
            "options": {
              "file": {
                "$artifact": "signal",
                "index": 0
              },
              "radius": 0.025,
              "resolution": 4
            }
          }
        ],
        "scenes": [
          {
            "id": "signal",
            "visible": [
              "curve"
            ],
            "meshes": [
              "curve"
            ],
            "images": [
              {
                "id": "view",
                "size": [
                  640,
                  480
                ],
                "cameras": [
                  {
                    "direction": [
                      0,
                      -0.5,
                      1
                    ]
                  }
                ]
              }
            ],
            "render": {
              "samples": 64,
              "denoise": true,
              "threads": 4
            }
          }
        ]
      }
    }
  ]
}
