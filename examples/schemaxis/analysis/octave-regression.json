{
  "version": "schemaxis.octave/1",
  "nodes": [
    {"id": "measurements", "filter": "samples", "options": {"x": [0, 1, 2, 3, 4], "y": [1, 3, 5, 7, 9]}},
    {"id": "fit", "filter": "linearFit", "inputs": {"input": "measurements"}},
    {"id": "derivative", "filter": "derivative", "inputs": {"input": "fit"}},
    {"id": "integral", "filter": "integral", "inputs": {"input": "fit"}, "options": {"initial": 3}}
  ],
  "outputs": ["fit", "derivative", "integral"]
}
