{
  "version": "schemaxis.octave/1",
  "nodes": [
    {"id": "signal", "filter": "wave", "options": {"step": 0.0078125, "count": 128, "frequency": 8, "amplitude": 2}},
    {"id": "smoothed", "filter": "movingMean", "inputs": {"input": "signal"}, "options": {"window": 5}},
    {"id": "spectrum", "filter": "fft", "inputs": {"input": "signal"}},
    {"id": "area", "filter": "integral", "inputs": {"input": "signal"}},
    {"id": "gradient", "filter": "derivative", "inputs": {"input": "signal"}}
  ],
  "outputs": ["signal", "smoothed", "spectrum", "area", "gradient"]
}
