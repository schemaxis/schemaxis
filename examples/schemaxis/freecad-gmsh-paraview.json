{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "cad",
      "document": {
        "version": "schemaxis.freecad/1",
        "units": "mm",
        "nodes": [
          {
            "id": "body",
            "filter": "box",
            "options": {
              "length": 20,
              "width": 10,
              "height": 5
            }
          }
        ],
        "output": "body"
      }
    },
    {
      "id": "mesh",
      "document": {
        "version": "schemaxis.gmsh/1",
        "units": "mm",
        "nodes": [
          {
            "id": "solid",
            "filter": "readSTEP",
            "options": {
              "file": {
                "$artifact": "cad",
                "index": 0
              }
            }
          },
          {
            "id": "mesh",
            "filter": "tetrahedral",
            "inputs": {
              "input": "solid"
            },
            "options": {
              "size": 2.5,
              "volumeName": "part",
              "boundaryName": "outside",
              "volumeTolerance": 1e-06
            }
          }
        ],
        "output": "mesh"
      }
    },
    {
      "id": "inspect",
      "document": {
        "version": "schemaxis/1",
        "nodes": [
          {
            "id": "volume",
            "filter": "readUnstructuredGrid",
            "options": {
              "files": [
                {
                  "$artifact": "mesh",
                  "index": 1
                }
              ]
            }
          },
          {
            "id": "measures",
            "filter": "cellSize",
            "inputs": {
              "input": "volume"
            }
          },
          {
            "id": "surface",
            "filter": "readUnstructuredGrid",
            "options": {
              "files": [
                {
                  "$artifact": "mesh",
                  "index": 2
                }
              ]
            }
          },
          {
            "id": "integral",
            "filter": "integrate",
            "inputs": {
              "input": "volume"
            }
          }
        ],
        "scenes": [
          {
            "id": "mesh",
            "geometry": [
              "measures",
              "surface",
              "integral"
            ]
          }
        ]
      }
    }
  ]
}
