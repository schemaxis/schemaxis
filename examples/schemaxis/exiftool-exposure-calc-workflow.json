{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "exposure",
      "document": {
        "version": "schemaxis.exiftool/1",
        "operation": "inspectMetadata",
        "media": {
          "items": [
            {
              "id": "ridge_line",
              "path": "/tmp/schemaxis-exiftool-acceptance/ridge-line.jpg"
            },
            {
              "id": "harbour_light",
              "path": "/tmp/schemaxis-exiftool-acceptance/harbour-light.jpg"
            },
            {
              "id": "orchard_gate",
              "path": "/tmp/schemaxis-exiftool-acceptance/orchard-gate.jpg"
            }
          ]
        },
        "profiles": [
          "exposure"
        ]
      }
    },
    {
      "id": "workbook",
      "document": {
        "version": "schemaxis.calc/1",
        "nodes": [
          {
            "id": "exposures",
            "filter": "readTypedCSV",
            "options": {
              "file": {
                "$artifact": "exposure",
                "index": 2
              },
              "nullToken": "\\N",
              "columns": [
                {
                  "name": "id",
                  "kind": "text"
                },
                {
                  "name": "exposureTime",
                  "kind": "number",
                  "nullable": true
                },
                {
                  "name": "exposureTimeState",
                  "kind": "text"
                },
                {
                  "name": "fNumber",
                  "kind": "number",
                  "nullable": true
                },
                {
                  "name": "fNumberState",
                  "kind": "text"
                },
                {
                  "name": "isoSpeed",
                  "kind": "number",
                  "nullable": true
                },
                {
                  "name": "isoSpeedState",
                  "kind": "text"
                },
                {
                  "name": "focalLength",
                  "kind": "number",
                  "nullable": true
                },
                {
                  "name": "focalLengthState",
                  "kind": "text"
                },
                {
                  "name": "focalLength35mm",
                  "kind": "number",
                  "nullable": true
                },
                {
                  "name": "focalLength35mmState",
                  "kind": "text"
                },
                {
                  "name": "exposureBias",
                  "kind": "number",
                  "nullable": true
                },
                {
                  "name": "exposureBiasState",
                  "kind": "text"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
