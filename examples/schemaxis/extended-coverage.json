{
  "version": "schemaxis/1",
  "nodes": [
    {
      "id": "source",
      "filter": "wavelet"
    },
    {
      "id": "velocity",
      "filter": "calculator",
      "inputs": {
        "input": "source"
      },
      "options": {
        "expression": "iHat",
        "result": "velocity"
      }
    },
    {
      "id": "scalar",
      "filter": "calculator",
      "inputs": {
        "input": "velocity"
      },
      "options": {
        "expression": "coordsX",
        "result": "positionX"
      }
    },
    {
      "id": "sphere",
      "filter": "sphere"
    },
    {
      "id": "line",
      "filter": "line",
      "options": {
        "start": [
          -5,
          -2,
          0
        ],
        "end": [
          -5,
          2,
          0
        ]
      }
    },
    {
      "id": "cell",
      "filter": "pointToCell",
      "inputs": {
        "input": "scalar"
      }
    },
    {
      "id": "point",
      "filter": "cellToPoint",
      "inputs": {
        "input": "cell"
      }
    },
    {
      "id": "cut",
      "filter": "slice",
      "inputs": {
        "input": "point"
      },
      "options": {
        "normal": [
          0,
          0,
          1
        ]
      }
    },
    {
      "id": "iso",
      "filter": "contour",
      "inputs": {
        "input": "scalar"
      },
      "options": {
        "field": [
          "POINTS",
          "positionX"
        ],
        "values": [
          0
        ]
      }
    },
    {
      "id": "stream",
      "filter": "streamTracer",
      "inputs": {
        "input": "velocity",
        "seed": "line"
      },
      "options": {
        "vectors": [
          "POINTS",
          "velocity"
        ],
        "maximumLength": 10
      }
    },
    {
      "id": "tube",
      "filter": "tube",
      "inputs": {
        "input": "stream"
      }
    },
    {
      "id": "surface",
      "filter": "surface",
      "inputs": {
        "input": "point"
      }
    },
    {
      "id": "normals",
      "filter": "normals",
      "inputs": {
        "input": "surface"
      }
    },
    {
      "id": "reflect",
      "filter": "reflect",
      "inputs": {
        "input": "sphere"
      }
    },
    {
      "id": "clip",
      "filter": "clip",
      "inputs": {
        "input": "scalar"
      }
    },
    {
      "id": "threshold",
      "filter": "threshold",
      "inputs": {
        "input": "scalar"
      },
      "options": {
        "field": [
          "POINTS",
          "positionX"
        ],
        "lower": -2,
        "upper": 2
      }
    },
    {
      "id": "group",
      "filter": "group",
      "inputs": {
        "input": [
          "sphere",
          "cut"
        ]
      }
    },
    {
      "id": "extract",
      "filter": "extractBlock",
      "inputs": {
        "input": "group"
      },
      "options": {
        "selectors": [
          "/Root/sphere"
        ]
      }
    },
    {
      "id": "merge",
      "filter": "merge",
      "inputs": {
        "input": "group"
      }
    },
    {
      "id": "integrate",
      "filter": "integrate",
      "inputs": {
        "input": "cut"
      }
    },
    {
      "id": "probe",
      "filter": "probeLine",
      "inputs": {
        "input": "scalar"
      },
      "options": {
        "start": [
          -4,
          0,
          0
        ],
        "end": [
          4,
          0,
          0
        ],
        "resolution": 8
      }
    },
    {
      "id": "outline",
      "filter": "outline",
      "inputs": {
        "input": "scalar"
      }
    },
    {
      "id": "extra_warpVector",
      "filter": "warpVector",
      "inputs": {
        "input": "scalar"
      },
      "options": {
        "vectors": [
          "POINTS",
          "velocity"
        ],
        "scale": 0.25
      }
    },
    {
      "id": "extra_warpScalar",
      "filter": "warpScalar",
      "inputs": {
        "input": "cut"
      },
      "options": {
        "field": [
          "POINTS",
          "positionX"
        ],
        "scale": 0.1
      }
    },
    {
      "id": "extra_shrink",
      "filter": "shrink",
      "inputs": {
        "input": "sphere"
      },
      "options": {}
    },
    {
      "id": "extra_clean",
      "filter": "clean",
      "inputs": {
        "input": "sphere"
      },
      "options": {}
    },
    {
      "id": "extra_cleanGrid",
      "filter": "cleanGrid",
      "inputs": {
        "input": "scalar"
      },
      "options": {}
    },
    {
      "id": "extra_delaunay3D",
      "filter": "delaunay3D",
      "inputs": {
        "input": "sphere"
      },
      "options": {}
    },
    {
      "id": "extra_delaunay2D",
      "filter": "delaunay2D",
      "inputs": {
        "input": "cut"
      },
      "options": {}
    },
    {
      "id": "extra_elevation",
      "filter": "elevation",
      "inputs": {
        "input": "sphere"
      },
      "options": {}
    },
    {
      "id": "extra_gradient",
      "filter": "gradient",
      "inputs": {
        "input": "scalar"
      },
      "options": {
        "field": [
          "POINTS",
          "positionX"
        ]
      }
    },
    {
      "id": "extra_cellSize",
      "filter": "cellSize",
      "inputs": {
        "input": "sphere"
      },
      "options": {}
    },
    {
      "id": "extra_connectivity",
      "filter": "connectivity",
      "inputs": {
        "input": "sphere"
      },
      "options": {}
    },
    {
      "id": "extra_decimate",
      "filter": "decimate",
      "inputs": {
        "input": "sphere"
      },
      "options": {}
    },
    {
      "id": "extra_smooth",
      "filter": "smooth",
      "inputs": {
        "input": "sphere"
      },
      "options": {}
    },
    {
      "id": "extra_triangulate",
      "filter": "triangulate",
      "inputs": {
        "input": "cut"
      },
      "options": {}
    },
    {
      "id": "extra_transform",
      "filter": "transform",
      "inputs": {
        "input": "sphere"
      },
      "options": {
        "translate": [
          1,
          2,
          3
        ]
      }
    },
    {
      "id": "extra_edges",
      "filter": "edges",
      "inputs": {
        "input": "cut"
      },
      "options": {}
    },
    {
      "id": "extra_featureEdges",
      "filter": "featureEdges",
      "inputs": {
        "input": "cut"
      },
      "options": {}
    },
    {
      "id": "extra_temporalStatistics",
      "filter": "temporalStatistics",
      "inputs": {
        "input": "source"
      },
      "options": {}
    },
    {
      "id": "extra_append",
      "filter": "append",
      "inputs": {
        "input": [
          "sphere",
          "cut"
        ]
      }
    },
    {
      "id": "extra_appendGeometry",
      "filter": "appendGeometry",
      "inputs": {
        "input": [
          "sphere",
          "cut"
        ]
      }
    },
    {
      "id": "extra_resample",
      "filter": "resample",
      "inputs": {
        "input": "scalar",
        "mesh": "sphere"
      }
    }
  ],
  "scenes": [
    {
      "id": "coverage",
      "geometry": [
        "source",
        "velocity",
        "scalar",
        "sphere",
        "line",
        "cell",
        "point",
        "cut",
        "iso",
        "stream",
        "tube",
        "surface",
        "normals",
        "reflect",
        "clip",
        "threshold",
        "group",
        "extract",
        "merge",
        "integrate",
        "probe",
        "outline",
        "extra_warpVector",
        "extra_warpScalar",
        "extra_shrink",
        "extra_clean",
        "extra_cleanGrid",
        "extra_delaunay3D",
        "extra_delaunay2D",
        "extra_elevation",
        "extra_gradient",
        "extra_cellSize",
        "extra_connectivity",
        "extra_decimate",
        "extra_smooth",
        "extra_triangulate",
        "extra_transform",
        "extra_edges",
        "extra_featureEdges",
        "extra_temporalStatistics",
        "extra_append",
        "extra_appendGeometry",
        "extra_resample"
      ],
      "measurements": [
        {
          "node": "integrate"
        },
        {
          "node": "probe"
        }
      ]
    }
  ]
}
