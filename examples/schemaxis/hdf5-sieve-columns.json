{
  "version": "schemaxis.hdf5/1",
  "operation": "createFile",
  "file": {"name": "profiles.h5"},
  "access": {"sieveBufferBytes": 1048576},
  "objects": [
    {"path": "/grid", "type": {"class": "float", "bits": 64}, "shape": [2000, 64], "data": {"source": "range", "start": 0, "step": 1},
     "storage": {"layout": "contiguous"}, "units": "K"}
  ],
  "extracts": [
    {"id": "column", "dataset": "/grid", "format": "json",
     "selection": {"kind": "hyperslab", "start": [0, 5], "count": [4, 1], "stride": [500, 1]}},
    {"id": "band", "dataset": "/grid", "format": "npy",
     "selection": {"kind": "slices", "slices": [{"start": 1000, "stop": 1500}, {"start": 8, "stop": 12}]}}
  ]
}
