    {"path": "/detector/counts", "type": {"class": "uint", "bits": 16}, "shape": [4, 8], "data": {"source": "range", "start": 0, "step": 3}, "trackOrder": true,
     "attributes": [{"name": "zeta", "value": 1}, {"name": "lookup table", "type": {"class": "float", "bits": 64}, "shape": [9000], "data": {"source": "linspace", "start": 0, "stop": 8999}},
