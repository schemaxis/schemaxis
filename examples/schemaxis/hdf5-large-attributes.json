           "attributes": [{"name": "title", "value": "Detector calibration"}, {"name": "pixel gains", "type": {"class": "float", "bits": 32}, "shape": [128, 160], "data": {"source": "linspace", "start": 0.5, "stop": 1.5}}]},
  "objects": [
