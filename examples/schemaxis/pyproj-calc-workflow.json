{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "route",
      "document": {
        "version": "schemaxis.pyproj/1",
        "operation": "routeStations",
        "source": "/replace/with/pyproj-winnipeg-route.csv",
        "ellipsoid": "WGS84",
        "coordinateOrder": "lonLat",
        "spacing_m": 1000,
        "requirements": {
          "totalLength_m": {
            "maximum": 50000
          }
        }
      }
    },
    {
      "id": "workbook",
      "document": {
        "version": "schemaxis.calc/1",
        "nodes": [
          {
            "id": "stations",
            "filter": "readCSV",
            "options": {
              "file": {
                "$artifact": "route",
                "index": 0
              }
            }
          }
        ]
      }
    }
  ]
}
