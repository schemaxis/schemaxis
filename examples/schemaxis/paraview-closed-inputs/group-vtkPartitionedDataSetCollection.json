{
  "version": "schemaxis/1",
  "nodes": [
    {
      "id": "sphere",
      "filter": "pvSphere",
      "options": {
        "ThetaResolution": 8,
        "PhiResolution": 8
      }
    },
    {
      "id": "data",
      "filter": "pvGroupDatasets",
      "inputs": {
        "Input": [
          "sphere"
        ]
      },
      "options": {
        "OutputType": "vtkPartitionedDataSetCollection"
      }
    }
  ],
  "scenes": [
    {
      "id": "proof",
      "exports": [
        {
          "id": "result",
          "node": "data",
          "writer": "pvWriteXMLPartitionedDataSetCollectionWriter",
          "options": {},
          "comparison": "exact",
          "acceptLosses": [],
          "tolerance": 0,
          "readback": null
        }
      ]
    }
  ]
}
