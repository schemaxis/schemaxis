{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "icon",
      "document": {
        "version": "schemaxis.aseprite/1",
        "nodes": [
          {
            "id": "canvas",
            "filter": "sprite",
            "options": {
              "width": 8,
              "height": 8
            }
          },
          {
            "id": "square",
            "filter": "rect",
            "inputs": {
              "sprite": "canvas"
            },
            "options": {
              "layer": "base",
              "x": 1,
              "y": 1,
              "width": 6,
              "height": 6,
              "colour": [
                30,
                130,
                230,
                255
              ]
            }
          },
          {
            "id": "cutout",
            "filter": "circle",
            "inputs": {
              "sprite": "square"
            },
            "options": {
              "layer": "base",
              "x": 3,
              "y": 3,
              "radius": 1,
              "colour": [
                0,
                0,
                0,
                0
              ]
            }
          }
        ],
        "output": "cutout"
      }
    },
    {
      "id": "framed",
      "document": {
        "version": "schemaxis.aseprite/1",
        "nodes": [
          {
            "id": "canvas",
            "filter": "sprite",
            "options": {
              "width": 10,
              "height": 10,
              "layer": "art"
            }
          },
          {
            "id": "place",
            "filter": "importImage",
            "inputs": {
              "sprite": "canvas"
            },
            "options": {
              "source": {
                "$artifact": "icon",
                "index": 1
              },
              "layer": "art",
              "x": 1,
              "y": 1,
              "width": 8,
              "height": 8
            }
          }
        ],
        "output": "place"
      }
    }
  ]
}
