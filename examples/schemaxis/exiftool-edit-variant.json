{
  "version": "schemaxis.exiftool/1",
  "operation": "editMetadata",
  "media": {
    "folder": {
      "path": "/tmp/schemaxis-exiftool-acceptance/write",
      "extensions": [
        ".jpg"
      ],
      "depth": 1,
      "maxItems": 16
    }
  },
  "edits": {
    "locationCity": {
      "set": "Zürich"
    },
    "locationCountry": {
      "set": "Schweiz"
    },
    "keywords": {
      "clear": true
    }
  },
  "policies": {
    "iptc": "ifPresent",
    "exifEncoding": "ascii",
    "companionLoss": "removeCompanion",
    "otherLanguages": "remove"
  }
}
