{
  "version": "schemaxis.calc/1",
  "nodes": [
    {
      "id": "parts",
      "filter": "readTypedCSV",
      "options": {
        "file": "/replace/with/typed-parts.csv",
        "columns": [
          {
            "name": "Part ID",
            "kind": "text"
          },
          {
            "name": "Mass (g)",
            "kind": "number",
            "nullable": true
          },
          {
            "name": "Note",
            "kind": "text",
            "nullable": true
          },
          {
            "name": "Length (mm)",
            "kind": "number"
          }
        ]
      }
    }
  ],
  "requirements": [
    {
      "name": "mass-total",
      "type": "cellBounds",
      "cell": {
        "sheet": "Summary",
        "cell": "C2"
      },
      "minimum": 37,
      "maximum": 38
    },
    {
      "name": "mass-blanks",
      "type": "cellBounds",
      "cell": {
        "sheet": "Summary",
        "cell": "H2"
      },
      "minimum": 1,
      "maximum": 1
    }
  ]
}
