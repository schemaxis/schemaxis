{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "cad",
      "document": {
        "measurements": [
          {
            "id": "volume",
            "node": "plate",
            "quantity": "volume"
          },
          {
            "id": "height",
            "node": "plate",
            "quantity": "extentZ"
          }
        ],
        "nodes": [
          {
            "drive": {
              "height": {
                "offset": 0,
                "terms": {
                  "thickness": 1
                }
              }
            },
            "filter": "box",
            "id": "blank",
            "options": {
              "length": 80,
              "width": 50
            }
          },
          {
            "drive": {
              "height": {
                "offset": 2,
                "terms": {
                  "thickness": 1
                }
              }
            },
            "filter": "cylinder",
            "id": "drill",
            "options": {
              "origin": [
                40,
                25,
                -1
              ],
              "radius": 3
            }
          },
          {
            "filter": "cut",
            "id": "plate",
            "inputs": {
              "base": "blank",
              "tool": "drill"
            }
          }
        ],
        "output": "plate",
        "parameters": {
          "thickness": {
            "kind": "length",
            "maximum": 10,
            "minimum": 2,
            "value": 5
          }
        },
        "units": "mm",
        "version": "schemaxis.freecad/1"
      }
    },
    {
      "id": "consumer",
      "document": {
        "version": "schemaxis.freecad/1",
        "nodes": [
          {
            "id": "body",
            "filter": "box",
            "options": {
              "length": 10,
              "width": 10,
              "height": {
                "$value": "cad",
                "artifact": 3,
                "path": "/measurements/height/value"
              }
            }
          }
        ],
        "output": "body"
      }
    },
    {
      "id": "independent",
      "document": {
        "version": "schemaxis.freecad/1",
        "nodes": [
          {
            "id": "body",
            "filter": "box",
            "options": {
              "length": 10,
              "width": 10,
              "height": 2
            }
          }
        ],
        "output": "body"
      }
    }
  ]
}
