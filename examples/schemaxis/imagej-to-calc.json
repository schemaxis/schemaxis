{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "particles",
      "document": {
        "version": "schemaxis.imagej/1",
        "operation": "analyzeParticles",
        "image": "/replace-with-your-input/particles-8bit.pgm",
        "calibration": {
          "pixelWidth": 0.5,
          "pixelHeight": 0.5,
          "unit": "um"
        },
        "threshold": {
          "lower": 100,
          "upper": 255
        },
        "connectivity": "eight",
        "includeHoles": false,
        "excludeEdges": false,
        "minimumArea": 0
      }
    },
    {
      "id": "workbook",
      "document": {
        "version": "schemaxis.calc/1",
        "nodes": [
          {
            "id": "measurements",
            "filter": "readCSV",
            "options": {
              "file": {
                "$artifact": "particles",
                "index": 0
              }
            }
          }
        ]
      }
    }
  ]
}
