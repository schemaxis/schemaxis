{
  "version": "schemaxis/1",
  "nodes": [
    {"id": "ball", "filter": "sphere", "options": {"resolution": 32}},
    {"id": "height", "filter": "calculator", "inputs": {"input": "ball"},
     "options": {"expression": "coordsZ", "result": "height"}},
    {"id": "half", "filter": "clip", "inputs": {"input": "height"}, "options": {"normal": [1, 0, 0]}}
  ],
  "scenes": [
    {"id": "editable",
     "visible": {"half": {"field": ["POINTS", "height"], "preset": "Viridis (matplotlib)",
                          "legend": true, "representation": "Surface With Edges"}},
     "images": [{"id": "view", "size": [480, 360], "cameras": [{"direction": [1, -1, 0.6]}]}],
     "stateBundle": true}
  ]
}
