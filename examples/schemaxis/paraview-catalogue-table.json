{
  "version": "schemaxis/1",
  "nodes": [
    {
      "id": "table",
      "filter": "pvCSVReader",
      "options": {
        "FileName": [
          "examples/schemaxis/catalogue-points.csv"
        ],
        "HaveHeaders": true
      }
    },
    {
      "id": "points",
      "filter": "pvTableToPoints",
      "inputs": {
        "Input": "table"
      },
      "options": {
        "XColumn": "x",
        "YColumn": "y",
        "ZColumn": "z"
      }
    }
  ],
  "scenes": [
    {
      "id": "table",
      "geometry": [
        "table",
        "points"
      ],
      "measurements": [
        {
          "node": "table",
          "association": "ROWS"
        }
      ]
    }
  ]
}
