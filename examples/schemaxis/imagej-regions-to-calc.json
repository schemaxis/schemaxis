{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "series",
      "document": {
        "version": "schemaxis.imagej/1",
        "operation": "measureRegions",
        "frames": [
          {
            "id": "T0",
            "image": "/replace-with-your-input/series/ramp8-t0.pgm",
            "timeSeconds": 0.0
          },
          {
            "id": "T1",
            "image": "/replace-with-your-input/series/ramp8-t1.pgm",
            "timeSeconds": 30.0
          },
          {
            "id": "T2",
            "image": "/replace-with-your-input/series/ramp8-t2.pgm",
            "timeSeconds": 60.0
          },
          {
            "id": "T3",
            "image": "/replace-with-your-input/series/ramp8-t3.pgm",
            "timeSeconds": 90.0
          }
        ],
        "regions": [
          {
            "id": "core",
            "x": 2,
            "y": 1,
            "width": 4,
            "height": 3
          },
          {
            "id": "edge",
            "x": 8,
            "y": 5,
            "width": 4,
            "height": 3
          },
          {
            "id": "nested",
            "x": 3,
            "y": 2,
            "width": 2,
            "height": 1
          }
        ],
        "calibration": {
          "pixelWidth": 0.5,
          "pixelHeight": 2,
          "unit": "um"
        }
      }
    },
    {
      "id": "workbook",
      "document": {
        "version": "schemaxis.calc/1",
        "nodes": [
          {
            "id": "regions",
            "filter": "readTypedCSV",
            "options": {
              "file": {
                "$artifact": "series",
                "index": 0
              },
              "columns": [
                {
                  "name": "frame",
                  "kind": "text"
                },
                {
                  "name": "region",
                  "kind": "text"
                },
                {
                  "name": "timeSeconds",
                  "kind": "number"
                },
                {
                  "name": "pixelCount",
                  "kind": "number"
                },
                {
                  "name": "area_um2",
                  "kind": "number"
                },
                {
                  "name": "meanIntensity",
                  "kind": "number"
                },
                {
                  "name": "minimumIntensity",
                  "kind": "number"
                },
                {
                  "name": "maximumIntensity",
                  "kind": "number"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
