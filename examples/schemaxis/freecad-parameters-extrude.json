{
  "version": "schemaxis.freecad/1",
  "parameters": {
    "depth": {
      "kind": "length",
      "minimum": 2,
      "maximum": 10,
      "value": 5
    }
  },
  "nodes": [
    {
      "id": "profile",
      "filter": "rectangle",
      "options": {
        "width": 20,
        "height": 10
      }
    },
    {
      "id": "body",
      "filter": "extrude",
      "inputs": {
        "profile": "profile"
      },
      "drive": {
        "length": {
          "terms": {
            "depth": 1
          }
        }
      }
    }
  ],
  "output": "body"
}
