{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "cad",
      "document": {
        "version": "schemaxis.freecad/1",
        "units": "mm",
        "nodes": [
          {
            "id": "blank",
            "filter": "box",
            "options": {
              "length": 20,
              "width": 10,
              "height": {
                "$analytic": {
                  "type": "values",
                  "values": [
                    5,
                    7
                  ]
                }
              }
            }
          },
          {
            "id": "rounded",
            "filter": "fillet",
            "inputs": {
              "base": "blank"
            },
            "options": {
              "radius": 1,
              "edges": {
                "where": {
                  "curve": "line",
                  "parallelTo": [
                    0,
                    0,
                    1
                  ]
                },
                "expect": 4
              }
            }
          }
        ],
        "output": "rounded",
        "measurements": [
          {
            "id": "finishedVolume",
            "node": "rounded",
            "quantity": "volume"
          },
          {
            "id": "finishedArea",
            "node": "rounded",
            "quantity": "surfaceArea"
          },
          {
            "id": "height",
            "node": "rounded",
            "quantity": "extentZ"
          },
          {
            "id": "centre",
            "node": "rounded",
            "quantity": "centreOfMass"
          },
          {
            "id": "verticalEdgeLength",
            "node": "blank",
            "quantity": "totalEdgeLength",
            "edges": {
              "where": {
                "parallelTo": [
                  0,
                  0,
                  1
                ]
              },
              "expect": 4
            }
          }
        ]
      }
    },
    {
      "id": "mesh",
      "document": {
        "version": "schemaxis.gmsh/1",
        "units": "mm",
        "nodes": [
          {
            "id": "solid",
            "filter": "readSTEP",
            "options": {
              "file": {
                "$artifact": "cad",
                "index": 0
              }
            }
          },
          {
            "id": "mesh",
            "filter": "tetrahedral",
            "inputs": {
              "input": "solid"
            },
            "options": {
              "size": {
                "$expr": {
                  "op": "multiply",
                  "args": [
                    {
                      "$value": "cad",
                      "artifact": 3,
                      "path": "/measurements/height/value"
                    },
                    0.4
                  ]
                }
              },
              "volumeTolerance": 0.01
            }
          }
        ],
        "output": "mesh"
      }
    },
    {
      "id": "table",
      "document": {
        "version": "schemaxis.octave/1",
        "nodes": [
          {
            "id": "values",
            "filter": "samples",
            "options": {
              "x": [
                0,
                1,
                2
              ],
              "y": [
                {
                  "$value": "cad",
                  "artifact": 3,
                  "path": "/measurements/finishedVolume/value"
                },
                {
                  "$value": "cad",
                  "artifact": 3,
                  "path": "/measurements/verticalEdgeLength/value"
                },
                {
                  "$expr": {
                    "op": "multiply",
                    "args": [
                      {
                        "$value": "cad",
                        "artifact": 3,
                        "path": "/measurements/finishedVolume/value"
                      },
                      0.001
                    ]
                  }
                }
              ]
            }
          }
        ],
        "outputs": [
          "values"
        ]
      }
    }
  ]
}
