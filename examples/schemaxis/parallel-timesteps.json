{
  "version": "schemaxis.workflow/1",
  "execution": {"maxWorkers": 2, "cpus": 4, "memoryMB": 4096, "gpus": 0},
  "operations": [
    {"id": "surfaces", "execution": {"threads": 1, "memoryMB": 1024, "timeChunkSize": 2},
     "document": {"version": "schemaxis/1", "times": [0, 1, 2, 3],
       "nodes": [{"id": "sphere", "filter": "sphere", "options": {"radius": {"$calc": "add", "args": [1, {"$time": true}]}}}],
       "scenes": [{"id": "surface", "geometry": ["sphere"]}]}},
    {"id": "independent", "execution": {"threads": 1, "memoryMB": 1024},
     "document": {"version": "schemaxis/1", "nodes": [{"id": "sphere", "filter": "sphere", "options": {"radius": 3}}],
       "scenes": [{"id": "surface", "geometry": ["sphere"]}]}}
  ]
}
