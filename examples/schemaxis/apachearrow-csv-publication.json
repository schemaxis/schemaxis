{
  "version": "schemaxis.apachearrow/1",
  "operation": "prepareTable",
  "source": "/replace/with/measurements.csv",
  "columns": [
    {
      "name": "id",
      "type": "int64",
      "nullable": false
    },
    {
      "name": "small",
      "type": "int32",
      "nullable": false
    },
    {
      "name": "reading",
      "type": "float64",
      "nullable": true
    },
    {
      "name": "enabled",
      "type": "bool",
      "nullable": true
    },
    {
      "name": "label",
      "type": "utf8",
      "nullable": true
    },
    {
      "name": "observed",
      "type": "timestamp_us_utc",
      "nullable": true
    }
  ],
  "where": [
    {
      "column": "small",
      "test": "ne",
      "value": "1"
    }
  ],
  "select": [
    {
      "column": "id",
      "name": "sample_id"
    },
    {
      "column": "small",
      "name": "batch",
      "cast": "int64"
    },
    {
      "column": "reading",
      "name": "value"
    },
    {
      "column": "enabled",
      "name": "active"
    },
    {
      "column": "label",
      "name": "name",
      "fillNull": "unlabelled"
    },
    {
      "column": "observed",
      "name": "seen_at"
    }
  ],
  "publishCSV": true
}
