{
  "version": "schemaxis.exiftool/1",
  "operation": "auditMetadata",
  "media": {
    "folder": {
      "path": "/tmp/schemaxis-exiftool-acceptance/workbench",
      "depth": 1
    }
  },
  "profiles": [
    "capture",
    "location"
  ],
  "require": [
    "capturedLocal",
    "cameraModel"
  ],
  "rules": [
    "requiredFields",
    "sourceConflicts",
    "unreadableValues",
    "timePlausibility",
    "privacyInventory",
    "duplicateContent"
  ],
  "gpsToleranceSeconds": 300
}
