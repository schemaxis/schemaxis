{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "regression",
      "document": {
        "version": "schemaxis.r/1",
        "operation": "linearRegression",
        "predictors": [
          {
            "name": "temperature",
            "unit": "degC"
          }
        ],
        "response": {
          "name": "reading",
          "unit": "V"
        },
        "training": [
          [
            -2,
            6.1
          ],
          [
            -1,
            7.8
          ],
          [
            1,
            12.2
          ],
          [
            2,
            13.9
          ]
        ],
        "heldout": [
          [
            0,
            10.1
          ],
          [
            3,
            15.8
          ]
        ],
        "requirements": [
          {
            "name": "training_rmse",
            "scope": "training",
            "metric": "rmse",
            "maximum": 0.17
          },
          {
            "name": "heldout_error",
            "scope": "heldout",
            "metric": "maxAbsoluteError",
            "maximum": 0.21
          },
          {
            "name": "calibration_prediction",
            "scope": "heldout",
            "metric": "prediction",
            "sampleIndex": 0,
            "minimum": 9.99,
            "maximum": 10.01
          }
        ]
      }
    },
    {
      "id": "workbook",
      "document": {
        "version": "schemaxis.calc/1",
        "nodes": [
          {
            "id": "voltages",
            "filter": "readCSV",
            "options": {
              "file": {
                "$artifact": "regression",
                "index": 2
              }
            }
          }
        ],
        "requirements": [
          {
            "name": "residual_lower",
            "type": "cellBounds",
            "cell": {"sheet": "Summary", "cell": "E5"},
            "minimum": -0.21
          },
          {
            "name": "residual_upper",
            "type": "cellBounds",
            "cell": {"sheet": "Summary", "cell": "F5"},
            "maximum": 0.21
          },
          {
            "name": "residual_identity",
            "type": "reconcile",
            "terms": [
              {"sheet": "Summary", "cell": "C3", "coefficient": 1},
              {"sheet": "Summary", "cell": "C4", "coefficient": -1},
              {"sheet": "Summary", "cell": "C5", "coefficient": -1}
            ],
            "target": 0,
            "absoluteTolerance": 1e-10
          }
        ]
      }
    }
  ]
}
