{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "denoise",
      "document": {
        "version": "schemaxis.numpy/1",
        "operation": "principalComponents",
        "source": "/replace/with/numpy-sensors.csv",
        "rowKey": {
          "name": "time",
          "unit": "s"
        },
        "channels": [
          {
            "name": "ch1",
            "unit": "mV"
          },
          {
            "name": "ch2",
            "unit": "mV"
          },
          {
            "name": "ch3",
            "unit": "mV"
          },
          {
            "name": "ch4",
            "unit": "mV"
          }
        ],
        "scaling": "none",
        "retention": {
          "components": 2
        },
        "output": "subspace"
      }
    },
    {
      "id": "reanalyse",
      "document": {
        "version": "schemaxis.numpy/1",
        "operation": "principalComponents",
        "source": {
          "$artifact": "denoise",
          "index": 2
        },
        "rowKey": {
          "name": "time",
          "unit": "s"
        },
        "channels": [
          {
            "name": "ch1",
            "unit": "mV"
          },
          {
            "name": "ch2",
            "unit": "mV"
          },
          {
            "name": "ch3",
            "unit": "mV"
          },
          {
            "name": "ch4",
            "unit": "mV"
          }
        ],
        "scaling": "none",
        "retention": {
          "components": 2
        },
        "output": "components",
        "requirements": {
          "minimumExplainedVariance": 0.999
        }
      }
    }
  ]
}
