{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "assemble",
      "document": {
        "version": "schemaxis.qpdf/1",
        "operation": "assemble",
        "sources": [
          {
            "name": "cover",
            "path": "/replace/with/cover.pdf"
          },
          {
            "name": "report",
            "path": "/replace/with/report.pdf"
          }
        ],
        "pages": [
          {
            "source": "cover",
            "page": 1
          },
          {
            "source": "report",
            "page": 2
          },
          {
            "source": "report",
            "page": 3,
            "rotate": 90
          }
        ]
      }
    },
    {
      "id": "review",
      "document": {
        "version": "schemaxis.mupdf/1",
        "operation": "review",
        "source": {
          "$artifact": "assemble",
          "index": 0
        },
        "pages": [
          3,
          1
        ],
        "dpi": 72,
        "rotation": 0
      }
    }
  ]
}
