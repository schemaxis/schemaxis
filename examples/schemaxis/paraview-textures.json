{
  "version": "schemaxis/1",
  "nodes": [
    {
      "id": "fileTexture",
      "filter": "pvResourceImageTexture",
      "options": {
        "FileName": "examples/schemaxis/catalogue-texture.png"
      }
    },
    {
      "id": "fileLogo",
      "filter": "pvLogo",
      "inputs": {
        "Texture": "fileTexture"
      }
    },
    {
      "id": "image",
      "filter": "pvPNGSeriesReader",
      "options": {
        "FileNames": [
          "examples/schemaxis/catalogue-texture.png"
        ]
      }
    },
    {
      "id": "connectedTexture",
      "filter": "pvResourceTexture",
      "inputs": {
        "Input": "image"
      }
    },
    {
      "id": "connectedLogo",
      "filter": "pvLogo",
      "inputs": {
        "Texture": "connectedTexture"
      }
    }
  ],
  "scenes": [
    {
      "id": "textures",
      "geometry": [
        "fileLogo",
        "connectedLogo"
      ]
    }
  ]
}
