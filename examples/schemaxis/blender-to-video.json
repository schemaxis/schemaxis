                },
                {
                  "$artifact": "back",
                  "index": 0
                },
                {
                  "$artifact": "front",
                  "index": 0
                },
                {
                  "$artifact": "back",
                  "index": 0
                },
                {
                  "$artifact": "front",
                  "index": 0
                },
                {
                  "$artifact": "back",
                  "index": 0
                },
                {
                  "$artifact": "front",
                  "index": 0
                },
                {
                  "$artifact": "back",
                  "index": 0
                }
              ],
              "fps": 12,
              "codec": "h264"
            }
          }
        ]
      }
    }
  ]
}
