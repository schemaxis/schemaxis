{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "series",
      "document": {
        "version": "schemaxis.imagej/1",
        "operation": "measureRegions",
        "frames": [
          {
            "id": "F0",
            "image": "/replace-with-your-input/series/frac8-t0.pgm",
            "timeSeconds": 0.0
          },
          {
            "id": "F1",
            "image": "/replace-with-your-input/series/frac8-t1.pgm",
            "timeSeconds": 12.5
          },
          {
            "id": "F2",
            "image": "/replace-with-your-input/series/frac8-t2.pgm",
            "timeSeconds": 40.0
          }
        ],
        "regions": [
          {
            "id": "third",
            "x": 1,
            "y": 2,
            "width": 3,
            "height": 1
          },
          {
            "id": "sevenths",
            "x": 0,
            "y": 2,
            "width": 7,
            "height": 1
          },
          {
            "id": "corner",
            "x": 6,
            "y": 3,
            "width": 3,
            "height": 3
          },
          {
            "id": "pixel",
            "x": 8,
            "y": 5,
            "width": 1,
            "height": 1
          },
          {
            "id": "whole",
            "x": 0,
            "y": 0,
            "width": 9,
            "height": 6
          }
        ],
        "calibration": {
          "pixelWidth": 0.5,
          "pixelHeight": 1.5,
          "unit": "um"
        }
      }
    },
    {
      "id": "workbook",
      "document": {
        "version": "schemaxis.calc/1",
        "nodes": [
          {
            "id": "regions",
            "filter": "readTypedCSV",
            "options": {
              "file": {
                "$artifact": "series",
                "index": 0
              },
              "columns": [
                {
                  "name": "frame",
                  "kind": "text"
                },
                {
                  "name": "region",
                  "kind": "text"
                },
                {
                  "name": "timeSeconds",
                  "kind": "number"
                },
                {
                  "name": "pixelCount",
                  "kind": "number"
                },
                {
                  "name": "area_um2",
                  "kind": "number"
                },
                {
                  "name": "meanIntensity",
                  "kind": "number"
                },
                {
                  "name": "minimumIntensity",
                  "kind": "number"
                },
                {
                  "name": "maximumIntensity",
                  "kind": "number"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
