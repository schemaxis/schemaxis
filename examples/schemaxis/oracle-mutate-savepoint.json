{
  "version": "schemaxis.oracle/1",
  "operation": "mutate",
  "connection": {"profile": "free_local"},
  "tables": [
    {
      "name": "accounts",
      "columns": [
        {"name": "id", "type": "number", "precision": 10, "scale": 0},
        {"name": "owner", "type": "varchar2", "length": 20},
        {"name": "balance", "type": "number", "precision": 12, "scale": 2}
      ],
      "primaryKey": ["id"],
      "unique": [{"columns": ["owner"]}],
      "source": {"path": "/replace/with/accounts.json"}
    }
  ],
  "transaction": {
    "steps": [
      {
        "kind": "update",
        "table": "accounts",
        "computed": [{"name": "debited", "function": "subtract", "arguments": [{"column": "accounts.balance"}, {"literal": {"type": "number", "value": "25"}}]}],
        "conditions": [{"name": "payer", "terms": [{"left": {"column": "accounts.id"}, "operator": "equals", "right": {"literal": {"type": "number", "value": "1"}}}]}],
        "set": [{"column": "balance", "value": {"derived": "debited"}}],
        "where": "payer",
        "expectRows": 1
      },
      {"kind": "savepoint", "name": "after_debit"},
      {"kind": "insert", "table": "accounts", "columns": ["id", "owner", "balance"], "rows": [[4, "dave", "10.00"]], "expectRows": 1},
      {"kind": "rollbackTo", "name": "after_debit"},
      {
        "kind": "check",
        "table": "accounts",
        "conditions": [{"name": "everyone", "terms": [{"left": {"column": "accounts.id"}, "operator": "isNull", "negate": true}]}],
        "where": "everyone",
        "expectRows": 3
      }
    ],
    "isolation": "serializable",
    "finish": "commit"
  }
}
