{
  "version": "schemaxis.workflow-template/1",
  "id": "studio.sequence-scale",
  "revision": 1,
  "title": "Sample and scale study",
  "workflow": "workflow.json",
  "parameters": {
    "stop": {
      "label": "Upper bound",
      "kind": "number",
      "help": "Last value in the evenly spaced sequence, beginning at zero.",
      "default": 4,
      "constraints": {
        "minimum": 0.1,
        "maximum": 100
      },
      "target": {
        "scope": "workflow",
        "pointer": "/settings/stop"
      }
    },
    "count": {
      "label": "Sample count",
      "kind": "integer",
      "help": "Number of rows in the sample and scaled tables, including both endpoints.",
      "default": 5,
      "constraints": {
        "minimum": 2,
        "maximum": 1000
      },
      "target": {
        "scope": "workflow",
        "pointer": "/settings/count"
      }
    },
    "factor": {
      "label": "Scale factor",
      "kind": "number",
      "help": "Multiply every y value by this factor; x coordinates are retained.",
      "default": 2,
      "constraints": {
        "minimum": -10,
        "maximum": 10
      },
      "target": {
        "scope": "workflow",
        "pointer": "/settings/factor"
      }
    }
  },
  "outputs": {
    "samples": {
      "operation": "samples",
      "artifact": 0,
      "kind": "table"
    },
    "sampleStatistics": {
      "operation": "samples",
      "artifact": 1,
      "kind": "analysis"
    },
    "scaled": {
      "operation": "scaled",
      "artifact": 0,
      "kind": "table"
    },
    "scaledStatistics": {
      "operation": "scaled",
      "artifact": 1,
      "kind": "analysis"
    }
  }
}
