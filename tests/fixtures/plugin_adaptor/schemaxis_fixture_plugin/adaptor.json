{
  "id": "fixtureplugin",
  "version": "fixtureplugin/1",
  "runtimeFamily": "test",
  "executables": ["fixtureplugin"],
  "execution": "Test-only local artifact writer from an external adaptor package",
  "keywords": ["external adaptor test"],
  "display": {"name": "Fixture Plugin", "mark": "FP", "colour": "#336699"},
  "routes": {
    "fixtureplugin/1": {
      "module": "schemaxis_fixture_plugin.adaptor",
      "schema": "schemaxis_fixture_plugin.adaptor:schema",
      "workflow": true,
      "scheduled": true,
      "acceptedArtifacts": ["text"],
      "hooks": {"reusableInputs": "schemaxis_fixture_plugin.adaptor:reusable_inputs"}
    }
  }
}
