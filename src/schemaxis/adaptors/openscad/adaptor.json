{
  "id": "openscad",
  "version": "schemaxis.openscad/1",
  "adaptor": "schemaxis.adaptors.openscad.adaptor",
  "declarations": "schemaxis.adaptors.openscad.adaptor:DECLARATIONS",
  "runtimeFamily": "2021.01",
  "execution": "Dimensioned mounting plates and annular spacers with native constructive geometry and independent boundary, volume and topology verification",
  "executables": [
    "openscad"
  ],
  "keywords": [
    "constructive CAD",
    "mounting plate",
    "spacer",
    "STL",
    "OpenSCAD"
  ],
  "display": {
    "name": "OpenSCAD",
    "mark": "Os",
    "colour": "#e5b543"
  },
  "capabilities": "schemaxis.adaptors.openscad.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.openscad/1",
    "operation": "plate",
    "units": "mm",
    "plate": {
      "width": 40,
      "depth": 30,
      "height": 3,
      "holes": [
        {
          "centre": [
            10,
            10
          ],
          "diameter": 6
        },
        {
          "centre": [
            30,
            20
          ],
          "diameter": 4
        }
      ]
    }
  },
  "routes": {
    "schemaxis.openscad/1": {
      "module": "schemaxis.adaptors.openscad.adaptor",
      "schema": "schemaxis.adaptors.openscad.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "openscad",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.openscad.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.openscad.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.openscad.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--openscad",
      "dest": "openscad",
      "help": "Absolute stable OpenSCAD 2021.01 executable"
    }
  ]
}
