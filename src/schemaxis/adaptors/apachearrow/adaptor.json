{
  "id": "apachearrow",
  "version": "schemaxis.apachearrow/1",
  "adaptor": "schemaxis.adaptors.apachearrow.adaptor",
  "declarations": "schemaxis.adaptors.apachearrow.adaptor:DECLARATIONS",
  "runtimeFamily": "26.0",
  "execution": "Prepare explicitly typed nullable CSV tables as independently checked Parquet and an inspectable report",
  "executables": [
    "python3"
  ],
  "keywords": [
    "Apache Arrow",
    "PyArrow",
    "Parquet",
    "nullable table",
    "typed CSV"
  ],
  "display": {
    "name": "Apache Arrow",
    "mark": "Ar",
    "colour": "#d8582a"
  },
  "capabilities": "schemaxis.adaptors.apachearrow.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.apachearrow/1",
    "operation": "prepareTable",
    "source": "/replace/with/measurements.csv",
    "columns": [
      {
        "name": "id",
        "type": "int64",
        "nullable": false
      },
      {
        "name": "small",
        "type": "int32",
        "nullable": false
      },
      {
        "name": "reading",
        "type": "float64",
        "nullable": true
      },
      {
        "name": "enabled",
        "type": "bool",
        "nullable": true
      },
      {
        "name": "label",
        "type": "utf8",
        "nullable": true
      },
      {
        "name": "observed",
        "type": "timestamp_us_utc",
        "nullable": true
      }
    ],
    "where": [],
    "select": [
      {
        "column": "id",
        "name": "id"
      },
      {
        "column": "small",
        "name": "small"
      },
      {
        "column": "reading",
        "name": "reading"
      },
      {
        "column": "enabled",
        "name": "enabled"
      },
      {
        "column": "label",
        "name": "label"
      },
      {
        "column": "observed",
        "name": "observed"
      }
    ]
  },
  "routes": {
    "schemaxis.apachearrow/1": {
      "module": "schemaxis.adaptors.apachearrow.adaptor",
      "schema": "schemaxis.adaptors.apachearrow.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "apachearrow",
      "acceptedArtifacts": [
        "file"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.apachearrow.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.apachearrow.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.apachearrow.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--apachearrow",
      "dest": "apachearrow",
      "help": "Absolute isolated Python interpreter containing qualified PyArrow 26.0.0"
    }
  ]
}
