{
  "id": "graphviz",
  "version": "schemaxis.graphviz/1",
  "adaptor": "schemaxis.adaptors.graphviz.adaptor",
  "declarations": "schemaxis.adaptors.graphviz.adaptor:DECLARATIONS",
  "runtimeFamily": "16.1",
  "execution": "Automatic directed dependency/flow graph layout with literal topology and SVG/plain geometry verification",
  "executables": [
    "dot"
  ],
  "keywords": [
    "Graphviz",
    "directed graph",
    "automatic layout",
    "dependency diagram"
  ],
  "display": {
    "name": "Graphviz",
    "mark": "Gv",
    "colour": "#526a8a"
  },
  "capabilities": "schemaxis.adaptors.graphviz.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.graphviz/1",
    "operation": "layout",
    "nodes": [
      {
        "id": "extract",
        "label": "Extract 01"
      },
      {
        "id": "build",
        "label": "Build"
      },
      {
        "id": "check",
        "label": "Check"
      },
      {
        "id": "publish",
        "label": "Publish"
      }
    ],
    "edges": [
      {
        "source": "extract",
        "target": "build"
      },
      {
        "source": "extract",
        "target": "check"
      },
      {
        "source": "build",
        "target": "publish"
      },
      {
        "source": "check",
        "target": "publish"
      }
    ]
  },
  "routes": {
    "schemaxis.graphviz/1": {
      "module": "schemaxis.adaptors.graphviz.adaptor",
      "schema": "schemaxis.adaptors.graphviz.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "graphviz",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.graphviz.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.graphviz.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.graphviz.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--graphviz",
      "dest": "graphviz",
      "help": "Absolute Graphviz dot 16.1.0 executable"
    }
  ]
}
