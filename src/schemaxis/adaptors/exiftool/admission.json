{
  "protocol": "schemaxis.file-admission/1",
  "routes": {
    "schemaxis.exiftool/1": {
      "operations": "catalogue",
      "operationSelectors": [
        "/operation"
      ],
      "fileSlots": [
        {
          "pointer": "/photos/*/path",
          "suffixes": [
            ".jpg",
            ".jpeg"
          ],
          "maxBytes": 8388608,
          "contentPolicy": "native"
        },
        {
          "pointer": "/media/items/*/path",
          "suffixes": [
            ".jpg",
            ".jpeg",
            ".tif",
            ".tiff",
            ".dng",
            ".png",
            ".webp",
            ".heic",
            ".heif",
            ".avif",
            ".xmp"
          ],
          "maxBytes": 67108864,
          "contentPolicy": "native"
        },
        {
          "pointer": "/media/items/*/sidecar",
          "suffixes": [
            ".xmp"
          ],
          "maxBytes": 8388608,
          "contentPolicy": "native"
        },
        {
          "pointer": "/source/file/path",
          "suffixes": [
            ".jpg",
            ".jpeg",
            ".tif",
            ".tiff",
            ".dng",
            ".png",
            ".webp",
            ".heic",
            ".heif",
            ".avif",
            ".xmp"
          ],
          "maxBytes": 8388608,
          "contentPolicy": "native"
        },
        {
          "pointer": "/tracks/*/path",
          "suffixes": [
            ".gpx"
          ],
          "maxBytes": 8388608,
          "contentPolicy": "native"
        },
        {
          "pointer": "/names",
          "suffixes": [
            ".json"
          ],
          "maxBytes": 8388608,
          "stringOnly": true,
          "contentPolicy": "native"
        }
      ],
      "forbiddenPointers": [
        "/media/folder",
        "/plan",
        "/photoTime/clockCorrection/plan"
      ],
      "qualification": [
        "verification/2026-10-26-exiftool-71.md",
        "verification/2026-10-26-exiftool-time-location-74.md",
        "verification/2026-10-27-exiftool-containers-74.md",
        "verification/2026-10-27-exiftool-copy-sidecar-naming-74.md"
      ],
      "scope": "All 16 declared metadata operations on explicit immutable media sets, optional declared sidecars, external copy sources and tracks; typed inline intent is preserved.",
      "limitations": [
        "Folder scanning requires an immutable directory closure and is refused in this file-capture profile.",
        "Saved E3 plans can contain indirect track paths; use inline time/location intent until the saved-plan closure is qualified."
      ]
    }
  }
}
