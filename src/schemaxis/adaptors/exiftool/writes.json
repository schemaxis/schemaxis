 "minimise": {
  "label": "Minimise",
  "description": "Rendering-preserving minimisation in one step: every EXIF, XMP, IPTC and Photoshop (APP13) block and every JPEG comment is deleted, including the thumbnail, GPS, maker note and device records; the encoded image and the JFIF, Adobe and ICC segments stay byte for byte, and only the EXIF values that decide how the picture is drawn are kept (Orientation, YCbCrPositioning, ColorSpace, InteropIndex). What was deleted, kept or left is listed in the residual report. It is a closed list of known deletions, never a bare delete-all, and it is not anonymisation.",
  "deletes": [
   "EXIF:all",
   "XMP:all",
   "IPTC:all",
   "Photoshop:all"
  ],
  "comment": true,
  "preserve": [
   {
    "ifd": "IFD0",
    "tag": "0x0112",
    "name": "Orientation",
    "write": "IFD0:Orientation",
    "numeric": true,
    "values": [
     1,
     2,
     3,
     4,
     5,
     6,
     7,
     8
    ]
   },
   {
    "ifd": "IFD0",
    "tag": "0x0213",
    "name": "YCbCrPositioning",
    "write": "IFD0:YCbCrPositioning",
    "numeric": true,
    "values": [
     1,
     2
    ]
   },
   {
    "ifd": "ExifIFD",
    "tag": "0xA001",
    "name": "ColorSpace",
    "write": "ExifIFD:ColorSpace",
    "numeric": true,
    "values": [
     1,
     65535
    ]
   },
   {
    "ifd": "InteropIFD",
    "tag": "0x0001",
    "name": "InteropIndex",
    "write": "InteropIFD:InteropIndex",
    "numeric": false,
    "values": [
     "R98",
     "R03",
     "THM"
    ]
   }
  ],
  "refuseIfPresent": [
   {
    "ifd": "ExifIFD",
    "tag": "0xA500",
    "name": "Gamma",
    "reason": "the gamma of the picture cannot be kept by this minimisation"
   }
  ],
  "xmpRendering": {
   "tiff:Orientation": {
    "ifd": "IFD0",
    "tag": "0x0112"
   },
   "exif:ColorSpace": {
    "ifd": "ExifIFD",
