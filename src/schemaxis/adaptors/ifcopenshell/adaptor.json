{
  "id": "ifcopenshell",
  "version": "schemaxis.ifcopenshell/1",
  "adaptor": "schemaxis.adaptors.ifcopenshell.adaptor",
  "declarations": "schemaxis.adaptors.ifcopenshell.adaptor:DECLARATIONS",
  "runtimeFamily": "0.9.0.post1",
  "execution": "Bounded offline schedule of 2 to 64 plain IfcWall occurrences in one ASCII IFC4 file with IfcOpenShell 0.9.0.post1: explicit property and quantity columns, explicit occurrence/type precedence and missingness, project SI units converted to m, m2 and m3, a fresh native reopen and a strict independent STEP walk that decides every GUID, origin and value, published as a typed CSV and a metadata-rich schedule",
  "executables": [
    "python"
  ],
  "keywords": [
    "IFC",
    "IFC4",
    "IfcOpenShell",
    "BIM",
    "wall schedule",
    "property set",
    "quantity set",
    "IfcWall",
    "building model schedule",
    "GlobalId"
  ],
  "display": {
    "name": "IfcOpenShell",
    "mark": "If",
    "colour": "#4f7f6a"
  },
  "capabilities": "schemaxis.adaptors.ifcopenshell.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.ifcopenshell/1",
    "operation": "scheduleWalls",
    "source": {
      "path": "/replace/with/walls.ifc"
    },
    "class": "IfcWall",
    "columns": [
      {
        "name": "Fire rating",
        "source": "property",
        "set": "Pset_WallCommon",
        "property": "FireRating",
        "valueType": "text"
      },
      {
        "name": "Length (m)",
        "source": "quantity",
        "set": "Qto_WallBaseQuantities",
        "quantityName": "Length",
        "quantity": "length"
      }
    ],
    "missing": "refuse",
    "inheritance": "occurrence-only"
  },
  "routes": {
    "schemaxis.ifcopenshell/1": {
      "module": "schemaxis.adaptors.ifcopenshell.adaptor",
      "schema": "schemaxis.adaptors.ifcopenshell.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "ifcopenshell",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.ifcopenshell.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.ifcopenshell.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.ifcopenshell.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--ifcopenshell",
      "dest": "ifcopenshell",
      "help": "Absolute Python interpreter of a private IfcOpenShell 0.9.0.post1 environment"
    }
  ]
}
