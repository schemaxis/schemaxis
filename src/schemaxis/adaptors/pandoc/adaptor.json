{
  "id": "pandoc",
  "version": "schemaxis.pandoc/1",
  "adaptor": "schemaxis.adaptors.pandoc.adaptor",
  "runtimeFamily": "3.12",
  "execution": "Isolated Pandoc: closed structured report, including retained whisper.cpp transcripts, to standalone HTML and DOCX, and optionally EPUB 3, with fresh semantic readback",
  "executables": [
    "pandoc"
  ],
  "keywords": [
    "report",
    "document",
    "Word",
    "DOCX",
    "HTML",
    "sections",
    "table",
    "publish transcript",
    "caption timestamps table",
    "whisper transcript",
    "transcript timecode",
    "EPUB",
    "epub",
    "ebook",
    "EPUB 3",
    "authors",
    "report authors",
    "author metadata",
    "document description",
    "EPUB creator"
  ],
  "display": {
    "name": "Pandoc",
    "mark": "Pd",
    "colour": "#425a75"
  },
  "capabilities": "schemaxis.adaptors.pandoc.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.pandoc/1",
    "operation": "report",
    "title": "Sensor calibration report",
    "sections": [
      {
        "heading": "Method",
        "level": 1,
        "content": [
          {
            "kind": "paragraph",
            "text": "Measured readings are compared with the reference at three temperatures."
          }
        ]
      },
      {
        "heading": "Results",
        "level": 1,
        "content": [
          {
            "kind": "table",
            "columns": [
              "Temperature (degC)",
              "Reading (V)"
            ],
            "rows": [
              [
                "0",
                "10.0"
              ],
              [
                "10",
                "12.0"
              ],
              [
                "20",
                "14.0"
              ]
            ]
          },
          {
            "kind": "image",
            "source": "/replace/with/calibration.png",
            "alt": "Calibration samples: blue, green and red",
            "widthMm": 60
          }
        ]
      },
      {
        "heading": "Interpretation",
        "level": 2,
        "content": [
          {
            "kind": "paragraph",
            "text": "The bounded sample has a slope of 0.2 V/degC & a reading below 15 V."
          }
        ]
      }
    ]
  },
  "routes": {
    "schemaxis.pandoc/1": {
      "module": "schemaxis.adaptors.pandoc.adaptor",
      "schema": "schemaxis.adaptors.pandoc.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "pandoc",
      "acceptedArtifacts": [
        "text",
        "image"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.pandoc.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.pandoc.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.pandoc.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--pandoc",
      "dest": "pandoc",
      "help": "Absolute Pandoc executable"
    }
  ]
}
