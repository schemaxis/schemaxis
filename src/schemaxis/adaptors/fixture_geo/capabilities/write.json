{
  "id": "fixture.geo.write",
  "contractVersion": "0.1",
  "provider": "fixture.geo",
  "kind": "writer",
  "title": "Write fixture product",
  "summary": "Write and semantically verify a deterministic fixture artifact descriptor.",
  "inputs": {
    "dataset": {"logicalType": ["geo.raster-dataset", "geo.vector-dataset"]}
  },
  "arguments": {
    "uri": {"type": "string", "required": true}
  },
  "outputs": {
    "artifact": {"logicalType": "schemaxis.artifact"}
  },
  "effects": ["write-local-resource"],
  "faults": ["DESTINATION_EXISTS", "WRITE_FAILED", "VERIFICATION_FAILED"]
}
