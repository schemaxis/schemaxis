{
  "id": "getdp",
  "version": "schemaxis.getdp/1",
  "adaptor": "schemaxis.adaptors.getdp.adaptor",
  "runtimeFamily": "3.5.0",
  "executables": [
    "getdp"
  ],
  "execution": "Serial layered steady thermal and electrical finite element conduction with independent exact and conservation checks",
  "keywords": [
    "GetDP",
    "heat",
    "conduction",
    "thermal",
    "layers",
    "Poisson",
    "electrical",
    "resistance",
    "flux",
    "convection"
  ],
  "capabilities": "schemaxis.adaptors.getdp.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.getdp/1",
    "operation": "steadyHeat",
    "layers": [
      {
        "name": "slab",
        "thickness_m": 0.1,
        "conductivity": 10,
        "cells": 10
      }
    ],
    "left": {
      "kind": "value",
      "value": 400
    },
    "right": {
      "kind": "value",
      "value": 300
    },
    "area_m2": 0.5
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "routes": {
    "schemaxis.getdp/1": {
      "module": "schemaxis.adaptors.getdp.adaptor",
      "schema": "schemaxis.adaptors.getdp.adaptor:schema",
      "schemaName": "getdp",
      "graphEditing": false,
      "workflow": true,
      "scheduled": true,
      "compose": true,
      "acceptedArtifacts": [],
      "hooks": {
        "query": "schemaxis.adaptors.getdp.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.getdp.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.getdp.adaptor:resources"
      }
    }
  },
  "cliOptions": [
    {
      "flag": "--getdp",
      "dest": "getdp",
      "help": "Absolute stable GetDP 3.5.0 executable"
    }
  ]
}
