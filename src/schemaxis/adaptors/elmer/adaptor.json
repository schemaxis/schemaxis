{
  "id": "elmer",
  "version": "schemaxis.elmer/1",
  "adaptor": "schemaxis.adaptors.elmer.adaptor",
  "runtimeFamily": "26.2",
  "execution": "Isolated serial ElmerSolver: independently checked layered steady solid heat conduction",
  "executables": [],
  "keywords": [
    "solid conduction",
    "thermal insulation",
    "layered wall"
  ],
  "capabilities": "schemaxis.adaptors.elmer.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.elmer/1",
    "operation": "steadyHeat",
    "layers": [
      {
        "name": "wall",
        "thickness_m": 0.2,
        "conductivity_W_mK": 10,
        "cells": 8
      }
    ],
    "left": {
      "kind": "value",
      "value": 400
    },
    "right": {
      "kind": "value",
      "value": 300
    }
  },
  "routes": {
    "schemaxis.elmer/1": {
      "module": "schemaxis.adaptors.elmer.adaptor",
      "schema": "schemaxis.adaptors.elmer.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "elmer",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.elmer.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.elmer.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.elmer.adaptor:resources"
      }
    }
  },
  "display": {
    "name": "Elmer FEM",
    "mark": "EF",
    "colour": "#34617c"
  },
  "cliOptions": [
    {
      "flag": "--elmer",
      "dest": "elmer",
      "help": "Absolute stable ElmerSolver executable"
    }
  ],
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  }
}
