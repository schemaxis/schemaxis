{
  "id": "sqlite",
  "version": "schemaxis.sqlite/1",
  "adaptor": "schemaxis.adaptors.sqlite.adaptor",
  "declarations": "schemaxis.adaptors.sqlite.adaptor:DECLARATIONS",
  "runtimeFamily": "3.54",
  "execution": "Fresh STRICT typed table imports and bounded foreign-key join/filter/group summaries with exact independent row verification",
  "executables": [
    "sqlite3"
  ],
  "keywords": [
    "relational",
    "SQLite",
    "typed tables"
  ],
  "display": {
    "name": "SQLite",
    "mark": "Sq",
    "colour": "#35617a"
  },
  "capabilities": "schemaxis.adaptors.sqlite.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.sqlite/1",
    "operation": "summarise",
    "tables": [
      {
        "name": "departments",
        "source": "/replace/with/departments.json",
        "columns": [
          {
            "name": "id",
            "type": "INTEGER"
          },
          {
            "name": "region",
            "type": "TEXT",
            "nullable": true
          }
        ],
        "primaryKey": "id"
      },
      {
        "name": "sales",
        "source": "/replace/with/sales.json",
        "columns": [
          {
            "name": "id",
            "type": "INTEGER"
          },
          {
            "name": "department",
            "type": "INTEGER",
            "nullable": true
          },
          {
            "name": "amount",
            "type": "INTEGER",
            "nullable": true
          }
        ],
        "primaryKey": "id",
        "foreignKeys": [
          {
            "column": "department",
            "table": "departments",
            "target": "id"
          }
        ]
      }
    ],
    "from": "sales",
    "join": {
      "table": "departments",
      "local": "department",
      "remote": "id"
    },
    "where": {
      "column": "sales.id",
      "minimum": 1
    },
    "groupBy": [
      "departments.region"
    ],
    "sum": "sales.amount"
  },
  "routes": {
    "schemaxis.sqlite/1": {
      "module": "schemaxis.adaptors.sqlite.adaptor",
      "schema": "schemaxis.adaptors.sqlite.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "sqlite",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.sqlite.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.sqlite.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.sqlite.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--sqlite",
      "dest": "sqlite",
      "help": "Absolute sqlite3 command-line executable (qualified 3.54.1)"
    }
  ]
}
