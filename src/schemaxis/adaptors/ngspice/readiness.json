      "development": {
        "api": [
          "https://ngspice.sourceforge.io/ngspice-control-language-tutorial.html",
          "https://ngspice.sourceforge.io/docs.html",
          "https://ngspice.sourceforge.io/download.html"
        ],
        "lifecycle": {
          "timeout": "One deadline covers runtime identification, simulation and fresh-process raw-data reopen. Shared kit watchdog independently bounds the entire attempt. A final deadline check also bounds CPU verification before success publication.",
          "cancellation": "Shared owned-process cancellation and final cancellation check before publication; no resident simulator.",
          "logs": "Retain authored/effective plans, deterministic netlists, runtime/version logs, simulation and reopen stdout/stderr, ASCII raw data, native/reopened tables, publications and failure results.",
          "verification": "Independent partial-pivot complex nodal equations check all native node voltages for DC/AC. First-order RC voltage is compared to V*(1-exp(-t/RC)). Exact sample coordinates, publication conversions and a separate ASCII raw parser are checked; a fresh ngspice process reloads the raw data. Digest and authored/plan checks run offline. Inductive AC uses 1/(j*omega*L) stamps, checks every requested frequency before native launch and preserves uncancelled admittance scales to reject undamped resonant cancellation. Closed-form RL and series/parallel RLC transfer functions supply independent fixture expectations. Performance is recomputed from checked native voltages and authored requirements, so refreshing ordinary summary hashes cannot turn an unmet bound into success."
        },
        "data": [
          {
            "id": "table",
            "direction": "output",
            "kind": "table",
            "format": "numeric CSV",
            "traits": {
              "units": "SI with voltage/frequency/time columns; phase in degrees",
              "samples": "2\u2013512"
            },
            "losses": [
              "Selected node voltages only; no device currents or nonlinear model data.",
              "CSV alone omits circuit topology; retain netlist and summary."
            ],
            "scope": "DC or first-order RC voltage tables; AC real/imaginary/magnitude/principal phase at linearly spaced frequencies."
          },
          {
            "id": "netlist",
            "direction": "output",
            "kind": "text",
            "format": "SPICE netlist",
            "traits": {
              "runtime": "ngspice-47",
              "generated": true
            },
            "losses": [
              "No schematic layout, board geometry, vendor libraries or KiCad project authoring."
            ],
            "scope": "Deterministically generated resistor/capacitor/AC-inductor circuit plus bounded control commands; never an authored arbitrary script."
          },
          {
            "id": "summary",
            "direction": "output",
            "kind": "text",
            "format": "JSON",
            "traits": {
              "physicalUnits": "V, ohm, F, H, Hz, s"
            },
            "losses": [
              "Ideal linear circuit and explicit sampled component variants only; no continuous or all-tolerance proof and no hardware validation."
            ],
            "scope": "Topology, selected outputs, measured discrepancy, RC time constant and explicit assumptions. Optional named sampled requirements, measured extrema, worst coordinates, signed margins and next actions."
          }
        ],
        "inspection": [
          {
            "panel": "table",
            "scope": "Inspect CSV scales and selected voltage/phasor components.",
            "limits": "At most 512 numeric samples; no native schematic viewer."
          },
          {
            "panel": "text",
            "scope": "Review topology/netlist, first/last sample, independent discrepancies and physical assumptions. Review each performance margin and worst sampled condition.",
            "limits": "Generated netlist and bounded JSON; no arbitrary source execution."
          }
        ],
