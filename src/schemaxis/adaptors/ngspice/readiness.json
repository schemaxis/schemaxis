      "profiles": {
        "workflow": {
          "scope": "Numeric circuit results into Calc with preserved column names and independent workbook readback; keep summary/netlist for physical meaning.",
          "references": [
            "docs/ngspice.md",
            "tools/qualify_ngspice.py"
          ]
        },
        "composition": {
          "scope": "Shared document references, pure value functions and expressions resolve for every finite analytic visit before native validation. Explicit capacitance variants can be evaluated with the same bounds; each visit is independently measured and finite only.",
          "references": [
            "docs/adaptor-runtime.md",
            "tests/unit/test_adaptor_runtime.py",
            "examples/schemaxis/ngspice-capacitance-study.json"
          ]
