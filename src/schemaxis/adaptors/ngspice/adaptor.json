  "executables": [],
  "keywords": [
    "circuits",
    "SPICE",
    "DC",
    "AC",
    "RC",
    "frequency",
    "CSV",
    "RL",
    "RLC",
    "inductance",
    "resonance",
    "impedance",
    "logarithmic"
