    "operation": "dcSweep",
    "circuit": {
      "source": "in",
      "resistors": [
        {
          "name": "r1",
          "a": "in",
          "b": "out",
          "resistance": 1000
        },
        {
          "name": "r2",
          "a": "out",
          "b": "0",
          "resistance": 2000
        }
      ],
      "capacitors": [],
      "probes": [
        "out"
      ]
    },
    "start": 0,
    "stop": 5,
    "points": 6
