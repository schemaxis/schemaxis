  "routes": {
    "schemaxis.ngspice/1": {
      "module": "schemaxis.adaptors.ngspice.adaptor",
      "schema": "schemaxis.adaptors.ngspice.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "ngspice",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.ngspice.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.ngspice.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.ngspice.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
