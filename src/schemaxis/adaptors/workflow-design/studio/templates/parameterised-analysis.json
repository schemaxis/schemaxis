{
  "version": "schemaxis.workflow-design/2",
  "workflow": {
    "version": "schemaxis.workflow/1",
    "operations": [
      {
        "id": "analyse",
        "document": {
          "version": "schemaxis.octave/1",
          "nodes": [
            {
              "id": "samples",
              "filter": "sequence",
              "options": {
                "start": 0,
                "stop": 1,
                "count": {
                  "$document": "/settings/count",
                  "scope": "workflow"
                }
              }
            }
          ],
          "outputs": [
            "samples"
          ]
        }
      }
    ],
    "settings": {
      "count": {
        "$fill": "count"
      }
    }
  },
  "ports": {},
  "connections": [],
  "controllers": {},
  "parameters": {
    "count": {
      "label": "Samples",
      "kind": "integer",
      "constraints": {
        "minimum": 2,
        "maximum": 10000
      },
      "target": {
        "scope": "workflow",
        "pointer": "/settings/count"
      }
    }
  },
  "outputs": {},
  "naming": {},
  "layout": {}
}
