{
  "id": "meshio",
  "version": "schemaxis.meshio/1",
  "adaptor": "schemaxis.adaptors.meshio.adaptor",
  "declarations": "schemaxis.adaptors.meshio.adaptor:DECLARATIONS",
  "runtimeFamily": "5.3",
  "execution": "Isolated strict ASCII mesh interchange with explicit coordinate units and independent topology/data preservation checks",
  "executables": [
    "python3"
  ],
  "keywords": [
    "mesh interchange",
    "VTU",
    "VTK",
    "meshio",
    "hexahedral volume",
    "CAE mesh"
  ],
  "display": {
    "name": "meshio",
    "mark": "Mi",
    "colour": "#367985"
  },
  "capabilities": "schemaxis.adaptors.meshio.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.meshio/1",
    "operation": "convert",
    "source": "/replace/with/mixed.vtu",
    "sourceFormat": "vtu",
    "targetFormat": "vtk",
    "sourceUnits": "mm",
    "targetUnits": "m",
    "lossPolicy": "strict"
  },
  "routes": {
    "schemaxis.meshio/1": {
      "module": "schemaxis.adaptors.meshio.adaptor",
      "schema": "schemaxis.adaptors.meshio.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "meshio",
      "acceptedArtifacts": [
        "geometry"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.meshio.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.meshio.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.meshio.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--meshio",
      "dest": "meshio",
      "help": "Absolute isolated Python interpreter with meshio 5.3.5 and NumPy"
    }
  ]
}
