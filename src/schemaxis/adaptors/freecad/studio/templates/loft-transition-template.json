{
  "version": "schemaxis.freecad/1",
  "units": "mm",
  "nodes": [
    {
      "id": "${prefix}Inlet",
      "filter": "circle",
      "options": {
        "radius": 20
      }
    },
    {
      "id": "${prefix}Outlet",
      "filter": "circle",
      "options": {
        "radius": {
          "$fill": "radius"
        },
        "origin": [
          0,
          0,
          40
        ]
      }
    },
    {
      "id": "${prefix}Part",
      "filter": "loft",
      "options": {
        "ruled": {
          "$fill": "ruled"
        }
      },
      "inputs": {
        "sections": [
          "${prefix}Inlet",
          "${prefix}Outlet"
        ]
      }
    }
  ],
  "output": "${prefix}Part"
}
