{
  "version": "schemaxis.freecad/1",
  "units": "mm",
  "nodes": [
    {
      "id": "${prefix}Outer",
      "filter": "cylinder",
      "options": {
        "radius": 12,
        "height": 20
      }
    },
    {
      "id": "${prefix}Bore",
      "filter": "cylinder",
      "options": {
        "radius": {
          "$fill": "radius"
        },
        "height": 22,
        "origin": [
          0,
          0,
          -1
        ]
      }
    },
    {
      "id": "${prefix}Part",
      "filter": "cut",
      "inputs": {
        "base": "${prefix}Outer",
        "tool": "${prefix}Bore"
      }
    }
  ],
  "output": "${prefix}Part"
}
