{
  "version": "schemaxis.freecad/1",
  "units": "mm",
  "nodes": [
    {
      "id": "${prefix}Blank",
      "filter": "box",
      "options": {
        "length": 40,
        "width": 30,
        "height": {
          "$fill": "height"
        }
      }
    },
    {
      "id": "${prefix}Drill",
      "filter": "cylinder",
      "options": {
        "radius": {
          "$fill": "radius"
        },
        "height": 22,
        "origin": [
          20,
          15,
          -1
        ]
      }
    },
    {
      "id": "${prefix}Part",
      "filter": "cut",
      "inputs": {
        "base": "${prefix}Blank",
        "tool": "${prefix}Drill"
      }
    }
  ],
  "output": "${prefix}Part"
}
