{
  "id": "pyproj",
  "version": "schemaxis.pyproj/1",
  "adaptor": "schemaxis.adaptors.pyproj.adaptor",
  "declarations": "schemaxis.adaptors.pyproj.adaptor:DECLARATIONS",
  "runtimeFamily": "3.8",
  "execution": "Station an ordered WGS84 route at true ellipsoidal distances with isolated pyproj and an independent standard-library verifier",
  "executables": [
    "python3"
  ],
  "keywords": [
    "pyproj",
    "PROJ",
    "geodesic",
    "chainage",
    "WGS84"
  ],
  "display": {
    "name": "pyproj",
    "mark": "Pj",
    "colour": "#2f6f8f"
  },
  "capabilities": "schemaxis.adaptors.pyproj.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.pyproj/1",
    "operation": "routeStations",
    "source": "/replace/with/waypoints.csv",
    "ellipsoid": "WGS84",
    "coordinateOrder": "lonLat",
    "spacing_m": 1000,
    "closed": false
  },
  "routes": {
    "schemaxis.pyproj/1": {
      "module": "schemaxis.adaptors.pyproj.adaptor",
      "schema": "schemaxis.adaptors.pyproj.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "pyproj",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.pyproj.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.pyproj.adaptor:reusableInputs",
        "retainedInputs": "schemaxis.adaptors.pyproj.adaptor:retainedInputs",
        "resources": "schemaxis.adaptors.pyproj.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--pyproj",
      "dest": "pyproj",
      "help": "Absolute isolated Python interpreter containing qualified pyproj 3.8.0 with PROJ 9.9.0"
    }
  ]
}
