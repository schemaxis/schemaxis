        "lifecycle": {
          "timeout": "One deadline covers Java identification, the analyse stage and the fresh reopen stage; the shared kit watchdog bounds the whole attempt and a final deadline check bounds host verification.",
          "cancellation": "Shared owned-process cancellation with checks before each native stage and before publication; no resident ImageJ process.",
          "logs": "Retain authored/effective plans, the copied input image, fixed Java program, runtime record, java -version output, both stage submissions/stdout/stderr, native readbacks, native and reopened tables, count mask, publications and failure results.",
          "verification": "An independent dependency-free PGM/TIFF decoder and connected-component model (raster order, inclusive threshold, 8/4 connectivity, enclosed-hole fill, bounding-box edge exclusion, whole-pixel size window) predicts every particle. Native ParticleAnalyzer rows, every count-mask label and a fresh-process ImageStatistics re-measurement of each label must match within 1e-12 relative. Native readback confirms ImageJ version, decoded dimensions/depth/plane count, consumed input digest, declared calibration and unit, threshold and analyser options. Publications and evidence are digest-bound and the summary is recomputed."
        },
        "data": [
          {
            "id": "image",
            "direction": "input",
            "kind": "image",
            "format": "PGM (P5) or uncompressed baseline TIFF",
            "traits": {
              "channels": 1,
              "bitDepth": "8 or 16 unsigned",
              "calibration": "declared, not read from file"
            },
            "losses": [
              "File calibration, display range, LUT and metadata are not used; only raw stored intensities."
            ],
            "scope": "One grayscale plane up to 2048 px per side and 1048576 px."
          },
          {
            "id": "particles",
            "direction": "output",
            "kind": "table",
            "format": "numeric CSV",
            "traits": {
              "units": "declared length unit in column names; areas in unit^2; intensities raw",
              "rows": "1-4096 particles in raster order"
            },
            "losses": [
              "Per-particle scalar measurements only; no outlines, perimeter, shape descriptors or pixel lists.",
              "CSV alone omits threshold, connectivity and image provenance; keep the summary."
            ],
            "scope": "Particle label, pixel count, calibrated area, centroid and bounds, raw mean/min/max."
          },
          {
            "id": "summary",
            "direction": "output",
            "kind": "text",
            "format": "JSON",
            "traits": {
              "provenance": "image SHA-256, ImageJ and Java versions",
              "units": "declared"
            },
            "losses": [
              "Totals and fractions describe this image and threshold only; no statistical inference or segmentation-quality claim."
            ],
            "scope": "Calibration and coordinate convention, threshold, connectivity, filters, rejected counts, totals and area fraction."
          }
        ],
        "inspection": [
          {
            "panel": "table",
            "scope": "Inspect per-particle measurements with unit-bearing columns.",
            "limits": "At most 4096 rows; no overlay of outlines on the image."
          },
          {
            "panel": "text",
            "scope": "Review calibration, threshold, connectivity, filters, rejected counts and totals in the summary.",
            "limits": "Bounded JSON; the count mask is retained evidence, not an interactive viewer."
          }
        ],
