{
  "id": "numpy",
  "version": "schemaxis.numpy/1",
  "adaptor": "schemaxis.adaptors.numpy.adaptor",
  "declarations": "schemaxis.adaptors.numpy.adaptor:DECLARATIONS",
  "runtimeFamily": "2.5",
  "execution": "Explain correlated multi-channel numeric measurements with unit-aware, independently verified principal components",
  "executables": [
    "python3"
  ],
  "keywords": [
    "NumPy",
    "principal component analysis",
    "PCA",
    "multichannel measurements"
  ],
  "display": {
    "name": "NumPy",
    "mark": "Np",
    "colour": "#4d77cf"
  },
  "capabilities": "schemaxis.adaptors.numpy.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.numpy/1",
    "operation": "principalComponents",
    "source": "/replace/with/sensors.csv",
    "rowKey": {
      "name": "time",
      "unit": "s"
    },
    "channels": [
      {
        "name": "ch1",
        "unit": "mV"
      },
      {
        "name": "ch2",
        "unit": "mV"
      },
      {
        "name": "ch3",
        "unit": "mV"
      },
      {
        "name": "ch4",
        "unit": "mV"
      }
    ],
    "scaling": "none",
    "retention": {
      "components": 2
    },
    "output": "components"
  },
  "routes": {
    "schemaxis.numpy/1": {
      "module": "schemaxis.adaptors.numpy.adaptor",
      "schema": "schemaxis.adaptors.numpy.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "numpy",
      "acceptedArtifacts": [
        "table"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.numpy.adaptor:query",
        "retainedInputs": "schemaxis.adaptors.numpy.adaptor:retainedInputs",
        "reusableInputs": "schemaxis.adaptors.numpy.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.numpy.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--numpy",
      "dest": "numpy",
      "help": "Absolute isolated Python interpreter containing qualified NumPy 2.5.4 linked to OpenBLAS 0.3.34"
    }
  ]
}
