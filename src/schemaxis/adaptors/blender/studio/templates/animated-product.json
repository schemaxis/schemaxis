{
  "version": "schemaxis.blender/1",
  "nodes": [
    {"id": "paint", "filter": "material"},
    {"id": "box", "filter": "cube", "inputs": {"material": "paint"}, "options": {"size": 2}}
  ],
  "scenes": [{
    "id": "studio", "visible": ["box"], "prepareOnly": true,
    "render": {"samples": 1, "threads": 1},
    "images": [{"id": "preview", "size": [32, 32], "cameras": [{"direction": [1, -2, 1]}]}],
    "production": {
      "frameStart": 1, "frameEnd": 11, "fps": 24, "currentFrame": 6, "units": "metres",
      "collections": [{"id": "product"}],
      "objects": [
        {"id": "motion", "kind": "empty", "collection": "product"},
        {"id": "copy", "kind": "instance", "source": "box", "location": [0, 3, 0], "collection": "product"},
        {"id": "label", "kind": "text", "body": "Product", "size": 0.5, "location": [0, -2, 0], "material": "paint", "collection": "product"},
        {"id": "fill", "kind": "light", "type": "AREA", "energy": 500, "location": [-3, -4, 5], "rotation": [0.5, 0, -0.5], "collection": "product"}
      ],
      "hierarchy": [{"object": "box", "parent": "motion", "keepWorld": false}, {"object": "copy", "parent": "motion", "keepWorld": false}],
      "tracks": [{"object": "motion", "channel": "location", "interpolation": "LINEAR", "keys": [{"frame": 1, "value": [0, 0, 0]}, {"frame": 11, "value": [4, 0, 0]}]}],
      "materialGraphs": [{"id": "ceramic", "nodes": [
        {"id": "checker", "kind": "checker", "values": {"a": [0.05, 0.1, 0.8, 1], "b": [0.9, 0.9, 0.9, 1], "scale": 4}},
        {"id": "surface", "kind": "principled", "values": {"roughness": 0.2}},
        {"id": "finish", "kind": "output"}
      ], "links": [{"from": {"node": "checker", "socket": "colour"}, "to": {"node": "surface", "socket": "colour"}}, {"from": {"node": "surface", "socket": "shader"}, "to": {"node": "finish", "socket": "surface"}}]}],
      "materialBindings": [{"object": "box", "material": "ceramic"}],
      "renderFrames": [1, 6, 11],
      "exports": [{"id": "moving-product", "format": "glb", "objects": ["box", "copy"], "frame": 6}, {"id": "mesh", "format": "obj", "objects": ["box"], "frame": 11}]
    }
  }]
}
