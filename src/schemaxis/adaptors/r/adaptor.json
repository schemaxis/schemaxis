{
  "id": "r",
  "version": "schemaxis.r/1",
  "adaptor": "schemaxis.adaptors.r.adaptor",
  "runtimeFamily": "4.6",
  "execution": "Isolated Rscript: full-rank numeric ordinary least squares with independent QR, optional coefficient inference, optional new-row prediction intervals and sampled fit acceptance",
  "executables": [
    "Rscript"
  ],
  "keywords": [
    "statistics",
    "regression",
    "linear model",
    "prediction",
    "prediction interval",
    "heldout",
    "RDS",
    "CSV"
  ],
  "capabilities": "schemaxis.adaptors.r.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.r/1",
    "operation": "linearRegression",
    "predictors": [
      {
        "name": "temperature",
        "unit": "degC"
      }
    ],
    "response": {
      "name": "reading",
      "unit": "V"
    },
    "training": [
      [
        -2,
        6.1
      ],
      [
        -1,
        7.8
      ],
      [
        1,
        12.2
      ],
      [
        2,
        13.9
      ]
    ],
    "heldout": [
      [
        0,
        10.1
      ],
      [
        3,
        15.8
      ]
    ],
    "requirements": [
      {
        "name": "training_rmse",
        "scope": "training",
        "metric": "rmse",
        "maximum": 0.17
      },
      {
        "name": "heldout_error",
        "scope": "heldout",
        "metric": "maxAbsoluteError",
        "maximum": 0.21
      },
      {
        "name": "calibration_prediction",
        "scope": "heldout",
        "metric": "prediction",
        "sampleIndex": 0,
        "minimum": 9.99,
        "maximum": 10.01
      }
    ]
  },
  "routes": {
    "schemaxis.r/1": {
      "module": "schemaxis.adaptors.r.adaptor",
      "schema": "schemaxis.adaptors.r.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "r",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.r.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.r.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.r.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--r",
      "dest": "r",
      "help": "Absolute qualified Rscript executable"
    }
  ]
}
