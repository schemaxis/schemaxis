{
  "id": "webp",
  "version": "schemaxis.webp/1",
  "adaptor": "schemaxis.adaptors.webp.adaptor",
  "declarations": "schemaxis.adaptors.webp.adaptor:DECLARATIONS",
  "runtimeFamily": "1.6",
  "execution": "Bounded lossless or opaque lossy WebP publication of one captured PNG with fresh native dwebp readback (exact RGBA, or measured RGB error and byte budgets), and decode of one static WebP to a canonical PNG verified against a fresh dwebp decode",
  "executables": [
    "cwebp"
  ],
  "keywords": [
    "WebP",
    "lossless",
    "lossy",
    "image publishing",
    "decode WebP",
    "WebP to PNG"
  ],
  "display": {
    "name": "WebP",
    "mark": "Wp",
    "colour": "#3f7f5f"
  },
  "capabilities": "schemaxis.adaptors.webp.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.webp/1",
    "operation": "encodeLossless",
    "source": "/replace/with/illustration.png"
  },
  "routes": {
    "schemaxis.webp/1": {
      "module": "schemaxis.adaptors.webp.adaptor",
      "schema": "schemaxis.adaptors.webp.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "webp",
      "acceptedArtifacts": [
        "image"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.webp.adaptor:query",
        "resources": "schemaxis.adaptors.webp.adaptor:resources",
        "reusableInputs": "schemaxis.adaptors.webp.adaptor:reusableInputs"
      },
      "runOptions": {
        "decoder": "dwebp"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--webp",
      "dest": "webp",
      "help": "Absolute libwebp 1.6 cwebp executable for run; a WebP run also needs --dwebp"
    },
    {
      "flag": "--dwebp",
      "dest": "dwebp",
      "help": "Absolute libwebp 1.6 dwebp executable for run (the only executable decodeToPng needs); schemaxis verify has no such flag, so use SCHEMAXIS_DWEBP or a stored dwebp location"
    }
  ]
}
