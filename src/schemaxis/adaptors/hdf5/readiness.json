{
 "version": "schemaxis.readiness/1",
 "routes": {
  "schemaxis.hdf5/1": {
   "guide": "docs/hdf5.md",
   "context": {
    "purpose": "Create, inspect, audit, extract, edit, compare and exchange HDF5 scientific data files (typed hierarchical datasets, units, scales, compression, links, virtual/external storage, mesh/field series, SWMR acquisition). parallelWrite adds MPI-IO with a parallel h5py build. Unsuitable for remote S3/HDFS reads or third-party filter plugins.",
    "assumptions": "Isolated Python with exactly h5py 3.16.0 (bundled HDF5 2.0.0) and NumPy 2.5.4; HDF Group h5dump 2.2.0 as independent consumer; absolute local inputs captured into the run; row-major values.",
    "constraints": "256 objects, 4M elements per dataset and 16M in total, 65,536-element attributes, rank 8, one-level compound/vlen bases, 1-D scales, 512 MiB sources; MPI on one local machine only (no multi-node), no ros3, filter plugins or arbitrary code.",
    "inspection": "Inspect hdf5-report.json, inventory/expectations/comparison JSON and extracts; host expectations must equal both the fresh h5py readback and the stdlib-parsed h5dump XML, and verify reruns h5dump on current bytes.",
    "recovery": "Correct located INVALID_HDF5_* faults (path, type, value, selection, storage, dimension, edit, extract), configure --hdf5 and --hdf5-h5dump, retain failed evidence and retry in a fresh directory."
   },
