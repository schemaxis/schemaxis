     "verification/2026-11-05-hdf5-completion.md"
    ],
    "notApplicable": {
     "native-inspection": "No interactive native session; inspectFile publishes a verified inventory and expectation decisions.",
     "mpi": "Scheduler MPI ranks are not used; parallelWrite and extractData with parallel launch the configured mpiexec on localhost only (shared-memory transport, so an inherited scheduler allocation cannot place ranks on other nodes) with a separately built parallel h5py (mpio driver) and reserve one CPU per rank. Qualified only on one local workstation with 2-3 Open MPI 4.1.7 ranks, not on a cluster or with other MPI implementations. Other operations are serial.",
     "time-batches": "No time-list batches; mesh time steps and SWMR batches are declared inside one document.",
     "live-editing": "No persistent native state or reverse editing; edits are ordered declarations on captured copies.",
     "conversion": "No general format converter; CSV/NPY/raw import and CSV/NPY/JSON extraction are named operations with explicit losses."
    }
