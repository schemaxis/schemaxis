     "https://support.hdfgroup.org/documentation/hdf5/latest/",
     "https://www.xdmf.org/index.php/XDMF_Model_and_Format"
    ],
    "lifecycle": {
     "timeout": "Single total deadline across capture, native stages and h5dump (default 300 s, at most 3600 s).",
     "cancellation": "Shared runner cancellation before each stage and a prepublication check.",
     "logs": "Captured inputs/sources/dependencies, authored/plan/native config/payloads/worker/implementation fingerprints, per-stage submissions/stdout/stderr/results and h5dump XML.",
     "verification": "Host expectations from authored intent (generators, rounding, CSV/NPY/raw parsing, selections, edit simulation) compared with a fresh-process h5py readback and HDF Group h5dump 2.2.0 XML parsed by the standard library; verify reruns h5dump on current bytes."
    },
    "data": [
     {
      "id": "hdf5-output",
      "direction": "output",
      "kind": "file",
      "format": "HDF5 (superblock 0/2/3 by libver; sec2/stdio/core/family/split)",
      "traits": {
       "types": "numeric/complex/bool/string/enum/compound/vlen/reference/opaque",
       "units": "units attribute",
       "coordinates": "dimension scales"
      },
      "losses": [
       "No third-party filter plugins or remote drivers; MPI-IO only on one local machine (parallelWrite, parallel extraction); compound/vlen bases one level deep."
      ],
      "scope": "Verified by both consumers."
     },
     {
      "id": "hdf5-source",
      "direction": "input",
      "kind": "file",
      "format": "Existing HDF5 file",
      "traits": {
       "capture": "immutable copy"
      },
      "losses": [
       "Unknown filters, region references and very large datasets are reported or refused rather than reinterpreted."
      ],
      "scope": "inspect/extract/edit/compare sources and dependencies."
     },
     {
      "id": "csv-extract",
      "direction": "output",
      "kind": "table",
      "format": "UTF-8 CSV with quoted header",
      "traits": {
       "header": "name [units]",
       "coordinates": "axis-0 scale column"
      },
      "losses": [
       "No HDF5 type metadata; enum codes as integers; floats as shortest round-trip text."
      ],
      "scope": "extract records in CSV format."
     },
     {
      "id": "npy-json-extract",
      "direction": "output",
      "kind": "file",
      "format": "NPY or JSON arrays",
      "traits": {
       "json": "natural numbers, non-finite as text"
      },
      "losses": [
       "JSON carries a type descriptor but no attributes."
      ],
      "scope": "extract records in npy/json format."
     },
     {
      "id": "xdmf",
      "direction": "output",
      "kind": "file",
      "format": "XDMF 3 XML",
      "traits": {
       "mesh": "unstructured temporal collection"
      },
      "losses": [
       "One HDF5 heavy-data file; cell fields need one cell block."
      ],
      "scope": "writeMeshFields."
     },
     {
      "id": "csv-input",
      "direction": "input",
      "kind": "table",
      "format": "UTF-8 CSV / NPY / raw binary",
      "traits": {
       "header": "required for CSV"
      },
      "losses": [
       "No type inference: the dataset type is declared."
      ],
      "scope": "inputs[] for createFile/editFile/appendSeries."
     }
    ],
    "inspection": [
     {
      "panel": "text",
      "scope": "Inspect hdf5-report.json, inventory.json, expectations.json, comparison.json and extracts.",
      "limits": "No live native file browser."
     }
    ],
    "authoring": {
     "model": "document",
     "example": "sensor-run",
     "reuse": "Every captured byte digest participates in reuse identity; same-path edits invalidate reuse."
    },
    "features": {
     "workflow": {
      "status": "supported",
      "scope": "HDF5 files, CSV tables, NPY/JSON arrays, XDMF descriptions and reports are verified artifacts for scheduled handoffs; HDF5 file artifacts can be consumed as sources, inputs or dependencies."
     },
     "composition": {
      "status": "supported",
      "scope": "Shared references, expressions and finite studies resolve to the same literal HDF5 document contract."
     },
     "reusable-inputs": {
      "status": "supported",
      "scope": "Every captured input, source, reference and dependency byte digest participates in reuse identity."
     },
     "source-authoring": {
      "status": "supported",
      "scope": "Editable typed object, attribute, link, edit, extract and expectation records through common authoring."
     },
     "property-authoring": {
      "status": "supported",
      "scope": "Nested type, data, selection, storage, virtual, dimension and file settings are editable fields."
     },
     "native-save": {
      "status": "supported",
      "scope": "Publish new HDF5 files (createFile, editFile copies, mesh and SWMR series) only after both independent consumers agree."
     },
     "native-inspection": {
      "status": "unsupported",
      "scope": "No interactive native session; inspectFile publishes a verified inventory and expectation decisions."
     },
     "mpi": {
      "status": "unsupported",
      "scope": "Scheduler MPI ranks are not used; parallelWrite and extractData with parallel launch the configured mpiexec on localhost only (shared-memory transport, so an inherited scheduler allocation cannot place ranks on other nodes) with a separately built parallel h5py (mpio driver) and reserve one CPU per rank. Qualified only on one local workstation with 2-3 Open MPI 4.1.7 ranks, not on a cluster or with other MPI implementations. Other operations are serial."
     },
     "time-batches": {
      "status": "unsupported",
      "scope": "No time-list batches; mesh time steps and SWMR batches are declared inside one document."
     },
     "live-editing": {
      "status": "unsupported",
      "scope": "No persistent native state or reverse editing; edits are ordered declarations on captured copies."
     },
     "conversion": {
      "status": "unsupported",
      "scope": "No general format converter; CSV/NPY/raw import and CSV/NPY/JSON extraction are named operations with explicit losses."
     }
    },
