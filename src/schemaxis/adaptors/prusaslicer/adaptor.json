{
  "id": "prusaslicer",
  "version": "schemaxis.prusaslicer/1",
  "adaptor": "schemaxis.adaptors.prusaslicer.adaptor",
  "runtimeFamily": "2.9",
  "display": {
    "name": "PrusaSlicer",
    "mark": "PS",
    "colour": "#c55a11"
  },
  "executables": [
    "prusa-slicer"
  ],
  "execution": "Bounded FFF slicing of one closed STL with an explicit generic Marlin 2 printer, material and print profile; independently replayed G-code layers, envelope, temperatures, filament and native estimates. No printer control.",
  "keywords": [
    "3D printing",
    "FFF",
    "FDM",
    "slicer",
    "G-code",
    "PrusaSlicer"
  ],
  "capabilities": "schemaxis.adaptors.prusaslicer.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.prusaslicer/1",
    "operation": "sliceModel",
    "model": {
      "file": "/replace-with-your-model/part.stl",
      "units": "millimetre"
    },
    "printer": {
      "bedSize_mm": [
        250,
        210
      ],
      "maxPrintHeight_mm": 210,
      "nozzleDiameter_mm": 0.4,
      "gcodeFlavour": "marlin2",
      "maxFeedrate_mm_s": 200,
      "maxAcceleration_mm_s2": 1500
    },
    "material": {
      "type": "PLA",
      "filamentDiameter_mm": 1.75,
      "density_g_cm3": 1.24,
      "nozzleTemperature_C": 210,
      "firstLayerNozzleTemperature_C": 215,
      "bedTemperature_C": 60,
      "firstLayerBedTemperature_C": 65,
      "fanSpeed_percent": 100
    },
    "print": {
      "layerHeight_mm": 0.2,
      "firstLayerHeight_mm": 0.2,
      "extrusionWidth_mm": 0.45,
      "perimeters": 2,
      "topSolidLayers": 4,
      "bottomSolidLayers": 3,
      "infillDensity_percent": 20,
      "infillPattern": "grid",
      "perimeterSpeed_mm_s": 40,
      "infillSpeed_mm_s": 60,
      "firstLayerSpeed_mm_s": 20,
      "travelSpeed_mm_s": 150
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "routes": {
    "schemaxis.prusaslicer/1": {
      "module": "schemaxis.adaptors.prusaslicer.adaptor",
      "schema": "schemaxis.adaptors.prusaslicer.adaptor:schema",
      "schemaName": "prusaslicer",
      "graphEditing": false,
      "workflow": true,
      "scheduled": true,
      "compose": true,
      "timeBatches": false,
      "acceptedArtifacts": [
        "geometry"
      ],
      "hooks": {
        "query": "schemaxis.adaptors.prusaslicer.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.prusaslicer.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.prusaslicer.adaptor:resources"
      }
    }
  },
  "cliOptions": [
    {
      "flag": "--prusaslicer",
      "dest": "prusaslicer",
      "help": "Absolute qualified PrusaSlicer 2.9.6 console executable"
    }
  ]
}
