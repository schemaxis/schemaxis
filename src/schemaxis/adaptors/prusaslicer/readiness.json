          "native-inspection": {
            "status": "unsupported",
            "scope": "Batch console slicing only; no interactive native inspection hook."
          },
          "composition": {
            "status": "supported",
            "scope": "Shared expressions and JSON document references resolve before bounded profile planning."
          },
          "mpi": {
            "status": "unsupported",
            "scope": "Single-process slicing with exactly one native thread."
          },
          "reusable-inputs": {
            "status": "supported",
            "scope": "The STL path and its SHA-256 are complete external input provenance; reuse requires identical bytes."
          },
          "time-batches": {
            "status": "unsupported",
            "scope": "No time-dependent data."
          },
          "source-authoring": {
            "status": "supported",
            "scope": "Shared document drafts, revisions and complete validation."
          },
          "property-authoring": {
            "status": "supported",
            "scope": "Shared JSON pointer edits of model, printer, material, print, placement and requirements with full replanning."
          },
          "live-editing": {
            "status": "unsupported",
            "scope": "Each attempt launches fresh console processes; no persistent PrusaSlicer session."
          },
          "native-save": {
            "status": "unsupported",
            "scope": "The generated config and G-code are ordinary publications; no 3MF project or native-save hook."
          },
          "conversion": {
            "status": "unsupported",
            "scope": "Slicing is the operation itself; no mesh-format conversion, repair or STEP import."
          }
