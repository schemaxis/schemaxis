        "lifecycle": {
          "timeout": "One finite deadline covers the version probe, native model info, slicing, the fresh reload and full independent verification.",
          "cancellation": "Shared process-tree cancellation for each native stage plus a post-verification cancellation gate; failed or cancelled attempts are never reusable.",
          "logs": "Each stage retains its exact command, submission record, stdout and stderr; the STL copy, generated config, G-code and reloaded G-code are retained.",
          "verification": "Independent STL analysis against native --info, full readback of the configuration embedded in the G-code, a pure-Python G-code replay of layers, envelope, setpoints, feedrates, filament arithmetic and kinematic time bounds, and identical fresh-reload G-code."
        },
        "data": [
          {
            "id": "model",
            "direction": "input",
            "kind": "geometry",
            "format": "STL (binary or ASCII)",
            "traits": {
              "units": "declared millimetre or inch",
              "closed": true
            },
            "losses": [
              "Facet normals are ignored; triangle winding defines orientation.",
              "Edge pairing does not detect self-intersections."
            ],
            "scope": "One closed, consistently oriented object; bytes are copied into the attempt and bound by SHA-256."
          },
          {
            "id": "gcode",
            "direction": "output",
            "kind": "text",
            "format": "G-code (Marlin 2 flavour, ASCII)",
            "traits": {
              "units": "mm, mm/min, degC",
              "editable": true
            },
            "losses": [
              "Generic machine model only; not validated for any physical printer, firmware or material."
            ],
            "scope": "Single-extruder planar layers with embedded native configuration and estimates."
          },
          {
            "id": "layers",
            "direction": "output",
            "kind": "table",
            "format": "CSV",
            "traits": {
              "units": "mm, mm/s, degC, percent",
              "numeric": true
            },
            "losses": [
              "Per-layer aggregates; individual moves remain in the G-code."
            ],
            "scope": "One row per replayed extrusion layer with z, path and filament length, envelope, peak feedrate and setpoints."
          },
          {
            "id": "summary",
            "direction": "output",
            "kind": "text",
            "format": "schemaxis.prusaslicer.summary/1",
            "traits": {
              "units": "mm, s, degC, g"
            },
            "losses": [
              "Native estimates are model estimates checked only against kinematic bounds and filament arithmetic."
            ],
            "scope": "Native estimates, independent replay results, requirement margins and explicit losses."
          },
          {
            "id": "config",
            "direction": "output",
            "kind": "text",
            "format": "PrusaSlicer INI",
            "traits": {
              "editable": true
            },
            "losses": [
              "Only the fixed policy keys rendered by Schemaxis; native defaults fill all others and are visible in the G-code block."
            ],
            "scope": "Exact configuration passed to the native slicer."
          }
        ],
        "inspection": [
          {
            "panel": "text",
            "scope": "Inspect the G-code, the generated configuration and the slice summary.",
            "limits": "No toolpath preview; ParaView or native G-code viewers are not invoked."
          },
          {
            "panel": "table",
            "scope": "Inspect per-layer z, extrusion and setpoint aggregates.",
            "limits": "Aggregates only; no per-move or physical deposition model."
          }
        ],
        "authoring": {
          "model": "document",
          "example": "pla-baseline",
          "reuse": "Replace model.file with an absolute STL path, state its units, then edit printer, material and print values with JSON pointers; replan and run a fresh attempt. Pin model.sha256 to refuse changed bytes."
        },
        "features": {
          "workflow": {
            "status": "supported",
            "scope": "G-code, numeric per-layer CSV, summary and generated config are verified publications; the STL digest and exact plan permit scheduler reuse."
