{
  "version": "schemaxis.readiness/1",
  "routes": {
    "schemaxis.prusaslicer/1": {
      "guide": "docs/prusaslicer.md",
      "context": {
        "purpose": "Turn one closed STL part into FFF/FDM G-code with an explicit printer, filament and print profile, and publish independently replayed layer, temperature and filament evidence plus native time/filament estimates. Use it to prepare and compare print settings, not to control a printer.",
        "assumptions": "PrusaSlicer 2.9.6 console; millimetres, mm/s, degC, g/cm3 and seconds; STL coordinates in declared millimetres or inches, triangle winding authoritative. Generic Marlin 2 G-code with homing at the bed origin; the declared feedrate/acceleration limits drive only the native time estimate. Schemaxis renders the complete configuration; no user or vendor presets are loaded.",
        "constraints": "One closed, consistently oriented, non-degenerate STL of at most 16 MiB and 100000 triangles that fits the bed around its placement centre. Layer heights <= 0.8 x nozzle, extrusion width 1-2 nozzle diameters and above every layer height; 100% infill only rectilinear. One thread, one extruder; no supports, brim, skirt, raft, ironing, modifiers, variable layer height, arcs, binary G-code, custom G-code or post-processing. No printer upload, physical print, firmware, material or safety claim.",
        "inspection": "Independently parse the STL (bounds, signed volume, edge pairing) and compare with native --info; read back every written setting from the configuration embedded in the G-code; replay all G-code motion to derive layers, extrusion envelope, per-layer temperature/fan setpoints, feedrate limits, filament length/volume/mass and kinematic time bounds; a fresh native process must regenerate identical G-code from the published embedded configuration.",
        "recovery": "Profile, path, model, digest and fit faults are raised before any native launch with exact locations. Native or replay mismatches retain all logs as VERIFICATION_FAILED. Exceeded named estimate limits fail with PERFORMANCE_NOT_MET and signed margins; adjust the profile or limit and run a fresh attempt."
      },
      "examples": [
        {
          "id": "pla-baseline",
          "reference": "examples/schemaxis/prusaslicer-pla.json"
        },
        {
          "id": "petg-variant",
