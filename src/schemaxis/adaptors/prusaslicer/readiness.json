              ],
              "maxPrintHeight_mm": 210,
              "nozzleDiameter_mm": 0.4,
              "gcodeFlavour": "marlin2",
              "maxFeedrate_mm_s": 200,
              "maxAcceleration_mm_s2": 1500
            },
            "material": {
              "type": "PLA",
              "filamentDiameter_mm": 1.75,
              "density_g_cm3": 1.24,
              "nozzleTemperature_C": 210,
              "firstLayerNozzleTemperature_C": 215,
              "bedTemperature_C": 60,
              "firstLayerBedTemperature_C": 65,
              "fanSpeed_percent": 100
            },
            "print": {
              "layerHeight_mm": 0.36,
              "firstLayerHeight_mm": 0.2,
              "extrusionWidth_mm": 0.45,
              "perimeters": 2,
              "topSolidLayers": 4,
              "bottomSolidLayers": 3,
              "infillDensity_percent": 20,
              "infillPattern": "grid",
              "perimeterSpeed_mm_s": 40,
              "infillSpeed_mm_s": 60,
              "firstLayerSpeed_mm_s": 20,
              "travelSpeed_mm_s": 150
            }
          },
          "expect": "invalid",
          "fault": "INVALID_PROFILE"
        },
