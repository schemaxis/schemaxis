{
  "version": "schemaxis.readiness/1",
  "routes": {
    "schemaxis.godot/1": {
      "guide": "docs/godot.md",
      "context": {
        "purpose": "Create editable Godot projects and scenes from declared primitives, materials, lights, cameras and supported glTF/PNG inputs. Named groups assemble static geometry with local transforms and verified world bounds.",
        "assumptions": "Godot 4.x; metres, explicit transforms and intrinsic YXZ Euler rotation semantics. Resources must remain with the project. Preview rendering needs an available graphics environment.",
        "constraints": "No arbitrary GDScript; only trusted generated project/orbit scripts. Bounded self-contained glTF subset. No live reverse synchronisation or universal material preservation.",
        "inspection": "Inspect fresh-process scene node membership, transforms, bounds, material/light settings and optional decoded PNG preview. Headless case acceptance does not qualify graphical rendering.",
        "recovery": "UNSUPPORTED_UNITS requires metres. Correct missing materials/resources and unsupported glTF features; preserve build/reopen logs. Use headless acceptance when preview graphics are unavailable. SCENE_MALFORMED means the retained scene text is outside the canonical single-line property syntax; preserve it and rerun in a fresh directory. The saved scene hierarchy and placement are checked against the authored plan even when hash manifests agree."
      },
      "examples": [
        {
          "id": "baseline",
          "reference": "examples/schemaxis/godot-admission.json"
        },
