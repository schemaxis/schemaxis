{
  "version": "schemaxis.godot/1",
  "declarations": "schemaxis.adaptors.godot.adaptor:DECLARATIONS",
  "runtimeFamily": "4.x",
  "executables": [
    "godot"
  ],
  "execution": "headless native scene construction and fresh-process reopening; editable project and scene",
  "keywords": [
    "interactive 3D",
    "scenes",
    "game engine",
    "glTF"
  ],
  "executionCapabilities": {
    "modes": [
      "headless"
    ],
    "mpi": false
  },
  "id": "godot",
  "adaptor": "schemaxis.adaptors.godot.adaptor",
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "visualReferences": true,
    "geometryReferences": false,
    "imagePixelReferences": true,
    "imageReferenceRequirement": "a current native PNG preview; no inferred object identity",
    "nativeEditReverseSync": false
  },
  "consoleTemplate": {
    "version": "schemaxis.godot/1",
    "nodes": [],
    "units": "m"
  },
  "saveError": "Godot scenes depend on project resources; use the verified checkpoint project directory",
  "nativeExtension": null,
  "consoleHooks": {
    "validate": "schemaxis.adaptors.godot.console:validate"
  },
  "cliOptions": [
    {
      "flag": "--godot",
      "dest": "godot",
      "help": "Explicit godot executable"
    }
  ],
  "routes": {
    "schemaxis.godot/1": {
      "module": "schemaxis.adaptors.godot.adaptor",
      "workflow": true,
      "scheduled": true,
      "compose": true,
      "graph": false,
      "timeBatches": false,
      "schemaName": "godot",
      "acceptedArtifacts": [
        "gltf",
        "image",
        "spriteSheet"
      ],
      "schema": "schemaxis.adaptors.godot.adaptor:schema",
      "hooks": {
        "reusableInputs": "schemaxis.adaptors.godot.integration:reusableInputs"
      },
      "expand": "plannedNodes",
      "schemaOrder": 5
    }
  },
  "sections": {},
  "capabilities": "schemaxis.adaptors.godot.capabilities:catalogue"
}
