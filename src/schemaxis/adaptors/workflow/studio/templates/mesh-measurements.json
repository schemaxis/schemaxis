{
  "version": "schemaxis.workflow/1",
  "dimensions": {
    "scale": {
      "$fill": "input"
    }
  },
  "operations": [
    {
      "id": "mesh",
      "document": {
        "version": "schemaxis.gmsh/1",
        "units": "mm",
        "nodes": [
          {
            "id": "solid",
            "filter": "box",
            "options": {
              "size": [
                {
                  "$document": "/dimensions/extent"
                },
                10,
                10
              ]
            }
          },
          {
            "id": "mesh",
            "filter": "tetrahedral",
            "inputs": {
              "input": "solid"
            },
            "options": {
              "size": {
                "$document": "/dimensions/h"
              },
              "volumeName": "domain",
              "boundaryName": "boundary",
              "volumeTolerance": 1e-06
            }
          }
        ],
        "output": "mesh",
        "dimensions": {
          "extent": {
            "$analytic": {
              "type": "values",
              "values": [
                10,
                12
              ],
              "sync": "design"
            }
          },
          "h": {
            "$analytic": {
              "type": "values",
              "values": [
                3,
                2
              ],
              "sync": "design"
            }
          }
        }
      }
    },
    {
      "id": "measurements",
      "document": {
        "version": "schemaxis.octave/1",
        "nodes": [
          {
            "id": "samples",
            "filter": "samples",
            "options": {
              "x": [
                0,
                1,
                2
              ],
              "y": [
                {
                  "$value": "mesh",
                  "artifact": 3,
                  "path": "/volume"
                },
                {
                  "$expr": {
                    "op": "multiply",
                    "args": [
                      {
                        "$value": "mesh",
                        "artifact": 3,
                        "path": "/volume"
                      },
                      {
                        "$document": "/dimensions/scale",
                        "scope": "workflow"
                      }
                    ]
                  }
                },
                {
                  "$document": "/dimensions/h",
                  "operation": "mesh"
                }
              ]
            }
          }
        ],
        "outputs": [
          "samples"
        ]
      }
    }
  ]
}
