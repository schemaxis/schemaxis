{
  "version": "schemaxis.workflow/1",
  "operations": [
    {
      "id": "signal",
      "document": {
        "version": "schemaxis.octave/1",
        "nodes": [
          {
            "id": "wave",
            "filter": "wave",
            "options": {
              "count": 128,
              "step": 0.0078125,
              "frequency": {
                "$fill": "input"
              },
              "amplitude": 2
            }
          },
          {
            "id": "spectrum",
            "filter": "fft",
            "inputs": {
              "input": "wave"
            }
          }
        ],
        "outputs": [
          "wave",
          "spectrum"
        ]
      }
    },
    {
      "id": "workbook",
      "document": {
        "version": "schemaxis.calc/1",
        "nodes": [
          {
            "id": "spectrum",
            "filter": "readCSV",
            "options": {
              "file": {
                "$artifact": "signal",
                "index": 1
              }
            }
          }
        ]
      }
    },
    {
      "id": "readback",
      "document": {
        "version": "schemaxis.octave/1",
        "nodes": [
          {
            "id": "spectrum",
            "filter": "readCSV",
            "options": {
              "file": {
                "$artifact": "workbook",
                "index": 2
              }
            }
          }
        ],
        "outputs": [
          "spectrum"
        ]
      }
    }
  ]
}
