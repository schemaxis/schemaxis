{
  "id": "imagemagick",
  "version": "schemaxis.imagemagick/1",
  "adaptor": "schemaxis.adaptors.imagemagick.adaptor",
  "runtimeFamily": "7.1",
  "execution": "Isolated ImageMagick 7: exact PNG crop, integer magnification, quarter turns, explicit alpha and indexed contact sheets",
  "executables": [
    "magick"
  ],
  "keywords": [
    "PNG",
    "raster",
    "contact sheet"
  ],
  "display": {
    "name": "ImageMagick",
    "mark": "IM",
    "colour": "#486a87"
  },
  "capabilities": "schemaxis.adaptors.imagemagick.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.imagemagick/1",
    "operation": "raster",
    "images": [
      {
        "id": "detail",
        "source": "/replace/with/grid.png",
        "crop": {
          "x": 0,
          "y": 0,
          "width": 2,
          "height": 2
        },
        "scale": 2,
        "quarterTurns": 0
      }
    ],
    "colourPolicy": "require-srgb",
    "alpha": "preserve"
  },
  "routes": {
    "schemaxis.imagemagick/1": {
      "module": "schemaxis.adaptors.imagemagick.adaptor",
      "schema": "schemaxis.adaptors.imagemagick.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "imagemagick",
      "acceptedArtifacts": [
        "image"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.imagemagick.adaptor:query",
        "resources": "schemaxis.adaptors.imagemagick.adaptor:resources",
        "reusableInputs": "schemaxis.adaptors.imagemagick.adaptor:reusableInputs"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--imagemagick",
      "dest": "imagemagick",
      "help": "Absolute ImageMagick 7 magick executable"
    }
  ],
  "declarations": "schemaxis.adaptors.imagemagick.adaptor:DECLARATIONS"
}
