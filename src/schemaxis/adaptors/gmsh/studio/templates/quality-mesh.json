{
  "version": "schemaxis.gmsh/1",
  "units": "mm",
  "nodes": [
    {
      "id": "solid",
      "filter": "box",
      "options": {
        "size": [
          10,
          10,
          10
        ]
      }
    },
    {
      "id": "mesh",
      "filter": "tetrahedral",
      "inputs": {
        "input": "solid"
      },
      "options": {
        "size": 3,
        "volumeName": "domain",
        "boundaryName": "boundary",
        "volumeTolerance": 1e-06
      }
    }
  ],
  "output": "mesh",
  "refinement": {
    "maxIterations": 4,
    "reductionFactor": 0.7,
    "minimumSize": 1,
    "maxTetrahedra": 20000,
    "requirements": {
      "maximumEdgeLength": {
        "$fill": "edge"
      },
      "minimumMeanRatio": 0.1
    }
  }
}
