      "acceptedArtifacts": [
        "video"
      ],
      "hooks": {
        "reusableInputs": "schemaxis.adaptors.shotcut.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.shotcut.adaptor:resources",
        "provisionalResources": "schemaxis.adaptors.shotcut.adaptor:provisionalResources"
      }
    }
  },
  "capabilities": "schemaxis.adaptors.shotcut.capabilities:catalogue",
  "studioCatalogue": "schemaxis.adaptors.shotcut.adaptor:studioCatalogue"
