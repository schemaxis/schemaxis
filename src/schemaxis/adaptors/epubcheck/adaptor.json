{
  "id": "epubcheck",
  "version": "schemaxis.epubcheck/1",
  "adaptor": "schemaxis.adaptors.epubcheck.adaptor",
  "declarations": "schemaxis.adaptors.epubcheck.adaptor:DECLARATIONS",
  "runtimeFamily": "5.4",
  "execution": "Bounded EPUBCheck standards check of one local EPUB with zero tolerated fatal, error and warning findings, proven by a fresh trusted native check of the held captured bytes",
  "executables": [
    "epubcheck"
  ],
  "keywords": [
    "EPUBCheck",
    "EPUB validation",
    "EPUB conformance",
    "W3C EPUB"
  ],
  "display": {
    "name": "EPUBCheck",
    "mark": "Ep",
    "colour": "#7a4f9a"
  },
  "capabilities": "schemaxis.adaptors.epubcheck.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.epubcheck/1",
    "operation": "validate",
    "source": "/replace/with/publication.epub"
  },
  "routes": {
    "schemaxis.epubcheck/1": {
      "module": "schemaxis.adaptors.epubcheck.adaptor",
      "schema": "schemaxis.adaptors.epubcheck.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "epubcheck",
      "acceptedArtifacts": [
        "file"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.epubcheck.adaptor:query",
        "resources": "schemaxis.adaptors.epubcheck.adaptor:resources",
        "reusableInputs": "schemaxis.adaptors.epubcheck.adaptor:reusableInputs"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--epubcheck",
      "dest": "epubcheck",
      "help": "Absolute trusted EPUBCheck 5.4 launcher (a fixed executable starting the official JAR, its lib directory and Java) for run, which also uses it for the fresh verification check; schemaxis verify has no such flag, so use SCHEMAXIS_EPUBCHECK or a stored epubcheck location"
    }
  ]
}
