{
  "id": "infozip",
  "version": "schemaxis.infozip/1",
  "adaptor": "schemaxis.adaptors.infozip.adaptor",
  "declarations": "schemaxis.adaptors.infozip.adaptor:DECLARATIONS",
  "runtimeFamily": "3.0",
  "execution": "Bounded stored-ZIP publication bundle of one to sixteen individually selected files under safe flat names plus a host inventory, produced by Info-ZIP zip and verified byte for byte by an independent host archive reader",
  "executables": [
    "infozip"
  ],
  "keywords": [
    "Info-ZIP",
    "ZIP",
    "publication bundle",
    "zip archive"
  ],
  "display": {
    "name": "Info-ZIP",
    "mark": "Zp",
    "colour": "#7a5c2e"
  },
  "capabilities": "schemaxis.adaptors.infozip.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.infozip/1",
    "operation": "bundle",
    "files": [
      {
        "name": "report.txt",
        "source": "/replace/with/report.txt"
      }
    ]
  },
  "routes": {
    "schemaxis.infozip/1": {
      "module": "schemaxis.adaptors.infozip.adaptor",
      "schema": "schemaxis.adaptors.infozip.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "infozip",
      "acceptedArtifacts": [
        "file",
        "text",
        "image"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.infozip.adaptor:query",
        "resources": "schemaxis.adaptors.infozip.adaptor:resources",
        "reusableInputs": "schemaxis.adaptors.infozip.adaptor:reusableInputs"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--infozip",
      "dest": "infozip",
      "help": "Absolute Info-ZIP Zip 3.0 zip executable for run; verification needs no native program"
    }
  ]
}
