{
  "id": "paraview.slice_export",
  "contractVersion": "schemaxis.capability/0.1",
  "provider": "paraview",
  "kind": "action",
  "summary": "Slice a Wavelet or decomposed OpenFOAM case with reused geometry and verified publications",
  "inputs": {},
  "upstream": {
    "application": "ParaView",
    "reviewedVersion": "5.13.3",
    "metadata": "native/slice-5.13.3.json",
    "notice": "native/ParaView-Copyright.txt"
  },
  "nativeProperties": {
    "Crinkleslice": {
      "status": "supported",
      "argument": "crinkle"
    },
    "Triangulatetheslice": {
      "status": "supported",
      "argument": "triangulate"
    },
    "PointMergeMethod": {
      "status": "supported",
      "argument": "pointMergeMethod",
      "limitation": "locator sub-properties are not configurable yet"
    },
    "Input": {
      "status": "managed",
      "reason": "the capability supplies a Wavelet or a decomposed OpenFOAM case"
    },
    "InputBounds": {
      "status": "information",
      "reason": "native read-only data-dependent information"
    },
    "SliceType": {
      "status": "restricted",
      "reason": "Plane only; origin and normal are configurable"
    },
    "SliceOffsetValues": {
      "status": "unsupported",
      "reason": "multiple simultaneous offsets need multi-plane verification"
    },
    "HyperTreeGridSlicer": {
      "status": "unsupported",
      "reason": "synthetic input is not a hyper tree grid"
    },
    "UseDual": {
      "status": "unsupported",
      "reason": "requires hyper tree grid input and dedicated verification"
    }
  },
  "arguments": {
    "case": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "required": true
        },
        "geometryOrder": {
          "type": "enum",
          "values": [
            "positionFastest"
          ],
          "default": "positionFastest"
        },
        "times": {
          "type": "union",
          "title": "time selection",
          "summary": "Which stored times to process",
          "options": [
            {
              "type": "enum",
              "title": "'latest' or 'first'",
              "values": [
                "latest",
                "first"
              ]
            },
            {
              "type": "object",
              "title": "time selection object",
              "properties": {
                "latest": {
                  "type": "integer",
                  "minimum": 1,
                  "summary": "The last n stored times"
                },
                "first": {
                  "type": "integer",
                  "minimum": 1,
                  "summary": "The first n stored times"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1,
                  "summary": "Nearest stored time to each value"
                },
                "valueRange": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "summary": "Every stored time within an inclusive range of values"
                },
                "indices": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 1,
                  "summary": "Stored times by position"
                },
                "indexRange": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "summary": "Every stored time within an inclusive range of positions"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0,
                  "summary": "Largest accepted difference between a requested and a stored value"
                }
              }
            }
          ],
          "default": "latest"
        },
        "fractions": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "default": [
            0.25,
            0.5,
            0.75
          ],
          "summary": "Positions along the bounds projection onto normal; 0=min, 1=max"
        },
        "requiredFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "default": [
            "U",
            "p"
          ]
        },
        "appearances": {
          "type": "array",
          "items": {
            "type": "enum",
            "values": [
              "p",
              "Umag"
            ]
          },
          "minItems": 1,
          "default": [
            "p",
            "Umag"
          ]
        },
        "writers": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "required": true
              },
              "size": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 32,
                  "maximum": 4096
                },
                "minItems": 2,
                "maxItems": 2,
                "default": [
                  640,
                  480
                ]
              },
              "cameras": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "direction": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3,
                      "required": true
                    },
                    "up": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3,
                      "default": [
                        0,
                        0,
                        1
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "maxPublications": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 1000
        }
      }
    },
    "crinkle": {
      "type": "boolean",
      "default": false,
      "summary": "Keep whole intersected cells; exports VTU instead of a planar VTP surface"
    },
    "triangulate": {
      "type": "boolean",
      "default": true,
      "summary": "Produce triangles for a cut surface; does not apply to crinkle slicing"
    },
    "pointMergeMethod": {
      "type": "enum",
      "default": "uniformBinning",
      "values": [
        "uniformBinning",
        "octreeBinning",
        "none"
      ],
      "summary": "Method for merging coincident cut-surface points; does not apply to crinkle slicing"
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        0.0,
        0.0,
        0.0
      ],
      "summary": "A point on the slicing plane"
    },
    "normal": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        1.0,
        0.0,
        0.0
      ],
      "summary": "Nonzero plane normal; normalised with the effective value reported"
    },
    "sweep": {
      "type": "object",
      "title": "Linear series",
      "summary": "Signed offsets from origin along the unit normal; declare a complete series (bounds are not inferred)",
      "properties": {
        "start": {
          "type": "number",
          "summary": "First position; defaults to the padded lower bound"
        },
        "end": {
          "type": "number",
          "summary": "Last position; defaults to the padded upper bound"
        },
        "spacing": {
          "type": "number",
          "summary": "Distance between consecutive positions"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "summary": "Number of positions"
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "summary": "Absolute inset applied to bounds-derived ends only"
        },
        "paddingFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "summary": "Inset as a fraction of the bounds extent, applied to bounds-derived ends only"
        }
      }
    },
    "maxSlices": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 1000,
      "summary": "Maximum sweep positions, checked before expansion and execution"
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1,
      "required": true,
      "summary": "New output directory; its parent must exist; existing paths are refused"
    },
    "timeout": {
      "type": "number",
      "minimum": 1,
      "default": 120.0,
      "summary": "Maximum execution time in seconds"
    }
  },
  "outputs": {},
  "effects": [
    "starts ParaView",
    "creates output directory",
    "writes geometry, replay and verification"
  ],
  "faults": [
    "OUTPUT_EXISTS",
    "INVALID_OUTPUT_PATH",
    "INVALID_NORMAL",
    "EMPTY_GEOMETRY",
    "DATA_NOT_READY",
    "VERIFICATION_FAILED",
    "DECLARATION_MISMATCH",
    "UNSUPPORTED_NATIVE_OPTION",
    "INTERPRETER_NOT_FOUND",
    "INTERPRETER_UNUSABLE",
    "RUNNER_FAILED",
    "RUNNER_TIMED_OUT",
    "EXPANSION_TOO_LARGE",
    "UNDER_SPECIFIED_SERIES",
    "OVER_SPECIFIED_SERIES",
    "INCONSISTENT_SERIES",
    "INVALID_SLICE_POSITION",
    "MISSING_FIELD",
    "INVALID_CASE",
    "INVALID_CAMERA",
    "INVALID_CASE_OPTIONS",
    "TIME_OUT_OF_TOLERANCE"
  ]
}
