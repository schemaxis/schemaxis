{
  "version": "schemaxis/1",
  "definitions": {
    "data": {
      "$expr": "extents(source)"
    }
  },
  "nodes": [
    {
      "id": "source",
      "filter": "wavelet"
    },
    {
      "id": "cut",
      "filter": "slice",
      "options": {
        "normal": "x+",
        "origin": {
          "$expr": "vector(data.min.x + fraction * data.deltaX, data.mid.y, data.mid.z)"
        }
      },
      "inputs": {
        "input": "source"
      }
    },
    {
      "id": "outline",
      "filter": "outline",
      "inputs": {
        "input": "source"
      }
    }
  ],
  "scenes": [
    {
      "id": "sliceSweep",
      "visible": {
        "cut": {
          "field": [
            "POINTS",
            "RTData"
          ],
          "range": [
            0,
            300
          ]
        },
        "outline": {
          "colour": "black"
        }
      },
      "geometry": [
        "cut",
        "outline"
      ],
      "images": [
        {
          "id": "overview",
          "size": [
            640,
            480
          ],
          "cameras": [
            {
              "direction": [
                1,
                -1,
                0.6
              ]
            }
          ]
        }
      ]
    }
  ],
  "sweeps": [
    {
      "name": "fraction",
      "series": {
        "start": 0.1,
        "end": 0.9,
        "count": {
          "$fill": "count"
        }
      }
    }
  ]
}
