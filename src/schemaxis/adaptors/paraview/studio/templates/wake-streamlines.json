        "context"
      ],
      "images": [
        {
          "id": "overview",
          "size": [
            640,
            480
          ],
          "cameras": [
            {
              "direction": [
                1,
                -1,
                0.6
              ]
            }
          ]
        }
      ]
    }
  ]
