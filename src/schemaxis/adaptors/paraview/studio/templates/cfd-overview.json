{
  "version": "schemaxis/1",
  "nodes": [
    {
      "id": "case",
      "filter": "foam",
      "options": {
        "file": {
          "$fill": "file"
        },
        "caseType": "Reconstructed Case",
        "cellArrays": [
          "U",
          "p"
        ]
      }
    },
    {
      "id": "mesh",
      "filter": "merge",
      "inputs": {
        "input": "case"
      }
    },
    {
      "id": "flow",
      "filter": "cellToPoint",
      "options": {
        "passCellData": true
      },
      "inputs": {
        "input": "mesh"
      }
    },
    {
      "id": "speed",
      "filter": "calculator",
      "options": {
        "expression": "mag(U)",
        "result": "speed"
      },
      "inputs": {
        "input": "flow"
      }
    },
    {
      "id": "cutX",
      "filter": "slice",
      "options": {
        "normal": "x+",
        "origin": [
          {
            "$calc": "add",
            "args": [
              {
                "$observe": "speed",
                "path": [
                  "bounds",
                  0
                ]
              },
              {
                "$calc": "multiply",
                "args": [
                  {
                    "$axis": "fraction"
                  },
                  {
                    "$calc": "subtract",
                    "args": [
                      {
                        "$observe": "speed",
                        "path": [
                          "bounds",
                          1
                        ]
                      },
                      {
                        "$observe": "speed",
                        "path": [
                          "bounds",
                          0
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "$calc": "divide",
            "args": [
              {
                "$calc": "add",
                "args": [
                  {
                    "$observe": "speed",
                    "path": [
                      "bounds",
                      2
                    ]
                  },
                  {
                    "$observe": "speed",
                    "path": [
                      "bounds",
                      3
                    ]
                  }
                ]
              },
              2
            ]
          },
          {
            "$calc": "divide",
            "args": [
              {
                "$calc": "add",
                "args": [
                  {
                    "$observe": "speed",
                    "path": [
                      "bounds",
                      4
                    ]
                  },
                  {
                    "$observe": "speed",
                    "path": [
                      "bounds",
                      5
                    ]
                  }
                ]
              },
              2
            ]
          }
        ]
      },
      "inputs": {
        "input": "speed"
      }
    },
