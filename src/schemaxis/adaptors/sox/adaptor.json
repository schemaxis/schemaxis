{
  "id": "sox",
  "version": "schemaxis.sox/1",
  "adaptor": "schemaxis.adaptors.sox.adaptor",
  "declarations": "schemaxis.adaptors.sox.adaptor:DECLARATIONS",
  "runtimeFamily": "14.4.2",
  "execution": "Sample-frame PCM16 edit decisions (trim, linear gain/fades, ordered concatenation), speech conform (explicit channel policy, resampling to PCM16 mono 16 kHz) peak headroom normalise (measured exact gain to an explicit targetPeak under a maxGain ceiling) and a two-track narration/background mix (explicit gains, sample-frame placements, explicit duration policy, clipping refused) with independent verification",
  "executables": [
    "sox"
  ],
  "keywords": [
    "PCM WAV",
    "speech conform",
    "resample to 16 kHz",
    "mono 16000 Hz WAV",
    "peak headroom",
    "peak normalise",
    "mix narration with background",
    "two-track audio mix",
    "background music under narration",
    "voiceover over a music bed",
    "overlay audio"
  ],
  "display": {
    "name": "SoX",
    "mark": "Sx",
    "colour": "#3b806b"
  },
  "capabilities": "schemaxis.adaptors.sox.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.sox/1",
    "operation": "assemble",
    "clips": [
      {
        "source": "/replace/with/ramp.wav",
        "startFrame": 17,
        "frameCount": 1024,
        "gain": 0.75,
        "fadeInFrames": 64,
        "fadeOutFrames": 128
      },
      {
        "source": "/replace/with/ramp.wav",
        "startFrame": 2048,
        "frameCount": 512,
        "gain": 0.5,
        "fadeInFrames": 0,
        "fadeOutFrames": 32
      }
    ]
  },
  "routes": {
    "schemaxis.sox/1": {
      "module": "schemaxis.adaptors.sox.adaptor",
      "schema": "schemaxis.adaptors.sox.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "sox",
      "acceptedArtifacts": [
        "file"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.sox.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.sox.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.sox.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--sox",
      "dest": "sox",
      "help": "Absolute SoX 14.4.2 executable"
    }
  ]
}
