      {
        "name": "orders",
        "columns": [
          {"name": "id", "type": "number", "precision": 10, "scale": 0},
          {"name": "customer_id", "type": "number", "precision": 10, "scale": 0, "nullable": true},
          {"name": "total", "type": "number", "precision": 12, "scale": 2, "nullable": true}
        ],
        "primaryKey": ["id"],
        "foreignKeys": [{"columns": ["customer_id"], "table": "customers", "references": ["id"]}],
        "source": {"path": "/replace/with/orders.json"}
