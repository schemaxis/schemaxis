{
  "id": "mupdf",
  "version": "schemaxis.mupdf/1",
  "adaptor": "schemaxis.adaptors.mupdf.adaptor",
  "declarations": "schemaxis.adaptors.mupdf.adaptor:DECLARATIONS",
  "runtimeFamily": "1.28",
  "execution": "Isolated passive PDF page review with captured bytes, PNG rendering, UTF-8 extraction and source readback",
  "executables": [
    "mutool"
  ],
  "keywords": [
    "PDF",
    "page review",
    "raster",
    "MuPDF"
  ],
  "display": {
    "name": "MuPDF",
    "mark": "Mu",
    "colour": "#355b8c"
  },
  "capabilities": "schemaxis.adaptors.mupdf.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.mupdf/1",
    "operation": "review",
    "source": "/replace/with/review.pdf",
    "pages": [
      2,
      1,
      3
    ],
    "dpi": 72,
    "rotation": 0
  },
  "routes": {
    "schemaxis.mupdf/1": {
      "module": "schemaxis.adaptors.mupdf.adaptor",
      "schema": "schemaxis.adaptors.mupdf.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "mupdf",
      "acceptedArtifacts": ["pdf"],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.mupdf.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.mupdf.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.mupdf.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--mupdf",
      "dest": "mupdf",
      "help": "Absolute MuPDF 1.28.5 mutool executable (POSIX resource caps)"
    }
  ]
}
