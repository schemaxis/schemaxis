{
  "version": "schemaxis.studio-adaptor/2",
  "baseDocument": {
    "version": "schemaxis.ffmpeg/1",
    "nodes": [
      {
        "id": "video",
        "filter": "encodeFrames",
        "options": {
          "files": [
            "/data/frame-0001.png",
            "/data/frame-0002.png"
          ],
          "fps": 25,
          "codec": "h264",
          "threads": 1
        }
      }
    ]
  },
  "categories": [
    {
      "id": "encoding",
      "title": "Video encoding",
      "icon": "layers"
    },
    {
      "id": "sources",
      "title": "Images & existing video",
      "icon": "layers"
    },
    {
      "id": "review",
      "title": "Review movie",
      "icon": "layers"
    },
    {
      "id": "audio",
      "title": "Audio extraction",
      "icon": "layers"
    }
  ],
  "snippets": [
    {
      "id": "encode-frames",
      "title": "Encode ordered frame files",
      "category": "sources",
      "icon": "layers",
      "description": "Replace the video source with an explicit ordered PNG frame list.",
      "fields": {
        "files": {
          "label": "Ordered PNG files",
          "type": "json",
          "required": true,
          "default": [
            "/data/frame-0001.png",
            "/data/frame-0002.png"
          ]
        }
      },
      "inserts": [
        {
          "at": "",
          "values": [
            {
              "version": "schemaxis.ffmpeg/1",
              "nodes": [
                {
                  "id": "video",
                  "filter": "encodeFrames",
                  "options": {
                    "files": {
                      "$fill": "files"
                    },
                    "fps": 25,
                    "codec": "h264",
                    "threads": 1
                  }
                }
              ]
            }
          ]
        }
      ],
      "complexity": "composite",
      "requires": "Requires same-sized PNG frames at the supplied absolute paths; no audio is authored."
    },
    {
      "id": "encode-sheet",
      "title": "Encode an Aseprite sprite sheet",
      "category": "sources",
      "icon": "layers",
      "description": "Read the image and captured Aseprite JSON metadata to reconstruct frame timing.",
      "fields": {
        "sheet": {
          "label": "Sprite sheet image",
          "type": "path",
          "required": true,
          "default": "/data/sheet.png",
          "extensions": [
            "png"
          ]
        },
        "metadata": {
          "label": "Aseprite metadata",
          "type": "path",
          "required": true,
          "default": "/data/sheet.json",
          "extensions": [
            "json"
          ]
        }
      },
      "inserts": [
        {
          "at": "",
          "values": [
            {
              "version": "schemaxis.ffmpeg/1",
              "nodes": [
                {
                  "id": "video",
                  "filter": "encodeSheet",
                  "options": {
                    "file": {
                      "$fill": "sheet"
                    },
                    "metadata": {
                      "$fill": "metadata"
                    },
                    "fps": 25,
                    "codec": "ffv1",
                    "threads": 1
                  }
                }
              ]
            }
          ]
        }
      ],
      "complexity": "composite",
      "requires": "Requires matching Aseprite sprite-sheet PNG and JSON files at run time."
    },
    {
      "id": "codec",
      "title": "Delivery or lossless codec",
      "category": "encoding",
      "icon": "layers",
      "description": "Choose H.264 delivery (MP4) or FFV1 lossless RGB publication (MKV). Alpha is composited on black.",
      "fields": {
        "codec": {
          "label": "Delivery or lossless codec",
          "type": "enum",
          "required": true,
          "default": "ffv1",
          "values": [
            "h264",
            "ffv1"
          ]
        }
      },
      "inserts": [
        {
          "at": "/nodes/0/options/codec",
          "values": [
            {
              "$fill": "codec"
            }
          ]
        }
      ]
    },
    {
      "id": "frame-rate",
      "title": "Constant playback frame rate",
      "category": "encoding",
      "icon": "layers",
      "description": "Set the integer frame rate used by the declared video publication.",
      "fields": {
        "frame-rate": {
          "label": "Constant playback frame rate",
          "type": "integer",
          "required": true,
          "default": 25,
          "minimum": 1,
          "maximum": 120
        }
      },
      "inserts": [
        {
          "at": "/nodes/0/options/fps",
          "values": [
            {
              "$fill": "frame-rate"
            }
          ]
        }
      ]
    },
    {
      "id": "encoder-threads",
      "title": "Bound encoder threads",
      "category": "encoding",
      "icon": "layers",
      "description": "Declare the native encoder thread budget explicitly.",
      "fields": {
        "encoder-threads": {
          "label": "Bound encoder threads",
          "type": "integer",
          "required": true,
          "default": 2,
          "minimum": 1,
          "maximum": 16
        }
      },
      "inserts": [
        {
          "at": "/nodes/0/options/threads",
          "values": [
            {
              "$fill": "encoder-threads"
            }
          ]
        }
      ]
    },
    {
      "id": "hold-frame",
      "title": "Append a held final frame",
      "category": "sources",
      "icon": "layers",
      "description": "Repeat one final PNG once to extend its display by one frame interval.",
      "fields": {
        "hold-frame": {
          "label": "Append a held final frame",
          "type": "path",
          "required": true,
          "default": "/data/frame-0002.png",
          "extensions": [
            "png"
          ]
        }
      },
      "inserts": [
        {
          "at": "/nodes/0/options/files/-",
          "values": [
            {
              "$fill": "hold-frame"
            }
          ]
        }
      ],
      "requires": "Requires the PNG frame at its declared absolute path."
    },
    {
      "id": "trim-video",
      "title": "Trim an existing video",
      "category": "sources",
      "icon": "layers",
      "description": "Replace source with a bounded presentation-frame range; output fps retimes without dropping frames.",
      "fields": {
        "file": {
          "label": "Source video",
          "type": "path",
          "required": true,
          "default": "/data/source.mkv",
          "extensions": [
            "mkv",
            "mp4"
          ]
        },
        "start": {
          "label": "First frame index (inclusive)",
          "type": "integer",
          "required": true,
          "default": 1,
          "minimum": 0,
          "maximum": 599
        },
        "end": {
          "label": "End frame index (exclusive)",
          "type": "integer",
          "required": true,
          "default": 4,
          "minimum": 1,
          "maximum": 600
        }
      },
      "inserts": [
        {
          "at": "",
          "values": [
            {
              "version": "schemaxis.ffmpeg/1",
              "nodes": [
                {
                  "id": "clip",
                  "filter": "encodeVideo",
                  "options": {
                    "file": {
                      "$fill": "file"
                    },
                    "startFrame": {
                      "$fill": "start"
                    },
                    "endFrame": {
                      "$fill": "end"
                    },
                    "fps": 12,
                    "codec": "ffv1",
                    "threads": 1
                  }
                }
              ]
            }
          ]
        }
      ],
      "complexity": "composite",
      "requires": "Supported silent video with uniform integer-rate presentation timestamps."
    },
    {
      "id": "add-review-movie",
      "title": "Review movie with audio and captions",
      "category": "review",
      "icon": "layers",
      "description": "Replace the document with a muxReview publication: silent FFV1 Matroska video, PCM16 WAV and strict SRT in one verified three-stream Matroska file. Captions stay a declared machine draft.",
      "fields": {
        "video": {
          "label": "Silent FFV1 video",
          "type": "path",
          "required": true,
          "default": "/data/silent.mkv",
          "extensions": [
            "mkv"
          ]
        },
        "audio": {
          "label": "Speech WAV (PCM16)",
          "type": "path",
          "required": true,
          "default": "/data/speech.wav",
          "extensions": [
            "wav"
          ]
        },
        "captions": {
          "label": "Captions (SRT)",
          "type": "path",
          "required": true,
          "default": "/data/captions.srt",
          "extensions": [
            "srt"
          ]
        }
      },
      "inserts": [
        {
          "at": "",
          "values": [
            {
              "version": "schemaxis.ffmpeg/1",
              "nodes": [
                {
                  "id": "review",
                  "filter": "muxReview",
                  "options": {
                    "video": {
                      "$fill": "video"
                    },
                    "audio": {
                      "$fill": "audio"
                    },
                    "captions": {
                      "$fill": "captions"
                    },
                    "captionStatus": "machineDraft",
                    "threads": 1
                  }
                }
              ]
            }
          ]
        }
      ],
      "complexity": "composite",
      "requires": "A silent single-stream Matroska/FFV1 bgr0 video, canonical PCM16 WAV within one video frame of its duration, and plain-text SRT inside the video."
    },
    {
      "id": "add-extract-audio",
      "title": "Extract audio from an MP4/M4A recording",
      "category": "audio",
      "icon": "layers",
      "description": "Replace the document with an extractAudio publication: one AAC-LC audio stream decoded to a verified canonical PCM16 WAV at the recording's own rate. AAC is lossy and the result is a machine draft.",
      "fields": {
        "file": {
          "label": "AAC recording (MP4 or M4A)",
          "type": "path",
          "required": true,
          "default": "/data/voice-note.m4a",
          "extensions": [
            "m4a",
            "mp4"
          ]
        },
        "streamIndex": {
          "label": "Audio stream index (global)",
          "type": "integer",
          "required": true,
          "default": 0,
          "minimum": 0,
          "maximum": 15
        }
      },
      "inserts": [
        {
          "at": "",
          "values": [
            {
              "version": "schemaxis.ffmpeg/1",
              "nodes": [
                {
                  "id": "speech",
                  "filter": "extractAudio",
                  "options": {
                    "file": {
                      "$fill": "file"
                    },
                    "streamIndex": {
                      "$fill": "streamIndex"
                    },
                    "threads": 1
                  }
                }
              ]
            }
          ]
        }
      ],
      "complexity": "composite",
      "requires": "One local MP4/M4A with a single AAC-LC mono or stereo audio stream (8-96 kHz, up to 600 s and 64 MiB) and at most one H.264 video stream; the audio stream's global index."
    },
    {
      "id": "add-encode-audio",
      "title": "Publish a prepared WAV as AAC/M4A",
      "category": "audio",
      "icon": "layers",
      "description": "Replace the document with an encodeAudio publication: a prepared PCM16 WAV encoded to AAC-LC/M4A and verified by a fresh native decode against a byte budget and an exact mean waveform error budget. AAC is lossy; the budget is not a listening-quality measure.",
      "fields": {
        "file": {
          "label": "Prepared PCM16 WAV",
          "type": "path",
          "required": true,
          "default": "/data/prepared-narration.wav",
          "extensions": [
            "wav"
          ]
        },
        "bitrateKbps": {
          "label": "AAC target bitrate (kbit/s)",
          "type": "enum",
          "required": true,
          "default": 96,
          "values": [
            64,
            96,
            128,
            192
          ]
        },
        "maxBytes": {
          "label": "Maximum file size (bytes)",
          "type": "integer",
          "required": true,
          "default": 8388608,
          "minimum": 1,
          "maximum": 33554432
        },
        "maxMeanPCMError": {
          "label": "Maximum mean sample error (PCM16 units)",
          "type": "number",
          "required": true,
          "default": 2000,
          "minimum": 0,
          "maximum": 65535
        }
      },
      "inserts": [
        {
          "at": "",
          "values": [
            {
              "version": "schemaxis.ffmpeg/1",
              "nodes": [
                {
                  "id": "shareable",
                  "filter": "encodeAudio",
                  "options": {
                    "file": {
                      "$fill": "file"
                    },
                    "bitrateKbps": {
                      "$fill": "bitrateKbps"
                    },
                    "maxBytes": {
                      "$fill": "maxBytes"
                    },
                    "maxMeanPCMError": {
                      "$fill": "maxMeanPCMError"
                    },
                    "threads": 1
                  }
                }
              ]
            }
          ]
        }
      ],
      "complexity": "composite",
      "requires": "One local canonical PCM16 WAV (mono or stereo, 16000, 22050, 44100 or 48000 Hz, up to 600 s and 32 MiB), for example from SoX conform or eSpeak NG; FFmpeg with ffprobe beside it."
    }
  ],
  "templates": [
    {
      "id": "frame-movie",
      "title": "Frame-sequence movie",
      "description": "Encode an explicitly ordered PNG frame list at 25 fps into an H.264 movie; frames must have matching dimensions.",
      "file": "studio/templates/frame-movie.json",
      "fields": {
        "files": {
          "label": "Ordered PNG files",
          "type": "json",
          "required": true,
          "default": [
            "/data/frame-0001.png",
            "/data/frame-0002.png"
          ]
        }
      },
      "requires": "Requires the declared source images and, for sheets, matching Aseprite JSON at run time."
    },
    {
      "id": "sprite-movie",
      "title": "Lossless sprite-sheet movie",
      "description": "Reconstruct frame timing from an Aseprite PNG sheet and JSON metadata, then encode FFV1 at 25 fps; alpha is composited on black.",
      "file": "studio/templates/sprite-movie.json",
      "fields": {
        "sheet": {
          "label": "Sheet PNG",
          "type": "path",
          "required": true,
          "default": "/data/sheet.png",
          "extensions": [
            "png"
          ]
        },
        "metadata": {
          "label": "Aseprite JSON",
          "type": "path",
          "required": true,
          "default": "/data/sheet.json",
          "extensions": [
            "json"
          ]
        }
      },
      "requires": "Requires the declared source images and, for sheets, matching Aseprite JSON at run time."
    },
    {
      "id": "video-range",
      "title": "Existing video frame range",
      "description": "Trim presentation frames with inclusive start/exclusive end, then retime at 12 fps into exact FFV1 RGB.",
      "file": "studio/templates/video-range.json",
      "fields": {
        "file": {
          "label": "Source video",
          "type": "path",
          "required": true,
          "default": "/data/source.mkv",
          "extensions": [
            "mkv",
            "mp4"
          ]
        },
        "start": {
          "label": "First frame index (inclusive)",
          "type": "integer",
          "required": true,
          "default": 1,
          "minimum": 0,
          "maximum": 599
        },
        "end": {
          "label": "End frame index (exclusive)",
          "type": "integer",
          "required": true,
          "default": 4,
          "minimum": 1,
          "maximum": 600
        }
      },
      "requires": "Supported silent constant-rate MP4/H264 or MKV/FFV1; whole source <=600 frames and32 MiB."
    },
    {
      "id": "review-movie",
      "title": "Review movie with audio and captions",
      "description": "Mux a silent FFV1 video, PCM16 speech WAV and strict SRT into one verified Matroska review movie; captions are a declared machine draft.",
      "file": "studio/templates/review-movie.json",
      "fields": {
        "video": {
          "label": "Silent FFV1 video",
          "type": "path",
          "required": true,
          "default": "/data/silent.mkv",
          "extensions": [
            "mkv"
          ]
        },
        "audio": {
          "label": "Speech WAV (PCM16)",
          "type": "path",
          "required": true,
          "default": "/data/speech.wav",
          "extensions": [
            "wav"
          ]
        },
        "captions": {
          "label": "Captions (SRT)",
          "type": "path",
          "required": true,
          "default": "/data/captions.srt",
          "extensions": [
            "srt"
          ]
        }
      },
      "requires": "Supported silent Matroska/FFV1 video; canonical PCM16 WAV and plain-text SRT matching its duration."
    },
    {
      "id": "extract-audio",
      "title": "Extract audio from an MP4/M4A recording",
      "description": "Decode one AAC-LC audio stream to a verified canonical PCM16 WAV for SoX, FLAC or whisper.cpp; lossy, machine draft.",
      "file": "studio/templates/extract-audio.json",
      "fields": {
        "file": {
          "label": "AAC recording (MP4 or M4A)",
          "type": "path",
          "required": true,
          "default": "/data/voice-note.m4a",
          "extensions": [
            "m4a",
            "mp4"
          ]
        },
        "streamIndex": {
          "label": "Audio stream index (global)",
          "type": "integer",
          "required": true,
          "default": 0,
          "minimum": 0,
          "maximum": 15
        }
      },
      "requires": "A single AAC-LC audio stream in an intact MP4/M4A; set streamIndex to its global index."
    }
  ],
  "viewers": [
    "image",
    "text"
  ]
}
