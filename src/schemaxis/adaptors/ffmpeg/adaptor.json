{
  "id": "ffmpeg",
  "version": "schemaxis.ffmpeg/1",
  "adaptor": "schemaxis.adaptors.ffmpeg.adaptor",
  "declarations": "schemaxis.adaptors.ffmpeg.adaptor:DECLARATIONS",
  "runtimeFamily": "6.x+",
  "executables": [
    "ffmpeg"
  ],
  "execution": "PNG sequences, sprite sheets and captured video frame ranges to H.264/FFV1 with native RGB verification; verified FFV1, PCM16 and SubRip review movies in Matroska; verified canonical PCM16 WAV from the AAC audio of one MP4/M4A (extractAudio); verified AAC-LC/M4A from one prepared PCM16 WAV under exact byte and mean-sample-error budgets (encodeAudio)",
  "keywords": [
    "video",
    "animation",
    "PNG",
    "sprite sheet",
    "captions",
    "subtitles",
    "audio mux"
  ],
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "nativeThreads": true,
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.ffmpeg/1",
    "nodes": []
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--ffmpeg",
      "dest": "ffmpeg",
      "help": "Explicit FFmpeg executable"
    }
  ],
  "routes": {
    "schemaxis.ffmpeg/1": {
      "module": "schemaxis.adaptors.ffmpeg.adaptor",
      "schema": "schemaxis.adaptors.ffmpeg.adaptor:schema",
      "workflow": true,
      "scheduled": true,
      "compose": true,
      "schemaName": "ffmpeg",
      "acceptedArtifacts": [
        "image",
        "spriteSheet",
        "spriteMetadata",
        "video",
        "file"
      ],
      "hooks": {
        "reusableInputs": "schemaxis.adaptors.ffmpeg.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.ffmpeg.adaptor:resources"
      }
    }
  },
  "capabilities": "schemaxis.adaptors.ffmpeg.capabilities:catalogue"
}
