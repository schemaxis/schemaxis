{
  "id": "ffmpeg",
  "version": "schemaxis.ffmpeg/1",
  "adaptor": "schemaxis.adaptors.ffmpeg.adaptor",
  "declarations": "schemaxis.adaptors.ffmpeg.adaptor:DECLARATIONS",
  "runtimeFamily": "6.x+",
  "executables": ["ffmpeg"],
  "execution": "PNG sequences and sprite sheets to H.264/FFV1 video with native decode verification",
  "keywords": ["video", "animation", "PNG", "sprite sheet", "presentation"],
  "executionCapabilities": {"modes": ["process"], "nativeThreads": true, "mpi": false},
  "consoleTemplate": {"version": "schemaxis.ffmpeg/1", "nodes": []},
  "consoleCapabilities": {"authoredSessions": true, "multipleDocuments": true, "liveGeometry": false, "nativeEditReverseSync": false},
  "cliOptions": [{"flag": "--ffmpeg", "dest": "ffmpeg", "help": "Explicit FFmpeg executable"}],
  "routes": {
    "schemaxis.ffmpeg/1": {
      "module": "schemaxis.adaptors.ffmpeg.adaptor",
      "schema": "schemaxis.adaptors.ffmpeg.adaptor:schema",
      "workflow": true,
      "scheduled": true,
      "compose": true,
      "schemaName": "ffmpeg",
      "acceptedArtifacts": ["image", "spriteSheet", "spriteMetadata"],
      "hooks": {"reusableInputs": "schemaxis.adaptors.ffmpeg.adaptor:reusableInputs", "resources": "schemaxis.adaptors.ffmpeg.adaptor:resources"}
    }
  },
  "capabilities": "schemaxis.adaptors.ffmpeg.capabilities:catalogue"
}
