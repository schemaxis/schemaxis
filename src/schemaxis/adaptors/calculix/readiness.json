{
  "version": "schemaxis.readiness/1",
  "routes": {
    "schemaxis.calculix/1": {
      "guide": "docs/calculix.md",
      "context": {
        "purpose": "Assess rectangular isotropic elastic members under combined axial force, biaxial transverse force, torsion and biaxial end couples from physical intent and named native-measured serviceability requirements.",
        "assumptions": "SI m/N/Pa/N m/rad; x-axis beam with centred y/z rectangle. Six signed end resultants use consistent face tractions. Clamped face, or transverse-contraction-permitting axialSlide for pure axial loading. Linear static isotropic elasticity; no stability or failure certification.",
        "constraints": "Slenderness20..40, section aspect0.5..2, E1e6..1e12 Pa, nu0..0.35; small normal/shear strain scales<=0.001, theory translation/length<=0.01 and twist<=0.02 rad. Base12..24 by2..3 by2..3 quadratic cells, independent2x refinements. No arbitrary mesh/deck, nonlinearity or nonrectangular sections.",
        "inspection": "Reconstruct all decks, check exact native IDs/Gauss coordinates, each active displacement/twist and independent interior normal/parity-isolated torsion stress references, force/moment balance, separate refinement, exact fine-deck reopening, CSV and assessment identity.",
        "recovery": "Invalid geometry/load/restraint is rejected before launch. Native numerical disagreement and unmet named measurements remain distinct faults; retain evidence, adjust explicit intent/mesh within domain and rerun fresh. Requirements never change themselves."
      },
