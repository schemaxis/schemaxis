{
  "id": "calculix",
  "version": "schemaxis.calculix/1",
  "adaptor": "schemaxis.adaptors.calculix.adaptor",
  "runtimeFamily": "2.23",
  "executables": [
    "ccx"
  ],
  "execution": "Six-resultant rectangular elastic members with independent axial, biaxial bending, torsion, equilibrium and refinement checks",
  "keywords": [
    "cantilever",
    "FEA",
    "elasticity",
    "deflection",
    "stress",
    "torsion",
    "axial",
    "mesh convergence",
    "CalculiX"
  ],
  "capabilities": "schemaxis.adaptors.calculix.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.calculix/1",
    "operation": "cantileverBeam",
    "beam": {
      "length_m": 0.4,
      "width_m": 0.02,
      "height_m": 0.02
    },
    "material": {
      "youngsModulus_Pa": 210000000000.0,
      "poissonRatio": 0.3
    },
    "load": {
      "tipForceX_N": 1000,
      "tipForceY_N": 20,
      "tipForceZ_N": -30,
      "tipMomentX_Nm": 1,
      "tipMomentY_Nm": 2,
      "tipMomentZ_Nm": -1
    },
    "mesh": {
      "lengthCells": 12,
      "sectionCells": 2
    },
    "requirements": [
      {
        "name": "translation_serviceability",
        "quantity": "tipAreaMeanTranslation_m",
        "maximum": 0.0004
      },
      {
        "name": "torsional_serviceability",
        "quantity": "absTipTwist_rad",
        "maximum": 0.00025
      },
      {
        "name": "interior_sample_equivalent",
        "quantity": "maxInteriorSampleVonMises_Pa",
        "maximum": 15000000.0
      }
    ]
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "routes": {
    "schemaxis.calculix/1": {
      "module": "schemaxis.adaptors.calculix.adaptor",
      "schema": "schemaxis.adaptors.calculix.adaptor:schema",
      "schemaName": "calculix",
      "graphEditing": false,
      "workflow": true,
      "scheduled": true,
      "compose": true,
      "acceptedArtifacts": [],
      "hooks": {
        "query": "schemaxis.adaptors.calculix.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.calculix.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.calculix.adaptor:resources"
      }
    }
  },
  "cliOptions": [
    {
      "flag": "--calculix",
      "dest": "calculix",
      "help": "Absolute qualified CalculiX 2.23 executable"
    }
  ]
}
