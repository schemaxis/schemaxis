            },
            {
              "id": "area",
              "filter": "integral",
              "options": {
                "initial": 0
              },
              "inputs": {
                "input": "calibrated"
              }
            }
          ]
        },
        {
          "at": "/outputs/-",
          "values": [
            "area"
          ]
        }
      ],
      "complexity": "composite"
    },
    {
      "id": "uniform-spectrum",
      "title": "Resample then analyse spectrum",
      "category": "recipes",
      "icon": "layers",
      "description": "Insert an ordered two-stage analysis and publish the final table.",
      "fields": {
        "source": {
          "label": "Input samples",
          "type": "nodeRef",
          "required": true,
          "default": "source"
        }
      },
      "inserts": [
        {
          "at": "/nodes/-",
          "values": [
            {
              "id": "uniform",
              "filter": "resample",
              "options": {
                "count": 128
              },
              "inputs": {
                "input": {
                  "$fill": "source"
                }
              }
            },
            {
              "id": "spectrum",
              "filter": "fft",
              "options": {},
              "inputs": {
                "input": "uniform"
              }
            }
          ]
        },
        {
          "at": "/outputs/-",
          "values": [
            "spectrum"
          ]
        }
      ],
      "complexity": "composite"
    },
    {
      "id": "calibration-fit",
      "title": "Fit a calibration curve",
      "category": "recipes",
      "icon": "layers",
      "description": "Insert an ordered two-stage analysis and publish the final table.",
      "fields": {
        "source": {
          "label": "Input samples",
          "type": "nodeRef",
          "required": true,
          "default": "source"
        }
      },
      "inserts": [
        {
          "at": "/nodes/-",
          "values": [
            {
              "id": "calibration",
              "filter": "scale",
              "options": {
                "factor": 1,
                "offset": 0
              },
              "inputs": {
                "input": {
                  "$fill": "source"
