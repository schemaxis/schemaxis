  ],
  "templates": [
    {
      "id": "signal-analysis",
      "title": "Signal and spectrum",
      "description": "Generate a sampled periodic signal and publish its moving mean, spectrum, cumulative integral and derivative.",
      "file": "studio/templates/signal-analysis.json",
      "fields": {
        "value": {
          "label": "Signal and spectrum input",
          "type": "number",
          "required": true,
          "default": 8
        }
      }
    },
    {
      "id": "calibration",
      "title": "Calibration and fit",
      "description": "Fit a straight line to five paired measurements, then differentiate and integrate the fitted curve.",
      "file": "studio/templates/calibration.json",
      "fields": {
        "value": {
          "label": "Calibration and fit input",
          "type": "json",
          "required": true,
          "default": [
            0,
            1,
            2,
            3,
            4
          ]
        }
      }
    },
    {
      "id": "table-analysis",
      "title": "Paired sample analysis",
      "description": "Publish five supplied Y values paired with X coordinates 0\u20134; array lengths must match.",
      "file": "studio/templates/table-analysis.json",
      "fields": {
        "value": {
          "label": "Paired sample analysis input",
          "type": "json",
          "required": true,
          "default": [
            0,
            2,
            4,
            6,
            8
          ]
        }
      }
    }
  ],
  "viewers": [
    "table",
    "text"
  ]
}
