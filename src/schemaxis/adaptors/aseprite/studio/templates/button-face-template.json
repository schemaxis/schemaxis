{
  "version": "schemaxis.aseprite/1",
  "nodes": [
    {
      "id": "canvas",
      "filter": "sprite",
      "options": {
        "width": 32,
        "height": 32,
        "layer": "base"
      }
    },
    {
      "id": "${prefix}1",
      "filter": "rect",
      "options": {
        "layer": "base",
        "x": 3,
        "y": 8,
        "width": 26,
        "height": 16,
        "colour": {
          "$fill": "colour"
        }
      },
      "inputs": {
        "sprite": "canvas"
      }
    },
    {
      "id": "${prefix}2",
      "filter": "rect",
      "options": {
        "layer": "base",
        "x": 4,
        "y": 9,
        "width": 24,
        "height": 2,
        "colour": [
          255,
          255,
          255,
          255
        ]
      },
      "inputs": {
        "sprite": "${prefix}1"
      }
    }
  ],
  "output": "${prefix}2"
}
