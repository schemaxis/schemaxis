{
  "version": "schemaxis.aseprite/1",
  "nodes": [
    {
      "id": "canvas",
      "filter": "sprite",
      "options": {
        "width": 32,
        "height": 32,
        "layer": "base"
      }
    },
    {
      "id": "${prefix}1",
      "filter": "rect",
      "options": {
        "layer": "base",
        "x": 2,
        "y": 2,
        "width": 28,
        "height": 28,
        "colour": [
          20,
          40,
          80,
          255
        ]
      },
      "inputs": {
        "sprite": "canvas"
      }
    },
    {
      "id": "${prefix}2",
      "filter": "layer",
      "options": {
        "name": "badgeDetail"
      },
      "inputs": {
        "sprite": "${prefix}1"
      }
    },
    {
      "id": "${prefix}3",
      "filter": "circle",
      "options": {
        "layer": "badgeDetail",
        "x": 16,
        "y": 16,
        "radius": 8,
        "colour": {
          "$fill": "colour"
        }
      },
      "inputs": {
        "sprite": "${prefix}2"
      }
    }
  ],
  "output": "${prefix}3"
}
