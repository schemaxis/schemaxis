{
  "version": "schemaxis.aseprite/1",
  "nodes": [
    {
      "id": "canvas",
      "filter": "sprite",
      "options": {
        "width": 32,
        "height": 32,
        "layer": "base"
      }
    },
    {
      "id": "${prefix}1",
      "filter": "circle",
      "options": {
        "layer": "base",
        "x": 16,
        "y": 16,
        "radius": 8,
        "colour": {
          "$fill": "colour"
        }
      },
      "inputs": {
        "sprite": "canvas"
      }
    },
    {
      "id": "${prefix}2",
      "filter": "frame",
      "options": {
        "durationMS": {
          "$fill": "duration"
        }
      },
      "inputs": {
        "sprite": "${prefix}1"
      }
    },
    {
      "id": "${prefix}3",
      "filter": "rect",
      "options": {
        "layer": "base",
        "frame": 2,
        "x": 8,
        "y": 15,
        "width": 16,
        "height": 2,
        "colour": {
          "$fill": "colour"
        }
      },
      "inputs": {
        "sprite": "${prefix}2"
      }
    },
    {
      "id": "${prefix}4",
      "filter": "tag",
      "options": {
        "name": "blink",
        "fromFrame": 1,
        "toFrame": 2,
        "direction": "pingPong"
      },
      "inputs": {
        "sprite": "${prefix}3"
      }
    }
  ],
  "output": "${prefix}4"
}
