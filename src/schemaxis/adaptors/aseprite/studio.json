      "category": "canvas",
      "description": "Configure the root canvas; keep existing drawing coordinates inside the chosen dimensions.",
      "fields": {
        "width": {
          "label": "Width",
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 256,
          "default": 32
        },
        "height": {
          "label": "Height",
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 256,
          "default": 32
        },
        "durationMS": {
          "label": "Duration ms",
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 65535,
          "default": 100
