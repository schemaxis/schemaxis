  "templates": [
    {
      "id": "button-face-template",
      "title": "Button face with highlight",
      "description": "Draw a filled button and a contrasting top highlight.",
      "file": "studio/templates/button-face-template.json",
      "fields": {
        "prefix": {
          "label": "Operation prefix",
          "type": "id",
          "required": true,
          "default": "sprite"
        },
        "colour": {
          "label": "Button RGBA",
          "type": "json",
          "required": true,
          "default": [
            30,
            120,
            220,
            255
          ]
        }
      }
    },
    {
      "id": "two-frame-blink-template",
