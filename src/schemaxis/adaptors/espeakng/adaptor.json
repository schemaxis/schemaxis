{
  "id": "espeakng",
  "version": "schemaxis.espeakng/1",
  "adaptor": "schemaxis.adaptors.espeakng.adaptor",
  "declarations": "schemaxis.adaptors.espeakng.adaptor:DECLARATIONS",
  "runtimeFamily": "1.52",
  "execution": "Bounded offline narration DRAFT: one plain-text script spoken by the fixed eSpeak NG en-us voice or one explicitly selected voice (en-us, en-gb, fr-fr, es) into a canonical PCM16 mono 22050 Hz WAV, with every PCM byte proven by a fresh trusted native re-synthesis",
  "executables": [
    "espeak-ng"
  ],
  "keywords": [
    "eSpeak NG",
    "text to speech",
    "narration draft"
  ],
  "display": {
    "name": "eSpeak NG",
    "mark": "Es",
    "colour": "#7a4e9c"
  },
  "capabilities": "schemaxis.adaptors.espeakng.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.espeakng/1",
    "operation": "narrate",
    "text": "Replace this with the words to narrate."
  },
  "routes": {
    "schemaxis.espeakng/1": {
      "module": "schemaxis.adaptors.espeakng.adaptor",
      "schema": "schemaxis.adaptors.espeakng.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "espeakng",
      "acceptedArtifacts": [
        "file",
        "text"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.espeakng.adaptor:query",
        "resources": "schemaxis.adaptors.espeakng.adaptor:resources",
        "reusableInputs": "schemaxis.adaptors.espeakng.adaptor:reusableInputs"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--espeakng",
      "dest": "espeakng",
      "help": "Absolute eSpeak NG 1.52.0 espeak-ng executable for run, which also uses it for the fresh verification re-synthesis; schemaxis verify has no such flag, so use SCHEMAXIS_ESPEAKNG or a stored espeakng location"
    }
  ]
}
