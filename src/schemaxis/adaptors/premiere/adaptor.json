{
  "id": "premiere",
  "version": "schemaxis.premiere/1",
  "adaptor": "schemaxis.adaptors.premiere.adaptor",
  "declarations": "schemaxis.adaptors.premiere.adaptor:DECLARATIONS",
  "runtimeFamily": "Adobe Premiere Pro 26.5+ UXP (experimental; native unqualified)",
  "executables": [],
  "execution": "Read-only active sequence observation through the supplied UXP panel and an explicitly selected fresh job folder",
  "keywords": [
    "Premiere",
    "UXP",
    "video",
    "sequence",
    "timeline",
    "inspection"
  ],
  "capabilities": "schemaxis.adaptors.premiere.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.premiere/1",
    "operation": "sequenceContract",
    "projectPath": "/replace-with-your-project/colours.prproj",
    "sequenceName": "Schemaxis Colours",
    "fps": 25,
    "width": 32,
    "height": 24,
    "clips": [
      {
        "sourcePath": "/replace-with-your-media/colours.mp4",
        "startFrame": 3,
        "frameCount": 3
      },
      {
        "sourcePath": "/replace-with-your-media/colours.mp4",
        "startFrame": 0,
        "frameCount": 2
      }
    ]
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--premiere-bridge",
      "dest": "premiereBridge",
      "help": "Existing private local directory for fresh Premiere UXP observation jobs (Windows/macOS only)"
    }
  ],
  "routes": {
    "schemaxis.premiere/1": {
      "module": "schemaxis.adaptors.premiere.adaptor",
      "schema": "schemaxis.adaptors.premiere.adaptor:schema",
      "schemaName": "premiere",
      "graphEditing": false,
      "workflow": false,
      "scheduled": false,
      "compose": true,
      "runOptions": {
        "bridge": "premiereBridge"
      }
    }
  }
}
