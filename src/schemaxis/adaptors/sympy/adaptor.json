{
  "id": "sympy",
  "version": "schemaxis.sympy/1",
  "adaptor": "schemaxis.adaptors.sympy.adaptor",
  "declarations": "schemaxis.adaptors.sympy.adaptor:DECLARATIONS",
  "runtimeFamily": "1.14.0",
  "execution": "Isolate every real root of an exact rational polynomial in rational intervals with multiplicities, certified independently by Sturm sequences",
  "executables": [
    "python3"
  ],
  "keywords": [
    "SymPy",
    "real root isolation",
    "polynomial roots",
    "Sturm sequence",
    "exact rational arithmetic"
  ],
  "display": {
    "name": "SymPy",
    "mark": "Sy",
    "colour": "#3b5526"
  },
  "capabilities": "schemaxis.adaptors.sympy.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.sympy/1",
    "operation": "isolateRealRoots",
    "coefficients": [
      "1",
      "0",
      "-2"
    ],
    "maximumIntervalWidth": "1/1000"
  },
  "routes": {
    "schemaxis.sympy/1": {
      "module": "schemaxis.adaptors.sympy.adaptor",
      "schema": "schemaxis.adaptors.sympy.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": false,
      "timeBatches": false,
      "schemaName": "sympy",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.sympy.adaptor:query",
        "retainedInputs": "schemaxis.adaptors.sympy.adaptor:retainedInputs",
        "reusableInputs": "schemaxis.adaptors.sympy.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.sympy.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--sympy",
      "dest": "sympy",
      "help": "Absolute isolated Python interpreter containing qualified SymPy 1.14.0"
    }
  ]
}
