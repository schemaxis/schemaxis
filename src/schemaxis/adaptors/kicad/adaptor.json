{
  "id": "kicad",
  "version": "schemaxis.kicad/1",
  "adaptor": "schemaxis.adaptors.kicad.adaptor",
  "runtimeFamily": "10.0",
  "execution": "Isolated kicad-cli 10.0: saved-board statistics, design rule check and Excellon drill export with independent board, DRC and drill-hit checks",
  "executables": [
    "kicad-cli"
  ],
  "keywords": [
    "PCB",
    "printed circuit board",
    "KiCad",
    "kicad_pcb"
  ],
  "capabilities": "schemaxis.adaptors.kicad.capabilities:catalogue",
  "display": {
    "name": "KiCad",
    "mark": "KC",
    "colour": "#314cb0"
  },
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.kicad/1",
    "operation": "designRuleCheck",
    "board": "/replace-with-your-input/board.kicad_pcb",
    "maximumErrors": 0,
    "maximumWarnings": 0,
    "maximumUnconnected": 0
  },
  "routes": {
    "schemaxis.kicad/1": {
      "module": "schemaxis.adaptors.kicad.adaptor",
      "schema": "schemaxis.adaptors.kicad.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "kicad",
      "acceptedArtifacts": [],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.kicad.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.kicad.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.kicad.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--kicad",
      "dest": "kicad",
      "help": "Absolute KiCad 10.0 kicad-cli executable"
    }
  ]
}
