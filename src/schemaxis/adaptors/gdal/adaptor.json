{
  "id": "gdal",
  "version": "schemaxis.gdal/1",
  "adaptor": "schemaxis.adaptors.gdal.adaptor",
  "declarations": "schemaxis.adaptors.gdal.adaptor:DECLARATIONS",
  "runtimeFamily": "3.13",
  "execution": "Isolated north-up GeoTIFF pixel window extraction and nearest grid resizing with independent raster verification",
  "executables": [
    "python3"
  ],
  "keywords": [
    "GDAL",
    "GeoTIFF",
    "raster window",
    "nearest neighbour"
  ],
  "display": {
    "name": "GDAL",
    "mark": "GD",
    "colour": "#497c45"
  },
  "capabilities": "schemaxis.adaptors.gdal.capabilities:catalogue",
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.gdal/1",
    "operation": "window",
    "source": "/replace/with/elevation.tif",
    "x": 1,
    "y": 1,
    "width": 4,
    "height": 3,
    "outputWidth": 4,
    "outputHeight": 3,
    "epsg": 3857,
    "units": "m",
    "nodata": -9999,
    "resampling": "nearest",
    "lossPolicy": "strict"
  },
  "routes": {
    "schemaxis.gdal/1": {
      "module": "schemaxis.adaptors.gdal.adaptor",
      "schema": "schemaxis.adaptors.gdal.adaptor:schema",
      "graphEditing": false,
      "workflow": true,
      "compose": true,
      "timeBatches": false,
      "schemaName": "gdal",
      "acceptedArtifacts": [
        "image"
      ],
      "scheduled": true,
      "hooks": {
        "query": "schemaxis.adaptors.gdal.adaptor:query",
        "reusableInputs": "schemaxis.adaptors.gdal.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.gdal.adaptor:resources"
      }
    }
  },
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--gdal",
      "dest": "gdal",
      "help": "Absolute isolated Python interpreter containing GDAL 3.13.3"
    }
  ]
}
