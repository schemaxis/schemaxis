          "https://gdal.org/en/stable/api/python/utilities.html#osgeo.gdal.Run"
        ],
        "lifecycle": {
          "timeout": "One total deadline; shared owned process-tree runner; native AS2 GiB/CPU60 s/FSIZE16 MiB caps.",
          "cancellation": "Shared process cancellation and final prepublication cancellation check.",
          "logs": "Captured source, effective plan, trusted native worker, per-stage input hashes/stdout/stderr/submissions.",
          "verification": "Independent classic TIFF/GeoKey/pixel reader plus integer centre-sampling oracle, literal fixtures and fresh isolated GDAL reopening."
        },
        "data": [
          {
            "id": "raster-input",
            "direction": "input",
            "kind": "image",
            "format": "GeoTIFF",
            "traits": {
              "bands": 1,
              "pixelInterpretation": "area"
            },
            "losses": [
              "Strict subset rejects unknown tags/extra metadata instead of silently omitting data."
            ],
            "scope": "Captured regular local file <=8 MiB; 262144 pixels."
          },
          {
            "id": "raster-output",
            "direction": "output",
            "kind": "image",
            "format": "GeoTIFF",
            "traits": {
              "bands": 1,
              "georeferenced": true
            },
            "losses": [
              "Nearest downsampling drops unsampled pixels; no averaging/conservation claim.",
              "TIFF strip layout, byte order and descriptive CRS citations may change."
            ],
            "scope": "Extent-preserving north-up grid and source-bound statistical summary."
          },
          {
            "id": "zonal-table",
            "direction": "output",
            "kind": "table",
            "format": "CSV",
            "traits": {
              "columns": 8,
              "nullToken": "\\N",
              "typed": true
            },
            "losses": [
              "Rectangles, units, CRS and missing policy are not CSV columns; they are in zones-summary.json and publication metadata.",
              "Overlapping zones are independent summaries, not unique pixels; sum is not an area integral."
            ],
            "scope": "Fixed typed CSV, one row per authored zone, in authored order."
          }
        ],
        "inspection": [
