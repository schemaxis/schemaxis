{
  "version": "schemaxis.readiness/1",
  "routes": {
    "schemaxis.gdal/1": {
      "guide": "docs/gdal.md",
      "context": {
        "purpose": "Extract georeferenced raster windows and resize their grid with nearest-neighbour sampling while retaining explicit CRS, band units and nodata. zonalSummary summarises declared pixel-aligned rectangular zones of the captured grid (valid/missing count, coverage, minimum, maximum, sum, mean) into a typed CSV for Calc.",
        "assumptions": "North-up PixelIsArea single-band uncompressed UInt16/Int16/finite Float32 GeoTIFF; GDAL 3.13.3 isolated Python on POSIX.",
        "constraints": "262144 source/output pixels, 4096 per axis, 8 MiB file; EPSG:4326 longitude/latitude degrees or 3857 metres; units m, K, 1. No reprojection/bilinear/masks/overviews/extra metadata.",
        "inspection": "Stdlib GeoTIFF parser compares every output pixel, geotransform, CRS, units and nodata to an independent centre-sampling oracle, then compares fresh GDAL reopening. zonalSummary: a stdlib oracle visits every included pixel and regenerates the zone geometry; native GDAL zonal-stats output and a fresh OGR reopening must match exactly (counts, extrema) or within a stated roundoff bound (sum, mean).",
        "recovery": "INVALID_RASTER_CONTENT: inspect declared metadata and supported subset; RASTER_EXTENT_INVALID: EPSG:4326 window latitude outside -90..90, fix mislabelled georeferencing or crop inside range; RASTER_PIXEL_LIMIT: reduce dimensions; INTERPRETER_NOT_FOUND: configure isolated GDAL 3.13.3 interpreter. INVALID_ZONE: re-author the rectangle inside the current grid with a unique ID; ZONE_MISSING_VALUES: use missing exclude or fix nodata; ZONE_SUM_UNRESOLVABLE: positive and negative values cancel so the derived native roundoff allowance exceeds 2**-26 of the exact sum, choose a different zone."
      },
      "examples": [
        {
          "id": "baseline",
          "reference": "examples/schemaxis/gdal-window.json"
        },
        {
          "id": "variant",
          "reference": "examples/schemaxis/gdal-window-variant.json"
        },
        {
          "id": "temperature",
          "reference": "examples/schemaxis/gdal-temperature.json"
