      },
      "requires": "Requires a numeric CSV with a header and at least two rows."
    },
    {
      "id": "mechanical-summary",
      "title": "Mechanical test summary",
      "description": "Publish verified XLSX, ODS and numeric CSV outputs with automatic summary statistics.",
      "file": "studio/templates/mechanical-summary.json",
      "fields": {
        "data": {
          "label": "Table input",
