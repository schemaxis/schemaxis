{
  "version": "schemaxis.studio-adaptor/2",
  "baseDocument": {
    "version": "schemaxis.calc/1",
    "nodes": [
      {
        "id": "data",
        "filter": "fromRows",
        "options": {
          "columns": [
            "x",
            "y"
          ],
          "rows": [
            [
              0,
              2
            ],
            [
              1,
              4
            ],
            [
              2,
              6
            ]
          ]
        }
      }
    ]
  },
  "categories": [
    {
      "id": "tables",
      "title": "Numeric tables",
      "icon": "layers"
    },
    {
      "id": "sources",
      "title": "CSV sources",
      "icon": "layers"
    },
    {
      "id": "studies",
      "title": "Study tables",
      "icon": "layers"
    }
  ],
  "snippets": [
    {
      "id": "sample-table",
      "title": "Numeric sample table",
      "description": "Replace the workbook input with a two-column numeric table.",
      "inserts": [
        {
          "at": "/nodes",
          "values": [
            [
              {
                "id": {
                  "$fill": "name"
                },
                "filter": "fromRows",
                "options": {
                  "columns": [
                    "Time",
                    "Force"
                  ],
                  "rows": [
                    [
                      0,
                      2
                    ],
                    [
                      1,
                      5
                    ],
                    [
                      2,
                      8
                    ]
                  ]
                }
              }
            ]
          ]
        }
      ],
      "category": "tables",
      "baseDocument": {
        "version": "schemaxis.calc/1",
        "nodes": [
          {
            "id": "measurements",
            "filter": "fromRows",
            "options": {
              "columns": [
                "Time",
                "Displacement",
                "Force"
              ],
              "rows": [
                [
                  0,
                  0,
                  2
                ],
                [
                  1,
                  1.5,
                  5
                ],
                [
                  2,
                  4,
                  8
                ],
                [
                  3,
                  7.5,
                  11
                ],
                [
                  4,
                  12,
                  14
                ]
              ]
            }
          }
        ]
      },
      "fields": {
        "name": {
          "label": "name",
          "type": "id",
          "default": "measurements",
          "required": true
        }
      }
    },
    {
      "id": "csv-workbook",
      "title": "Workbook from CSV",
      "category": "sources",
      "icon": "layers",
      "description": "Replace the numeric input with a captured CSV source.",
      "fields": {
        "file": {
          "label": "Numeric CSV",
          "type": "path",
          "required": true,
          "default": "/data/results.csv",
          "extensions": [
            "csv"
          ]
        }
      },
      "inserts": [
        {
          "at": "",
          "values": [
            {
              "version": "schemaxis.calc/1",
              "nodes": [
                {
                  "id": "data",
                  "filter": "readCSV",
                  "options": {
                    "file": {
                      "$fill": "file"
                    }
                  }
                }
              ]
            }
          ]
        }
      ],
      "complexity": "composite",
      "requires": "Requires a numeric CSV with a header and at least two rows at run time."
    },
    {
      "id": "append-row",
      "title": "Append one measurement",
      "category": "tables",
      "icon": "layers",
      "description": "Add a numeric row matching the existing two column headings.",
      "fields": {
        "append-row": {
          "label": "Append one measurement",
          "type": "json",
          "required": true,
          "default": [
            3,
            8
          ]
        }
      },
      "inserts": [
        {
          "at": "/nodes/0/options/rows/-",
          "values": [
            {
              "$fill": "append-row"
            }
          ]
        }
      ]
    },
    {
      "id": "mechanical-table",
      "title": "Time, displacement and force",
      "category": "studies",
      "icon": "layers",
      "description": "Replace columns and rows together so the numeric table stays rectangular.",
      "fields": {
        "mechanical-table": {
          "label": "Time, displacement and force",
          "type": "json",
          "required": true,
          "default": {
            "columns": [
              "time",
              "displacement",
              "force"
            ],
            "rows": [
              [
                0,
