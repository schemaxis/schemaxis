    },
    {
      "id": "rename-columns",
      "title": "Column labels with units",
      "category": "tables",
      "icon": "layers",
      "description": "Rename the two table headers while preserving numeric values.",
      "fields": {
        "rename-columns": {
          "label": "Column labels with units",
          "type": "json",
          "required": true,
          "default": [
            "time_s",
            "response_N"
          ]
        }
      },
      "inserts": [
        {
          "at": "/nodes/0/options/columns",
          "values": [
            {
              "$fill": "rename-columns"
            }
          ]
        }
      ]
    },
    {
      "id": "shared-study-value",
      "title": "Shared parameter in a result table",
      "category": "studies",
      "icon": "layers",
      "description": "Keep a numeric study value in settings and reference it from a table cell for later template exposure.",
      "fields": {
        "gain": {
          "label": "Shared numeric value",
          "type": "number",
          "required": true,
          "default": 2
        }
      },
      "inserts": [
        {
          "at": "",
          "values": [
            {
              "version": "schemaxis.calc/1",
              "nodes": [
                {
                  "id": "data",
                  "filter": "fromRows",
                  "options": {
                    "columns": [
                      "x",
                      "y"
                    ],
                    "rows": [
                      [
                        0,
                        {
                          "$document": "/settings/gain"
                        }
                      ],
                      [
                        1,
                        4
                      ],
                      [
                        2,
                        6
                      ]
                    ]
                  }
                }
              ],
              "settings": {
                "gain": {
                  "$fill": "gain"
                }
              }
            }
          ]
        }
      ],
      "complexity": "composite"
    }
  ],
  "templates": [
