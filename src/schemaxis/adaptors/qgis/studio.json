    {
      "id": "projected-buffer",
      "title": "Project and buffer a geographic layer",
      "category": "recipes",
      "icon": "layers",
      "description": "Insert a complete ordered vector analysis and select the last layer.",
      "fields": {
        "source": {
          "label": "Source layer",
          "type": "nodeRef",
