{
  "version": "schemaxis.studio-adaptor/2",
  "baseDocument": {
    "version": "schemaxis.qgis/1",
    "nodes": [
      {
        "id": "source",
        "filter": "readVector",
        "options": {
          "file": "/data/sites.geojson"
        }
      },
      {
        "id": "metric",
        "filter": "reproject",
        "options": {
          "crs": "EPSG:3857"
        },
        "inputs": {
          "input": "source"
        }
      }
    ],
    "output": "metric",
    "preview": true
  },
  "categories": [
    {
      "id": "layers",
      "title": "Vector layers",
      "icon": "layers"
    },
    {
      "id": "geometry",
      "title": "Buffer, clip & centroid",
      "icon": "layers"
    },
    {
      "id": "recipes",
      "title": "Site analysis",
      "icon": "layers"
    },
    {
      "id": "maps",
      "title": "Map publication",
      "icon": "layers"
    },
    {
      "id": "studies",
      "title": "Distance studies",
      "icon": "layers"
    },
    {
      "id": "attributes",
      "title": "Attribute analysis",
      "icon": "layers"
    }
  ],
  "snippets": [
    {
      "id": "add-readvector",
      "title": "Read a vector layer",
      "category": "layers",
      "icon": "layers",
      "description": "Read one bounded 2D GeoJSON or GeoPackage vector layer with its declared CRS.",
      "fields": {
        "name": {
          "label": "Output layer ID",
          "type": "id",
          "required": true,
          "default": "readvector"
        },
        "file": {
          "label": "Vector file",
          "type": "path",
          "required": true,
          "default": "/data/sites.geojson",
          "extensions": [
            "geojson",
            "gpkg"
          ]
        }
      },
      "inserts": [
        {
          "at": "/nodes/-",
          "values": [
            {
              "id": {
                "$fill": "name"
              },
              "filter": "readVector",
              "options": {
                "file": {
                  "$fill": "file"
                }
              }
            }
          ]
        },
        {
          "at": "/output",
          "values": [
            {
              "$fill": "name"
            }
          ]
        }
      ],
      "requires": "Requires the source vector file when running. Buffer distances need a projected CRS in metres.",
      "complexity": "composite"
    },
    {
      "id": "add-reproject",
      "title": "Reproject a layer",
      "category": "layers",
      "icon": "layers",
      "description": "Transform vector coordinates to an explicit EPSG CRS.",
      "fields": {
        "name": {
          "label": "Output layer ID",
          "type": "id",
          "required": true,
          "default": "reproject"
        },
        "source": {
          "label": "Input layer",
          "type": "nodeRef",
          "required": true,
          "default": "source"
        },
        "crs": {
          "label": "Analysis CRS",
          "type": "string",
          "required": true,
          "description": "Choose an appropriate local projected CRS for the study area. Buffer distances use its coordinate units; EPSG:3857 is not a universal ground-distance choice."
        }
      },
      "inserts": [
        {
          "at": "/nodes/-",
          "values": [
            {
              "id": {
                "$fill": "name"
              },
              "filter": "reproject",
              "options": {
                "crs": {
                  "$fill": "crs"
                }
              },
              "inputs": {
                "input": {
                  "$fill": "source"
                }
              }
            }
          ]
        },
        {
          "at": "/output",
          "values": [
            {
              "$fill": "name"
            }
          ]
        }
      ],
      "requires": "Requires the source vector file when running. Buffer distances need a projected CRS in metres.",
      "complexity": "composite",
      "testValues": {
        "crs": "EPSG:32614"
      }
    },
    {
      "id": "add-centroid",
      "title": "Feature centroids",
      "category": "geometry",
      "icon": "layers",
      "description": "Reduce each projected polygon or multipolygon to its planar area-weighted centre of mass, retaining attributes and CRS.",
      "fields": {
        "name": {
          "label": "Output layer ID",
          "type": "id",
          "required": true,
          "default": "centroid"
        },
        "source": {
          "label": "Input layer",
          "type": "nodeRef",
          "required": true,
          "default": "metric"
        }
      },
      "inserts": [
        {
          "at": "/nodes/-",
          "values": [
            {
              "id": {
                "$fill": "name"
              },
              "filter": "centroid",
              "options": {},
              "inputs": {
                "input": {
                  "$fill": "source"
                }
              }
            }
          ]
        },
        {
          "at": "/output",
          "values": [
            {
              "$fill": "name"
            }
          ]
        }
      ],
      "requires": "Requires the source vector file when running. Buffer distances need a projected CRS in metres.",
      "complexity": "composite"
    },
    {
      "id": "add-buffer",
      "title": "Metric buffer zones",
      "category": "geometry",
      "icon": "layers",
      "description": "Buffer vector geometry by a distance in metres; a projected metre CRS is required.",
      "fields": {
        "name": {
          "label": "Output layer ID",
          "type": "id",
          "required": true,
          "default": "buffer"
        },
        "source": {
          "label": "Input layer",
          "type": "nodeRef",
          "required": true,
          "default": "metric"
        },
        "radius": {
          "label": "Distance in metres",
          "type": "number",
          "required": true,
          "default": 100,
          "minimum": 0.001,
          "maximum": 100000
        }
      },
      "inserts": [
        {
          "at": "/nodes/-",
          "values": [
            {
              "id": {
                "$fill": "name"
              },
              "filter": "buffer",
              "options": {
                "distance": {
                  "$fill": "radius"
                },
                "segments": 16
              },
              "inputs": {
                "input": {
                  "$fill": "source"
                }
              }
            }
          ]
        },
        {
          "at": "/output",
          "values": [
            {
              "$fill": "name"
            }
          ]
        }
      ],
      "requires": "Requires the source vector file when running. Buffer distances need a projected CRS in metres.",
      "complexity": "composite"
    },
    {
      "id": "add-clip",
      "title": "Clip to a study rectangle",
      "category": "geometry",
      "icon": "layers",
      "description": "Intersect features with an axis-aligned rectangle in the current layer CRS.",
