{
  "version": "schemaxis.qgis/1",
  "nodes": [
    {
      "id": "source",
      "filter": "readVector",
      "options": {
        "file": {
          "$fill": "file"
        }
      }
    },
    {
      "id": "metric",
      "filter": "reproject",
      "options": {
        "crs": {
          "$fill": "crs"
        }
      },
      "inputs": {
        "input": "source"
      }
    },
    {
      "id": "centres",
      "filter": "centroid",
      "options": {},
      "inputs": {
        "input": "metric"
      }
    }
  ],
  "output": "centres",
  "preview": true
}
