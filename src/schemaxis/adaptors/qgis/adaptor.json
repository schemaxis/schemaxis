{
  "id": "qgis",
  "version": "schemaxis.qgis/1",
  "adaptor": "schemaxis.adaptors.qgis.adaptor",
  "declarations": "schemaxis.adaptors.qgis.adaptor:DECLARATIONS",
  "runtimeFamily": "3.x/4.x",
  "executables": [],
  "execution": "Isolated QGIS Python: bounded 2D vector geometry, typed attribute selection and grouped summary table side products with fresh project readback",
  "keywords": [
    "GIS",
    "geospatial",
    "maps",
    "infrastructure",
    "GeoPackage",
    "GeoJSON"
  ],
  "executionCapabilities": {
    "modes": [
      "process"
    ],
    "mpi": false
  },
  "consoleTemplate": {
    "version": "schemaxis.qgis/1",
    "nodes": [],
    "output": null
  },
  "consoleOutput": true,
  "consoleCapabilities": {
    "authoredSessions": true,
    "multipleDocuments": true,
    "liveGeometry": false,
    "imagePixelReferences": true,
    "nativeEditReverseSync": false
  },
  "cliOptions": [
    {
      "flag": "--qgis",
      "dest": "qgis",
      "help": "Python executable/launcher configured for QGIS"
    }
  ],
  "routes": {
    "schemaxis.qgis/1": {
      "module": "schemaxis.adaptors.qgis.adaptor",
      "compose": true,
      "expand": "composition",
      "schema": "schemaxis.adaptors.qgis.adaptor:schema",
      "schemaName": "qgis",
      "workflow": true,
      "scheduled": true,
      "acceptedArtifacts": [
        "geospatialVector"
      ],
      "hooks": {
        "reusableInputs": "schemaxis.adaptors.qgis.adaptor:reusableInputs",
        "resources": "schemaxis.adaptors.qgis.adaptor:resources"
      }
    }
  },
  "capabilities": "schemaxis.adaptors.qgis.capabilities:catalogue"
}
