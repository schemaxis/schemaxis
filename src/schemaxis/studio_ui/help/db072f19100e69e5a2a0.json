{"id":"db072f19100e69e5a2a0","title":"blender-node-groups.json","source":"examples/schemaxis/blender-node-groups.json","format":"json","body":"{\n  \"version\": \"schemaxis.blender.production/1\",\n  \"id\": \"reusable-node-groups\",\n  \"prepareOnly\": false,\n  \"size\": [\n    64,\n    64\n  ],\n  \"render\": {\n    \"samples\": 2,\n    \"threads\": 1\n  },\n  \"production\": {\n    \"frameStart\": 1,\n    \"frameEnd\": 25,\n    \"currentFrame\": 1,\n    \"units\": \"millimetres\",\n    \"objects\": [\n      {\n        \"id\": \"housing\",\n        \"kind\": \"mesh\",\n        \"material\": \"finish\",\n        \"vertices\": [\n          [\n            -40,\n            -25,\n            0\n          ],\n          [\n            40,\n            -25,\n            0\n          ],\n          [\n            40,\n            25,\n            0\n          ],\n          [\n            -40,\n            25,\n            0\n          ],\n          [\n            -40,\n            -25,\n            20\n          ],\n          [\n            40,\n            -25,\n            20\n          ],\n          [\n            40,\n            25,\n            20\n          ],\n          [\n            -40,\n            25,\n            20\n          ]\n        ],\n        \"faces\": [\n          [\n            3,\n            2,\n            1,\n            0\n          ],\n          [\n            4,\n            5,\n            6,\n            7\n          ],\n          [\n            0,\n            1,\n            5,\n            4\n          ],\n          [\n            1,\n            2,\n            6,\n            5\n          ],\n          [\n            2,\n            3,\n            7,\n            6\n          ],\n          [\n            3,\n            0,\n            4,\n            7\n          ]\n        ]\n      },\n      {\n        \"id\": \"anchor\",\n        \"kind\": \"empty\"\n      },\n      {\n        \"id\": \"otherAnchor\",\n        \"kind\": \"empty\"\n      }\n    ],\n    \"materialGraphs\": [\n      {\n        \"id\": \"finish\",\n        \"nodes\": [\n          {\n            \"id\": \"group\",\n            \"kind\": \"group\",\n            \"group\": \"Surface\",\n            \"values\": {\n              \"tint\": [\n                0.7,\n                0.1,\n                0.2,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"output\",\n            \"kind\": \"output\"\n          }\n        ],\n        \"links\": [\n          {\n            \"from\": {\n              \"node\": \"group\",\n              \"socket\": \"surface\"\n            },\n            \"to\": {\n              \"node\": \"output\",\n              \"socket\": \"surface\"\n            }\n          }\n        ]\n      }\n    ],\n    \"intents\": [],\n    \"renderFrames\": [],\n    \"exports\": [\n      {\n        \"id\": \"lifted\",\n        \"format\": \"ply\",\n        \"objects\": [\n          \"housing\"\n        ]\n      }\n    ],\n    \"nodeGroups\": [\n      {\n        \"id\": \"Surface\",\n        \"family\": \"material\",\n        \"inputs\": [\n          {\n            \"id\": \"tint\",\n            \"kind\": \"colour\",\n            \"default\": [\n              0.1,\n              0.4,\n              0.7,\n              1\n            ]\n          },\n          {\n            \"id\": \"roughness\",\n            \"kind\": \"number\",\n            \"default\": 0.3,\n            \"minimum\": 0,\n            \"maximum\": 1\n          }\n        ],\n        \"outputs\": [\n          {\n            \"id\": \"surface\",\n            \"kind\": \"shader\"\n          }\n        ],\n        \"nodes\": [\n          {\n            \"id\": \"input\",\n            \"kind\": \"input\"\n          },\n          {\n            \"id\": \"pbr\",\n            \"kind\": \"principled\"\n          },\n          {\n            \"id\": \"output\",\n            \"kind\": \"output\"\n          }\n        ],\n        \"links\": [\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"tint\"\n            },\n            \"to\": {\n              \"node\": \"pbr\",\n              \"socket\": \"colour\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"roughness\"\n            },\n            \"to\": {\n              \"node\": \"pbr\",\n              \"socket\": \"roughness\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"pbr\",\n              \"socket\": \"shader\"\n            },\n            \"to\": {\n              \"node\": \"output\",\n              \"socket\": \"surface\"\n            }\n          }\n        ]\n      },\n      {\n        \"id\": \"Lift\",\n        \"family\": \"geometry\",\n        \"inputs\": [\n          {\n            \"id\": \"shape\",\n            \"kind\": \"geometry\"\n          },\n          {\n            \"id\": \"lift\",\n            \"kind\": \"vector\",\n            \"default\": [\n              0,\n              0,\n              3\n            ]\n          },\n          {\n            \"id\": \"referenceObject\",\n            \"kind\": \"object\",\n            \"default\": \"anchor\"\n          },\n          {\n            \"id\": \"referenceMaterial\",\n            \"kind\": \"material\",\n            \"default\": \"finish\"\n          },\n          {\n            \"id\": \"twist\",\n            \"kind\": \"rotation\",\n            \"default\": [\n              0,\n              0,\n              0\n            ]\n          }\n        ],\n        \"outputs\": [\n          {\n            \"id\": \"result\",\n            \"kind\": \"geometry\"\n          }\n        ],\n        \"nodes\": [\n          {\n            \"id\": \"input\",\n            \"kind\": \"input\"\n          },\n          {\n            \"id\": \"move\",\n            \"kind\": \"transform\"\n          },\n          {\n            \"id\": \"output\",\n            \"kind\": \"output\"\n          }\n        ],\n        \"links\": [\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"shape\"\n            },\n            \"to\": {\n              \"node\": \"move\",\n              \"socket\": \"geometry\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"lift\"\n            },\n            \"to\": {\n              \"node\": \"move\",\n              \"socket\": \"translation\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"move\",\n              \"socket\": \"geometry\"\n            },\n            \"to\": {\n              \"node\": \"output\",\n              \"socket\": \"result\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"twist\"\n            },\n            \"to\": {\n              \"node\": \"move\",\n              \"socket\": \"rotation\"\n            }\n          }\n        ]\n      },\n      {\n        \"id\": \"Grade\",\n        \"family\": \"compositor\",\n        \"inputs\": [\n          {\n            \"id\": \"image\",\n            \"kind\": \"image\"\n          },\n          {\n            \"id\": \"exposure\",\n            \"kind\": \"number\",\n            \"default\": -1\n          }\n        ],\n        \"outputs\": [\n          {\n            \"id\": \"image\",\n            \"kind\": \"image\"\n          }\n        ],\n        \"nodes\": [\n          {\n            \"id\": \"input\",\n            \"kind\": \"input\"\n          },\n          {\n            \"id\": \"exposure\",\n            \"kind\": \"exposure\"\n          },\n          {\n            \"id\": \"output\",\n            \"kind\": \"output\"\n          }\n        ],\n        \"links\": [\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"image\"\n            },\n            \"to\": {\n              \"node\": \"exposure\",\n              \"socket\": \"image\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"exposure\"\n            },\n            \"to\": {\n              \"node\": \"exposure\",\n              \"socket\": \"exposure\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"exposure\",\n              \"socket\": \"image\"\n            },\n            \"to\": {\n              \"node\": \"output\",\n              \"socket\": \"image\"\n            }\n          }\n        ]\n      },\n      {\n        \"id\": \"LiftTwice\",\n        \"family\": \"geometry\",\n        \"inputs\": [\n          {\n            \"id\": \"shape\",\n            \"kind\": \"geometry\"\n          },\n          {\n            \"id\": \"lift\",\n            \"kind\": \"vector\",\n            \"default\": [\n              0,\n              0,\n              2.5\n            ]\n          }\n        ],\n        \"outputs\": [\n          {\n            \"id\": \"result\",\n            \"kind\": \"geometry\"\n          }\n        ],\n        \"nodes\": [\n          {\n            \"id\": \"input\",\n            \"kind\": \"input\"\n          },\n          {\n            \"id\": \"first\",\n            \"kind\": \"group\",\n            \"group\": \"Lift\"\n          },\n          {\n            \"id\": \"second\",\n            \"kind\": \"group\",\n            \"group\": \"Lift\"\n          },\n          {\n            \"id\": \"output\",\n            \"kind\": \"output\"\n          }\n        ],\n        \"links\": [\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"shape\"\n            },\n            \"to\": {\n              \"node\": \"first\",\n              \"socket\": \"shape\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"first\",\n              \"socket\": \"result\"\n            },\n            \"to\": {\n              \"node\": \"second\",\n              \"socket\": \"shape\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"lift\"\n            },\n            \"to\": {\n              \"node\": \"first\",\n              \"socket\": \"lift\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"lift\"\n            },\n            \"to\": {\n              \"node\": \"second\",\n              \"socket\": \"lift\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"second\",\n              \"socket\": \"result\"\n            },\n            \"to\": {\n              \"node\": \"output\",\n              \"socket\": \"result\"\n            }\n          }\n        ]\n      }\n    ],\n    \"geometryGraphs\": [\n      {\n        \"id\": \"lifted\",\n        \"nodes\": [\n          {\n            \"id\": \"input\",\n            \"kind\": \"input\"\n          },\n          {\n            \"id\": \"lift\",\n            \"kind\": \"group\",\n            \"group\": \"LiftTwice\",\n            \"values\": {\n              \"lift\": [\n                0,\n                0,\n                2.5\n              ]\n            }\n          },\n          {\n            \"id\": \"output\",\n            \"kind\": \"output\"\n          }\n        ],\n        \"links\": [\n          {\n            \"from\": {\n              \"node\": \"input\",\n              \"socket\": \"geometry\"\n            },\n            \"to\": {\n              \"node\": \"lift\",\n              \"socket\": \"shape\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"lift\",\n              \"socket\": \"result\"\n            },\n            \"to\": {\n              \"node\": \"output\",\n              \"socket\": \"geometry\"\n            }\n          }\n        ]\n      }\n    ],\n    \"geometryBindings\": [\n      {\n        \"object\": \"housing\",\n        \"graph\": \"lifted\"\n      }\n    ],\n    \"compositor\": {\n      \"id\": \"graded\",\n      \"nodes\": [\n        {\n          \"id\": \"render\",\n          \"kind\": \"render\"\n        },\n        {\n          \"id\": \"grade\",\n          \"kind\": \"group\",\n          \"group\": \"Grade\"\n        },\n        {\n          \"id\": \"output\",\n          \"kind\": \"output\"\n        }\n      ],\n      \"links\": [\n        {\n          \"from\": {\n            \"node\": \"render\",\n            \"socket\": \"image\"\n          },\n          \"to\": {\n            \"node\": \"grade\",\n            \"socket\": \"image\"\n          }\n        },\n        {\n          \"from\": {\n            \"node\": \"grade\",\n            \"socket\": \"image\"\n          },\n          \"to\": {\n            \"node\": \"output\",\n            \"socket\": \"image\"\n          }\n        }\n      ]\n    }\n  }\n}\n","headings":[],"links":{}}
