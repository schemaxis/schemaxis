{"id":"7b904e377003e3b6a2fe","title":"blender-render-groups.json","source":"examples/schemaxis/blender-render-groups.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"execution\": {\n    \"maxWorkers\": 2,\n    \"cpus\": 4,\n    \"memoryMB\": 4096,\n    \"gpus\": 0\n  },\n  \"operations\": [\n    {\n      \"id\": \"prepare\",\n      \"document\": {\n        \"version\": \"schemaxis.blender/1\",\n        \"nodes\": [\n          {\n            \"id\": \"paint\",\n            \"filter\": \"material\",\n            \"options\": {\n              \"colour\": [\n                0.1,\n                0.4,\n                0.8,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"box\",\n            \"filter\": \"cube\",\n            \"inputs\": {\n              \"material\": \"paint\"\n            }\n          },\n          {\n            \"id\": \"rounded\",\n            \"filter\": \"bevel\",\n            \"inputs\": {\n              \"input\": \"box\"\n            },\n            \"options\": {\n              \"width\": 0.15,\n              \"segments\": 4\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"main\",\n            \"visible\": [\n              \"rounded\"\n            ],\n            \"prepareOnly\": true,\n            \"render\": {\n              \"threads\": 2,\n              \"samples\": 8\n            },\n            \"images\": [\n              {\n                \"id\": \"view\",\n                \"size\": [\n                  320,\n                  240\n                ],\n                \"cameras\": [\n                  {\n                    \"direction\": [\n                      1,\n                      -2,\n                      1\n                    ]\n                  }\n                ]\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"front\",\n      \"document\": {\n        \"version\": \"schemaxis.blender.render/1\",\n        \"sceneFile\": {\n          \"$artifact\": \"prepare\",\n          \"index\": 0\n        },\n        \"size\": [\n          320,\n          240\n        ],\n        \"render\": {\n          \"threads\": 2,\n          \"samples\": 16\n        },\n        \"cameras\": [\n          {\n            \"direction\": [\n              1,\n              -2,\n              1\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"back\",\n      \"document\": {\n        \"version\": \"schemaxis.blender.render/1\",\n        \"sceneFile\": {\n          \"$artifact\": \"prepare\",\n          \"index\": 0\n        },\n        \"size\": [\n          320,\n          240\n        ],\n        \"render\": {\n          \"threads\": 2,\n          \"samples\": 16\n        },\n        \"cameras\": [\n          {\n            \"direction\": [\n              -1,\n              2,\n              1\n            ]\n          }\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
