{"id":"1646bbb32c3a34950d6c","title":"freecad-gmsh-paraview.json","source":"examples/schemaxis/freecad-gmsh-paraview.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"cad\",\n      \"document\": {\n        \"version\": \"schemaxis.freecad/1\",\n        \"units\": \"mm\",\n        \"nodes\": [\n          {\n            \"id\": \"body\",\n            \"filter\": \"box\",\n            \"options\": {\n              \"length\": 20,\n              \"width\": 10,\n              \"height\": 5\n            }\n          }\n        ],\n        \"output\": \"body\"\n      }\n    },\n    {\n      \"id\": \"mesh\",\n      \"document\": {\n        \"version\": \"schemaxis.gmsh/1\",\n        \"units\": \"mm\",\n        \"nodes\": [\n          {\n            \"id\": \"solid\",\n            \"filter\": \"readSTEP\",\n            \"options\": {\n              \"file\": {\n                \"$artifact\": \"cad\",\n                \"index\": 0\n              }\n            }\n          },\n          {\n            \"id\": \"mesh\",\n            \"filter\": \"tetrahedral\",\n            \"inputs\": {\n              \"input\": \"solid\"\n            },\n            \"options\": {\n              \"size\": 2.5,\n              \"volumeName\": \"part\",\n              \"boundaryName\": \"outside\",\n              \"volumeTolerance\": 1e-06\n            }\n          }\n        ],\n        \"output\": \"mesh\"\n      }\n    },\n    {\n      \"id\": \"inspect\",\n      \"document\": {\n        \"version\": \"schemaxis/1\",\n        \"nodes\": [\n          {\n            \"id\": \"volume\",\n            \"filter\": \"readUnstructuredGrid\",\n            \"options\": {\n              \"files\": [\n                {\n                  \"$artifact\": \"mesh\",\n                  \"index\": 1\n                }\n              ]\n            }\n          },\n          {\n            \"id\": \"measures\",\n            \"filter\": \"cellSize\",\n            \"inputs\": {\n              \"input\": \"volume\"\n            }\n          },\n          {\n            \"id\": \"surface\",\n            \"filter\": \"readUnstructuredGrid\",\n            \"options\": {\n              \"files\": [\n                {\n                  \"$artifact\": \"mesh\",\n                  \"index\": 2\n                }\n              ]\n            }\n          },\n          {\n            \"id\": \"integral\",\n            \"filter\": \"integrate\",\n            \"inputs\": {\n              \"input\": \"volume\"\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"mesh\",\n            \"geometry\": [\n              \"measures\",\n              \"surface\",\n              \"integral\"\n            ]\n          }\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
