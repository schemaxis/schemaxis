{"id":"c8ee750101f193502dff","title":"blender-to-paraview.json","source":"examples/schemaxis/expanded/blender-to-paraview.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"plyImport\",\n      \"execution\": {\n        \"threads\": 4,\n        \"memoryMB\": 2048\n      },\n      \"document\": {\n        \"version\": \"schemaxis.blender/1\",\n        \"nodes\": [\n          {\n            \"id\": \"paint\",\n            \"filter\": \"material\",\n            \"options\": {\n              \"colour\": [\n                0.06,\n                0.27,\n                0.42,\n                1\n              ],\n              \"metallic\": 0.35,\n              \"roughness\": 0.3\n            }\n          },\n          {\n            \"id\": \"ply\",\n            \"filter\": \"readPLY\",\n            \"options\": {\n              \"file\": \"examples/schemaxis/expanded/tetrahedron.ply\",\n              \"scale\": 2\n            }\n          },\n          {\n            \"id\": \"out\",\n            \"filter\": \"assignMaterial\",\n            \"inputs\": {\n              \"input\": \"ply\",\n              \"material\": \"paint\"\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"mesh\",\n            \"visible\": [\n              \"out\"\n            ],\n            \"meshes\": [\n              \"out\"\n            ],\n            \"render\": {\n              \"threads\": 4,\n              \"samples\": 24,\n              \"denoise\": true\n            },\n            \"images\": [\n              {\n                \"id\": \"view\",\n                \"size\": [\n                  640,\n                  480\n                ],\n                \"cameras\": [\n                  {\n                    \"direction\": [\n                      1,\n                      -2,\n                      1.3\n                    ]\n                  }\n                ]\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"measure\",\n      \"document\": {\n        \"version\": \"schemaxis/1\",\n        \"nodes\": [\n          {\n            \"id\": \"stl\",\n            \"filter\": \"readSTL\",\n            \"options\": {\n              \"files\": [\n                {\n                  \"$artifact\": \"plyImport\",\n                  \"index\": 1\n                }\n              ]\n            }\n          },\n          {\n            \"id\": \"measures\",\n            \"filter\": \"cellSize\",\n            \"inputs\": {\n              \"input\": \"stl\"\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"mesh\",\n            \"geometry\": [\n              \"measures\"\n            ]\n          }\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
