{"id":"249e76f9237ccc70cc4b","title":"oracle-report-lines.json","source":"examples/schemaxis/oracle-report-lines.json","format":"json","body":"{\n  \"version\": \"schemaxis.oracle/1\",\n  \"operation\": \"report\",\n  \"connection\": {\"profile\": \"free_local\"},\n  \"tables\": [\n    {\n      \"name\": \"customers\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"name\", \"type\": \"varchar2\", \"length\": 40},\n        {\"name\": \"region\", \"type\": \"varchar2\", \"length\": 12, \"nullable\": true},\n        {\"name\": \"credit\", \"type\": \"number\", \"precision\": 12, \"scale\": 2}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"source\": {\"path\": \"/replace/with/customers.json\"}\n    },\n    {\n      \"name\": \"orders\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"customer_id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0, \"nullable\": true},\n        {\"name\": \"placed\", \"type\": \"date\"},\n        {\"name\": \"total\", \"type\": \"number\", \"precision\": 12, \"scale\": 2, \"nullable\": true}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"foreignKeys\": [{\"columns\": [\"customer_id\"], \"table\": \"customers\", \"references\": [\"id\"], \"onDelete\": \"setNull\"}],\n      \"source\": {\"path\": \"/replace/with/orders.json\"}\n    },\n    {\n      \"name\": \"order_lines\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"order_id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"sku\", \"type\": \"varchar2\", \"length\": 12},\n        {\"name\": \"quantity\", \"type\": \"number\", \"precision\": 6, \"scale\": 0},\n        {\"name\": \"unit_price\", \"type\": \"number\", \"precision\": 10, \"scale\": 2},\n        {\"name\": \"packed_at\", \"type\": \"timestampTz\", \"fraction\": 3, \"nullable\": true}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"foreignKeys\": [{\"columns\": [\"order_id\"], \"table\": \"orders\", \"references\": [\"id\"], \"onDelete\": \"cascade\"}],\n      \"source\": {\"path\": \"/replace/with/order_lines.csv\", \"format\": \"csv\"}\n    }\n  ],\n  \"report\": {\n    \"selects\": [\n      {\n        \"from\": {\"table\": \"orders\", \"alias\": \"o\"},\n        \"joins\": [{\"type\": \"inner\", \"table\": \"order_lines\", \"alias\": \"l\", \"on\": [{\"left\": \"o.id\", \"right\": \"l.order_id\"}]}],\n        \"computed\": [{\"name\": \"line_total\", \"function\": \"multiply\", \"arguments\": [{\"column\": \"l.quantity\"}, {\"column\": \"l.unit_price\"}]}],\n        \"groupBy\": [{\"column\": \"o.id\"}],\n        \"measures\": [\n          {\"name\": \"lines\", \"function\": \"countAll\"},\n          {\"name\": \"units\", \"function\": \"sum\", \"argument\": {\"column\": \"l.quantity\"}},\n          {\"name\": \"amount\", \"function\": \"sum\", \"argument\": {\"derived\": \"line_total\"}}\n        ],\n        \"conditions\": [{\"name\": \"big\", \"terms\": [{\"left\": {\"measure\": \"amount\"}, \"operator\": \"greaterThan\", \"right\": {\"literal\": {\"type\": \"number\", \"value\": \"90\"}}}]}],\n        \"having\": \"big\",\n        \"columns\": [\n          {\"name\": \"order_id\", \"operand\": {\"column\": \"o.id\"}},\n          {\"name\": \"lines\", \"operand\": {\"measure\": \"lines\"}},\n          {\"name\": \"units\", \"operand\": {\"measure\": \"units\"}},\n          {\"name\": \"amount\", \"operand\": {\"measure\": \"amount\"}}\n        ]\n      }\n    ],\n    \"windows\": [{\"name\": \"position\", \"function\": \"rank\", \"orderBy\": [{\"column\": \"amount\", \"direction\": \"descending\"}]}],\n    \"orderBy\": [{\"column\": \"position\"}]\n  }\n}\n","headings":[],"links":{}}
