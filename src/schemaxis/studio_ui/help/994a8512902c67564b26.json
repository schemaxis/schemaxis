{"id":"994a8512902c67564b26","title":"blender-image-preview.json","source":"examples/schemaxis/blender-image-preview.json","format":"json","body":"{\n  \"version\": \"schemaxis.blender.production/1\",\n  \"id\": \"scientific-image-preview\",\n  \"size\": [\n    32,\n    32\n  ],\n  \"cameras\": [\n    {\n      \"direction\": [\n        0,\n        0,\n        1\n      ],\n      \"up\": [\n        0,\n        1,\n        0\n      ],\n      \"scale\": 2\n    }\n  ],\n  \"render\": {\n    \"threads\": 2,\n    \"renderer\": {\n      \"kind\": \"workbench\",\n      \"lighting\": {\n        \"kind\": \"flat\"\n      },\n      \"colourSource\": {\n        \"kind\": \"texture\"\n      },\n      \"antiAliasing\": \"OFF\"\n    },\n    \"colourManagement\": {\n      \"view\": {\n        \"kind\": \"standard\"\n      }\n    }\n  },\n  \"production\": {\n    \"images\": [\n      {\n        \"id\": \"fieldImage\",\n        \"file\": \"examples/schemaxis/blender-image-preview.png\",\n        \"colourSpace\": \"sRGB\",\n        \"alphaMode\": \"straight\",\n        \"pack\": true\n      }\n    ],\n    \"objects\": [\n      {\n        \"id\": \"panel\",\n        \"kind\": \"mesh\",\n        \"vertices\": [\n          [\n            -1,\n            -1,\n            0\n          ],\n          [\n            1,\n            -1,\n            0\n          ],\n          [\n            1,\n            1,\n            0\n          ],\n          [\n            -1,\n            1,\n            0\n          ]\n        ],\n        \"faces\": [\n          [\n            0,\n            1,\n            2,\n            3\n          ]\n        ],\n        \"material\": \"fieldSurface\"\n      }\n    ],\n    \"materialGraphs\": [\n      {\n        \"id\": \"fieldSurface\",\n        \"viewportColour\": [\n          0.2,\n          0.03,\n          0.06\n        ],\n        \"displayTexture\": {\n          \"kind\": \"image\",\n          \"image\": \"fieldImage\"\n        },\n        \"nodes\": [\n  