{"id":"a8ddebcb36920a45aa25","title":"oracle-mutate-transfer.json","source":"examples/schemaxis/oracle-mutate-transfer.json","format":"json","body":"{\n  \"version\": \"schemaxis.oracle/1\",\n  \"operation\": \"mutate\",\n  \"connection\": {\"profile\": \"free_local\"},\n  \"tables\": [\n    {\n      \"name\": \"accounts\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"owner\", \"type\": \"varchar2\", \"length\": 20},\n        {\"name\": \"balance\", \"type\": \"number\", \"precision\": 12, \"scale\": 2}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"unique\": [{\"columns\": [\"owner\"]}],\n      \"checks\": [\n        {\"name\": \"solvent\", \"terms\": [{\"left\": {\"column\": \"accounts.balance\"}, \"operator\": \"greaterOrEqual\", \"right\": {\"literal\": {\"type\": \"number\", \"value\": \"0\"}}}]}\n      ],\n      \"source\": {\"path\": \"/replace/with/accounts.json\"}\n    }\n  ],\n  \"transaction\": {\n    \"steps\": [\n      {\n        \"kind\": \"update\",\n        \"table\": \"accounts\",\n        \"computed\": [{\"name\": \"debited\", \"function\": \"subtract\", \"arguments\": [{\"column\": \"accounts.balance\"}, {\"literal\": {\"type\": \"number\", \"value\": \"25\"}}]}],\n        \"conditions\": [{\"name\": \"payer\", \"terms\": [{\"left\": {\"column\": \"accounts.id\"}, \"operator\": \"equals\", \"right\": {\"literal\": {\"type\": \"number\", \"value\": \"1\"}}}]}],\n        \"set\": [{\"column\": \"balance\", \"value\": {\"derived\": \"debited\"}}],\n        \"where\": \"payer\",\n        \"expectRows\": 1\n      },\n      {\"kind\": \"savepoint\", \"name\": \"after_debit\"},\n      {\n        \"kind\": \"update\",\n        \"table\": \"accounts\",\n        \"computed\": [{\"name\": \"credited\", \"function\": \"add\", \"arguments\": [{\"column\": \"accounts.balance\"}, {\"literal\": {\"type\": \"number\", \"value\": \"25\"}}]}],\n        \"conditions\": [{\"name\": \"payee\", \"terms\": [{\"left\": {\"column\": \"accounts.id\"}, \"operator\": \"equals\", \"right\": {\"literal\": {\"type\": \"number\", \"value\": \"2\"}}}]}],\n        \"set\": [{\"column\": \"balance\", \"value\": {\"derived\": \"credited\"}}],\n        \"where\": \"payee\",\n        \"expectRows\": 1\n      },\n      {\"kind\": \"insert\", \"table\": \"accounts\", \"columns\": [\"id\", \"owner\", \"balance\"], \"rows\": [[4, \"dave\", \"10.00\"]], \"expectRows\": 1},\n      {\"kind\": \"merge\", \"table\": \"accounts\", \"columns\": [\"id\", \"owner\", \"balance\"], \"keys\": [\"id\"], \"rows\": [[3, \"carol\", \"5.00\"], [5, \"erin\", \"1.00\"]], \"expectRows\": 2},\n      {\n        \"kind\": \"check\",\n        \"table\": \"accounts\",\n        \"conditions\": [{\"name\": \"solvent_rows\", \"terms\": [{\"left\": {\"column\": \"accounts.balance\"}, \"operator\": \"greaterOrEqual\", \"right\": {\"literal\": {\"type\": \"number\", \"value\": \"0\"}}}]}],\n        \"where\": \"solvent_rows\",\n        \"expectRows\": 5\n      }\n    ],\n    \"finish\": \"commit\"\n  }\n}\n","headings":[],"links":{}}
