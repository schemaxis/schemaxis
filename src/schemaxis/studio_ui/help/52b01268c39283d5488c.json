{"id":"52b01268c39283d5488c","title":"mupdf-to-ffmpeg.json","source":"examples/schemaxis/mupdf-to-ffmpeg.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"page\",\n      \"document\": {\n        \"version\": \"schemaxis.mupdf/1\",\n        \"operation\": \"review\",\n        \"source\": \"/replace/with/review.pdf\",\n        \"pages\": [\n          1\n        ],\n        \"dpi\": 72,\n        \"rotation\": 0\n      }\n    },\n    {\n      \"id\": \"hold\",\n      \"document\": {\n        \"version\": \"schemaxis.ffmpeg/1\",\n        \"nodes\": [\n          {\n            \"id\": \"video\",\n            \"filter\": \"encodeFrames\",\n            \"options\": {\n              \"files\": [\n                {\n                  \"$artifact\": \"page\",\n                  \"index\": 0\n                },\n                {\n                  \"$artifact\": \"page\",\n                  \"index\": 0\n                }\n              ],\n              \"fps\": 2,\n              \"codec\": \"ffv1\",\n              \"threads\": 1\n            }\n          }\n        ],\n        \"deliverable\": {\n          \"frames\": 2,\n          \"durationSeconds\": 1,\n          \"maxMeanRGBError\": 0\n        }\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
