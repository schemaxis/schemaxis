{"id":"de7bc31c2542b52d1d00","title":"sqlite-empty.json","source":"examples/schemaxis/sqlite-empty.json","format":"json","body":"{\n  \"version\": \"schemaxis.sqlite/1\",\n  \"operation\": \"summarise\",\n  \"tables\": [\n    {\n      \"name\": \"departments\",\n      \"source\": \"/replace/with/departments.json\",\n      \"columns\": [\n        {\n          \"name\": \"id\",\n          \"type\": \"INTEGER\"\n        },\n        {\n          \"name\": \"region\",\n          \"type\": \"TEXT\",\n          \"nullable\": true\n        }\n      ],\n      \"primaryKey\": \"id\"\n    },\n    {\n      \"name\": \"sales\",\n      \"source\": \"/replace/with/sales.json\",\n      \"columns\": [\n        {\n          \"name\": \"id\",\n          \"type\": \"INTEGER\"\n        },\n        {\n          \"name\": \"department\",\n          \"type\": \"INTEGER\",\n          \"nullable\": true\n        },\n        {\n          \"name\": \"amount\",\n          \"type\": \"INTEGER\",\n          \"nullable\": true\n        }\n      ],\n      \"primaryKey\": \"id\",\n      \"foreignKeys\": [\n        {\n          \"column\": \"department\",\n          \"table\": \"departments\",\n          \"target\": \"id\"\n        }\n      ]\n    }\n  ],\n  \"from\": \"sales\",\n  \"join\": {\n    \"table\": \"departments\",\n    \"local\": \"department\",\n    \"remote\": \"id\"\n  },\n  \"where\": {\n    \"column\": \"sales.id\",\n    \"minimum\": 99\n  },\n  \"groupBy\": [\n    \"departments.region\"\n  ],\n  \"sum\": \"sales.amount\"\n}\n","headings":[],"links":{}}
