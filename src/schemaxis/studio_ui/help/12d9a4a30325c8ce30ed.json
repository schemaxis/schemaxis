{"id":"12d9a4a30325c8ce30ed","title":"oracle-report-revenue.json","source":"examples/schemaxis/oracle-report-revenue.json","format":"json","body":"{\n  \"version\": \"schemaxis.oracle/1\",\n  \"operation\": \"report\",\n  \"connection\": {\"profile\": \"free_local\"},\n  \"tables\": [\n    {\n      \"name\": \"customers\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"name\", \"type\": \"varchar2\", \"length\": 40},\n        {\"name\": \"region\", \"type\": \"varchar2\", \"length\": 12, \"nullable\": true},\n        {\"name\": \"credit\", \"type\": \"number\", \"precision\": 12, \"scale\": 2}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"checks\": [\n        {\"name\": \"credit_ok\", \"terms\": [{\"left\": {\"column\": \"customers.credit\"}, \"operator\": \"greaterOrEqual\", \"right\": {\"literal\": {\"type\": \"number\", \"value\": \"0\"}}}]}\n      ],\n      \"source\": {\"path\": \"/replace/with/customers.json\"}\n    },\n    {\n      \"name\": \"orders\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"customer_id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0, \"nullable\": true},\n        {\"name\": \"placed\", \"type\": \"date\"},\n        {\"name\": \"total\", \"type\": \"number\", \"precision\": 12, \"scale\": 2, \"nullable\": true}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"foreignKeys\": [{\"columns\": [\"customer_id\"], \"table\": \"customers\", \"references\": [\"id\"], \"onDelete\": \"setNull\"}],\n      \"source\": {\"path\": \"/replace/with/orders.json\"}\n    }\n  ],\n  \"report\": {\n    \"selects\": [\n      {\n        \"from\": {\"table\": \"customers\", \"alias\": \"c\"},\n        \"joins\": [{\"type\": \"left\", \"table\": \"orders\", \"alias\": \"o\", \"on\": [{\"left\": \"c.id\", \"right\": \"o.customer_id\"}]}],\n        \"groupBy\": [{\"column\": \"c.region\"}],\n        \"measures\": [\n          {\"name\": \"orders\", \"function\": \"count\", \"argument\": {\"column\": \"o.id\"}},\n          {\"name\": \"revenue\", \"function\": \"sum\", \"argument\": {\"column\": \"o.total\"}}\n        ],\n        \"columns\": [\n          {\"name\": \"region\", \"operand\": {\"column\": \"c.region\"}},\n          {\"name\": \"orders\", \"operand\": {\"measure\": \"orders\"}},\n          {\"name\": \"revenue\", \"operand\": {\"measure\": \"revenue\"}}\n        ]\n      }\n    ],\n    \"orderBy\": [{\"column\": \"region\"}]\n  }\n}\n","headings":[],"links":{}}
