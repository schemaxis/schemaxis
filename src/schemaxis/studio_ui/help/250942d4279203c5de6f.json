{"id":"250942d4279203c5de6f","title":"r-to-calc.json","source":"examples/schemaxis/r-to-calc.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"regression\",\n      \"document\": {\n        \"version\": \"schemaxis.r/1\",\n        \"operation\": \"linearRegression\",\n        \"predictors\": [\n          {\n            \"name\": \"temperature\",\n            \"unit\": \"degC\"\n          }\n        ],\n        \"response\": {\n          \"name\": \"reading\",\n          \"unit\": \"V\"\n        },\n        \"training\": [\n          [\n            -2,\n            6.1\n          ],\n          [\n            -1,\n            7.8\n          ],\n          [\n            1,\n            12.2\n          ],\n          [\n            2,\n            13.9\n          ]\n        ],\n        \"heldout\": [\n          [\n            0,\n            10.1\n          ],\n          [\n            3,\n            15.8\n          ]\n        ],\n        \"requirements\": [\n          {\n            \"name\": \"training_rmse\",\n            \"scope\": \"training\",\n            \"metric\": \"rmse\",\n            \"maximum\": 0.17\n          },\n          {\n            \"name\": \"heldout_error\",\n            \"scope\": \"heldout\",\n            \"metric\": \"maxAbsoluteError\",\n            \"maximum\": 0.21\n          },\n          {\n            \"name\": \"calibration_prediction\",\n            \"scope\": \"heldout\",\n            \"metric\": \"prediction\",\n            \"sampleIndex\": 0,\n            \"minimum\": 9.99,\n            \"maximum\": 10.01\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"workbook\",\n      \"document\": {\n        \"version\": \"schemaxis.calc/1\",\n        \"nodes\": [\n          {\n            \"id\": \"voltages\",\n            \"filter\": \"readCSV\",\n            \"options\": {\n              \"file\": {\n                \"$artifact\": \"regression\",\n                \"index\": 2\n              }\n            }\n          }\n        ],\n        \"requirements\": [\n          {\n            \"name\": \"residual_lower\",\n            \"type\": \"cellBounds\",\n            \"cell\": {\"sheet\": \"Summary\", \"cell\": \"E5\"},\n            \"minimum\": -0.21\n          },\n          {\n            \"name\": \"residual_upper\",\n            \"type\": \"cellBounds\",\n            \"cell\": {\"sheet\": \"Summary\", \"cell\": \"F5\"},\n            \"maximum\": 0.21\n          },\n          {\n            \"name\": \"residual_identity\",\n            \"type\": \"reconcile\",\n            \"terms\": [\n              {\"sheet\": \"Summary\", \"cell\": \"C3\", \"coefficient\": 1},\n              {\"sheet\": \"Summary\", \"cell\": \"C4\", \"coefficient\": -1},\n              {\"sheet\": \"Summary\", \"cell\": \"C5\", \"coefficient\": -1}\n            ],\n            \"target\": 0,\n            \"absoluteTolerance\": 1e-10\n          }\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
