{"id":"cebb35db7c0d7c9652cb","title":"freecad-spreadsheet-enclosure.json","source":"examples/schemaxis/freecad-spreadsheet-enclosure.json","format":"json","body":"{\n  \"version\": \"schemaxis.freecad/1\",\n  \"spreadsheet\": {\n    \"inputs\": {\n      \"width\": {\n        \"value\": 3,\n        \"minimum\": 2,\n        \"maximum\": 5,\n        \"unit\": \"cm\"\n      },\n      \"depth\": {\n        \"value\": 1,\n        \"minimum\": 0.5,\n        \"maximum\": 2,\n        \"unit\": \"in\"\n      },\n      \"wall\": {\n        \"value\": 2,\n        \"minimum\": 1,\n        \"maximum\": 3,\n        \"unit\": \"mm\"\n      },\n      \"height\": {\n        \"value\": 20,\n        \"minimum\": 10,\n        \"maximum\": 30,\n        \"unit\": \"mm\"\n      }\n    },\n    \"formulas\": {\n      \"rise\": {\n        \"terms\": {\n          \"height\": 1,\n          \"wall\": 1\n        }\n      },\n      \"span\": {\n        \"terms\": {\n          \"width\": 1,\n          \"wall\": 2\n        }\n      }\n    }\n  },\n  \"nodes\": [\n    {\n      \"id\": \"body\",\n      \"filter\": \"body\"\n    },\n    {\n      \"id\": \"outline\",\n      \"filter\": \"rectangle\",\n      \"inputs\": {\n        \"body\": \"body\"\n      },\n      \"drive\": {\n        \"width\": {\n          \"terms\": {\n            \"span\": 1\n          }\n        },\n        \"height\": {\n          \"terms\": {\n            \"depth\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"stock\",\n      \"filter\": \"pad\",\n      \"inputs\": {\n        \"body\": \"body\",\n        \"profile\": \"outline\"\n      },\n      \"drive\": {\n        \"length\": {\n          \"terms\": {\n            \"rise\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"housing\",\n      \"filter\": \"shell\",\n      \"options\": {\n        \"openings\": [\n          {\n            \"face\": \"top\"\n          }\n        ]\n      },\n      \"inputs\": {\n        \"base\": \"stock\"\n      },\n      \"drive\": {\n        \"thickness\": {\n          \"terms\": {\n            \"wall\": 1\n          }\n        }\n      }\n    }\n  ],\n  \"output\": \"housing\"\n}\n","headings":[],"links":{}}
