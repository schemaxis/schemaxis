{"id":"b005dfc48506b02d31fc","title":"freecad-placed-body.json","source":"examples/schemaxis/freecad-placed-body.json","format":"json","body":"{\n  \"version\": \"schemaxis.freecad/1\",\n  \"parameters\": {\n    \"thickness\": {\n      \"kind\": \"length\",\n      \"value\": 7,\n      \"minimum\": 5,\n      \"maximum\": 11\n    }\n  },\n  \"nodes\": [\n    {\n      \"id\": \"part\",\n      \"filter\": \"body\",\n      \"options\": {\n        \"frame\": {\n          \"origin\": [\n            7,\n            -11,\n            13\n          ],\n          \"xAxis\": [\n            0.6,\n            0.8,\n            0\n          ],\n          \"normal\": [\n            0.48,\n            -0.36,\n            0.8\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"outline\",\n      \"filter\": \"rectangle\",\n      \"options\": {\n        \"width\": 24,\n        \"height\": 16,\n        \"frame\": {\n          \"origin\": [\n            3,\n            4,\n            5\n          ],\n          \"xAxis\": [\n            0,\n            1,\n            0\n          ],\n          \"normal\": [\n            1,\n            0,\n            0\n          ]\n        }\n      },\n      \"inputs\": {\n        \"body\": \"part\"\n      }\n    },\n    {\n      \"id\": \"slab\",\n      \"filter\": \"pad\",\n      \"inputs\": {\n        \"body\": \"part\",\n        \"profile\": \"outline\"\n      },\n      \"drive\": {\n        \"length\": {\n          \"terms\": {\n            \"thickness\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"bore\",\n      \"filter\": \"circle\",\n      \"options\": {\n        \"radius\": 2,\n        \"centre\": [\n          3,\n          2\n        ],\n        \"frame\": {\n          \"origin\": [\n            3,\n            4,\n            5\n          ],\n          \"xAxis\": [\n            0,\n            1,\n            0\n          ],\n          \"normal\": [\n            1,\n            0,\n            0\n          ]\n        }\n      },\n      \"inputs\": {\n        \"body\": \"part\"\n      }\n    },\n    {\n      \"id\": \"finished\",\n      \"filter\": \"pocket\",\n      \"options\": {\n        \"direction\": \"forward\"\n      },\n      \"inputs\": {\n        \"base\": \"slab\",\n        \"profile\": \"bore\"\n      }\n    }\n  ],\n  \"output\": \"finished\",\n  \"measurements\": [\n    {\n      \"id\": \"featureCentre\",\n      \"node\": \"finished\",\n      \"quantity\": \"centreOfMass\"\n    },\n    {\n      \"id\": \"featureBounds\",\n      \"node\": \"finished\",\n      \"quantity\": \"bounds\"\n    },\n    {\n      \"id\": \"intermediateCentre\",\n      \"node\": \"slab\",\n      \"quantity\": \"centreOfMass\"\n    },\n    {\n      \"id\": \"intermediateBounds\",\n      \"node\": \"slab\",\n      \"quantity\": \"bounds\"\n    },\n    {\n      \"id\": \"worldEdges\",\n      \"node\": \"slab\",\n      \"quantity\": \"edgeCount\",\n      \"edges\": {\n        \"where\": {\n          \"parallelTo\": [\n            0.6,\n            0.8,\n            0\n          ]\n        },\n        \"expect\": 4\n      }\n    },\n    {\n      \"id\": \"worldEdgeLength\",\n      \"node\": \"slab\",\n      \"quantity\": \"totalEdgeLength\",\n      \"edges\": {\n        \"where\": {\n          \"parallelTo\": [\n            0.6,\n            0.8,\n            0\n          ]\n        },\n        \"expect\": 4\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
