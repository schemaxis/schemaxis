{"id":"cb17355f85013d6769fd","title":"freecad-part-design.json","source":"examples/schemaxis/freecad-part-design.json","format":"json","body":"{\n  \"version\": \"schemaxis.freecad/1\",\n  \"parameters\": {\n    \"width\": {\n      \"kind\": \"length\",\n      \"value\": 80,\n      \"minimum\": 60,\n      \"maximum\": 100\n    },\n    \"thickness\": {\n      \"kind\": \"length\",\n      \"value\": 5,\n      \"minimum\": 2,\n      \"maximum\": 50\n    },\n    \"boreRadius\": {\n      \"kind\": \"length\",\n      \"value\": 3,\n      \"minimum\": 2,\n      \"maximum\": 5\n    }\n  },\n  \"nodes\": [\n    {\n      \"id\": \"part\",\n      \"filter\": \"body\"\n    },\n    {\n      \"id\": \"outline\",\n      \"filter\": \"rectangle\",\n      \"inputs\": {\n        \"body\": \"part\"\n      },\n      \"options\": {\n        \"height\": 50,\n        \"plane\": \"XY\"\n      },\n      \"drive\": {\n        \"width\": {\n          \"terms\": {\n            \"width\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"slab\",\n      \"filter\": \"pad\",\n      \"inputs\": {\n        \"body\": \"part\",\n        \"profile\": \"outline\"\n      },\n      \"drive\": {\n        \"length\": {\n          \"terms\": {\n            \"thickness\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"bore\",\n      \"filter\": \"circle\",\n      \"inputs\": {\n        \"body\": \"part\"\n      },\n      \"options\": {\n        \"plane\": \"XY\",\n        \"centre\": [\n          15,\n          10\n        ]\n      },\n      \"drive\": {\n        \"radius\": {\n          \"terms\": {\n            \"boreRadius\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"finished\",\n      \"filter\": \"pocket\",\n      \"inputs\": {\n        \"base\": \"slab\",\n        \"profile\": \"bore\"\n      },\n      \"options\": {\n        \"extent\": \"throughAll\"\n      }\n    }\n  ],\n  \"output\": \"finished\",\n  \"measurements\": [\n    {\n      \"id\": \"volume\",\n      \"node\": \"finished\",\n      \"quantity\": \"volume\"\n    },\n    {\n      \"id\": \"height\",\n      \"node\": \"finished\",\n      \"quantity\": \"extentZ\"\n    }\n  ]\n}\n","headings":[],"links":{}}
