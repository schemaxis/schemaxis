{"id":"db69777b306acf22c541","title":"workflow-analytic-values.json","source":"examples/schemaxis/workflow-analytic-values.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"dimensions\": {\n    \"scale\": 0.5\n  },\n  \"operations\": [\n    {\n      \"id\": \"mesh\",\n      \"document\": {\n        \"version\": \"schemaxis.gmsh/1\",\n        \"units\": \"mm\",\n        \"nodes\": [\n          {\n            \"id\": \"solid\",\n            \"filter\": \"box\",\n            \"options\": {\n              \"size\": [\n                {\n                  \"$document\": \"/dimensions/extent\"\n                },\n                10,\n                10\n              ]\n            }\n          },\n          {\n            \"id\": \"mesh\",\n            \"filter\": \"tetrahedral\",\n            \"inputs\": {\n              \"input\": \"solid\"\n            },\n            \"options\": {\n              \"size\": {\n                \"$document\": \"/dimensions/h\"\n              },\n              \"volumeName\": \"domain\",\n              \"boundaryName\": \"boundary\",\n              \"volumeTolerance\": 1e-06\n            }\n          }\n        ],\n        \"output\": \"mesh\",\n        \"dimensions\": {\n          \"extent\": {\n            \"$analytic\": {\n              \"type\": \"values\",\n              \"values\": [\n                10,\n                12\n              ],\n              \"sync\": \"design\"\n            }\n          },\n          \"h\": {\n            \"$analytic\": {\n              \"type\": \"values\",\n              \"values\": [\n                3,\n                2\n              ],\n              \"sync\": \"design\"\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"measurements\",\n      \"document\": {\n        \"version\": \"schemaxis.octave/1\",\n        \"nodes\": [\n          {\n            \"id\": \"samples\",\n            \"filter\": \"samples\",\n            \"options\": {\n              \"x\": [\n                0,\n                1,\n                2\n              ],\n              \"y\": [\n                {\n                  \"$value\": \"mesh\",\n                  \"artifact\": 3,\n                  \"path\": \"/volume\"\n                },\n                {\n                  \"$expr\": {\n                    \"op\": \"multiply\",\n                    \"args\": [\n                      {\n                        \"$value\": \"mesh\",\n                        \"artifact\": 3,\n                        \"path\": \"/volume\"\n                      },\n                      {\n                        \"$document\": \"/dimensions/scale\",\n                        \"scope\": \"workflow\"\n                      }\n                    ]\n                  }\n                },\n                {\n                  \"$document\": \"/dimensions/h\",\n                  \"operation\": \"mesh\"\n                }\n              ]\n            }\n          }\n        ],\n        \"outputs\": [\n          \"samples\"\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
