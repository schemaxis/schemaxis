{"id":"cc41fbebc3eb47622c48","title":"qgis-attributes-variant.json","source":"examples/schemaxis/qgis-attributes-variant.json","format":"json","body":"{\n  \"version\": \"schemaxis.qgis/1\",\n  \"nodes\": [\n    {\n      \"id\": \"assets\",\n      \"filter\": \"readVector\",\n      \"options\": {\n        \"file\": \"/absolute/path/to/assets.geojson\"\n      }\n    },\n    {\n      \"id\": \"eligible\",\n      \"filter\": \"selectAttributes\",\n      \"inputs\": {\n        \"input\": \"assets\"\n      },\n      \"options\": {\n        \"idField\": \"asset_id\",\n        \"predicates\": [\n          {\n            \"field\": \"score\",\n            \"type\": \"number\",\n            \"comparison\": \"gt\",\n            \"value\": 20\n          }\n        ],\n        \"minFeatures\": 1,\n        \"maxFeatures\": 1\n      }\n    },\n    {\n      \"id\": \"regional_load\",\n      \"filter\": \"summariseAttributes\",\n      \"inputs\": {\n        \"input\": \"eligible\"\n      },\n      \"options\": {\n        \"idField\": \"asset_id\",\n        \"groupBy\": \"region\",\n        \"aggregates\": [\n          {\n            \"name\": \"assets\",\n            \"statistic\": \"count\",\n            \"units\": \"features\"\n          },\n          {\n            \"name\": \"valid_loads\",\n            \"statistic\": \"nonNullCount\",\n            \"field\": \"load_kw\",\n            \"units\": \"features\"\n          },\n          {\n            \"name\": \"total_kw\",\n            \"statistic\": \"sum\",\n            \"field\": \"load_kw\",\n            \"units\": \"kW\"\n          },\n          {\n            \"name\": \"mean_kw\",\n            \"statistic\": \"mean\",\n            \"field\": \"load_kw\",\n            \"units\": \"kW\"\n          }\n        ]\n      }\n    }\n  ],\n  \"output\": \"regional_load\",\n  \"preview\": true\n}\n","headings":[],"links":{}}
