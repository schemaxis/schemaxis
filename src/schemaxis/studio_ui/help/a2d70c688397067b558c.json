{"id":"a2d70c688397067b558c","title":"aseprite-import-variant.json","source":"examples/schemaxis/aseprite-import-variant.json","format":"json","body":"{\n  \"version\": \"schemaxis.aseprite/1\",\n  \"nodes\": [\n    {\n      \"id\": \"canvas\",\n      \"filter\": \"sprite\",\n      \"options\": {\n        \"width\": 6,\n        \"height\": 4,\n        \"durationMS\": 80\n      }\n    },\n    {\n      \"id\": \"background\",\n      \"filter\": \"rect\",\n      \"options\": {\n        \"layer\": \"base\",\n        \"x\": 0,\n        \"y\": 0,\n        \"width\": 6,\n        \"height\": 4,\n        \"colour\": [\n          20,\n          40,\n          80,\n          255\n        ]\n      },\n      \"inputs\": {\n        \"sprite\": \"canvas\"\n      }\n    },\n    {\n      \"id\": \"art\",\n      \"filter\": \"layer\",\n      \"options\": {\n        \"name\": \"art\"\n      },\n      \"inputs\": {\n        \"sprite\": \"background\"\n      }\n    },\n    {\n      \"id\": \"paint\",\n      \"filter\": \"rect\",\n      \"options\": {\n        \"layer\": \"art\",\n        \"x\": 1,\n        \"y\": 1,\n        \"width\": 3,\n        \"height\": 2,\n        \"colour\": [\n          255,\n          255,\n          255,\n          255\n        ]\n      },\n      \"inputs\": {\n        \"sprite\": \"art\"\n      }\n    },\n    {\n      \"id\": \"import\",\n      \"filter\": \"importImage\",\n      \"options\": {\n        \"source\": \"/path/to/badge-variant.png\",\n        \"width\": 3,\n        \"height\": 2,\n        \"layer\": \"art\",\n        \"x\": 0,\n        \"y\": 1\n      },\n      \"inputs\": {\n        \"sprite\": \"paint\"\n      }\n    },\n    {\n      \"id\": \"next\",\n      \"filter\": \"frame\",\n      \"options\": {\n        \"durationMS\": 240\n      },\n      \"inputs\": {\n        \"sprite\": \"import\"\n      }\n    },\n    {\n      \"id\": \"moved\",\n      \"filter\": \"importImage\",\n      \"options\": {\n        \"source\": \"/path/to/badge-variant.png\",\n        \"width\": 3,\n        \"height\": 2,\n        \"layer\": \"art\",\n        \"frame\": 2,\n        \"x\": 0,\n        \"y\": 0\n      },\n      \"inputs\": {\n        \"sprite\": \"next\"\n      }\n    },\n    {\n      \"id\": \"spark\",\n      \"filter\": \"pixel\",\n      \"options\": {\n        \"layer\": \"art\",\n        \"frame\": 2,\n        \"x\": 5,\n        \"y\": 3,\n        \"colour\": [\n          255,\n          255,\n          255,\n          255\n        ]\n      },\n      \"inputs\": {\n        \"sprite\": \"moved\"\n      }\n    },\n    {\n      \"id\": \"loop\",\n      \"filter\": \"tag\",\n      \"options\": {\n        \"name\": \"badge\",\n        \"fromFrame\": 1,\n        \"toFrame\": 2\n      },\n      \"inputs\": {\n        \"sprite\": \"spark\"\n      }\n    }\n  ],\n  \"output\": \"loop\"\n}\n","headings":[],"links":{}}
