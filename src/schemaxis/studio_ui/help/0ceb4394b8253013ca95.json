{"id":"0ceb4394b8253013ca95","title":"freecad-measured-workflow.json","source":"examples/schemaxis/freecad-measured-workflow.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"cad\",\n      \"document\": {\n        \"version\": \"schemaxis.freecad/1\",\n        \"units\": \"mm\",\n        \"nodes\": [\n          {\n            \"id\": \"blank\",\n            \"filter\": \"box\",\n            \"options\": {\n              \"length\": 20,\n              \"width\": 10,\n              \"height\": {\n                \"$analytic\": {\n                  \"type\": \"values\",\n                  \"values\": [\n                    5,\n                    7\n                  ]\n                }\n              }\n            }\n          },\n          {\n            \"id\": \"rounded\",\n            \"filter\": \"fillet\",\n            \"inputs\": {\n              \"base\": \"blank\"\n            },\n            \"options\": {\n              \"radius\": 1,\n              \"edges\": {\n                \"where\": {\n                  \"curve\": \"line\",\n                  \"parallelTo\": [\n                    0,\n                    0,\n                    1\n                  ]\n                },\n                \"expect\": 4\n              }\n            }\n          }\n        ],\n        \"output\": \"rounded\",\n        \"measurements\": [\n          {\n            \"id\": \"finishedVolume\",\n            \"node\": \"rounded\",\n            \"quantity\": \"volume\"\n          },\n          {\n            \"id\": \"finishedArea\",\n            \"node\": \"rounded\",\n            \"quantity\": \"surfaceArea\"\n          },\n          {\n            \"id\": \"height\",\n            \"node\": \"rounded\",\n            \"quantity\": \"extentZ\"\n          },\n          {\n            \"id\": \"centre\",\n            \"node\": \"rounded\",\n            \"quantity\": \"centreOfMass\"\n          },\n          {\n            \"id\": \"verticalEdgeLength\",\n            \"node\": \"blank\",\n            \"quantity\": \"totalEdgeLength\",\n            \"edges\": {\n              \"where\": {\n                \"parallelTo\": [\n                  0,\n                  0,\n                  1\n                ]\n              },\n              \"expect\": 4\n            }\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"mesh\",\n      \"document\": {\n        \"version\": \"schemaxis.gmsh/1\",\n        \"units\": \"mm\",\n        \"nodes\": [\n          {\n            \"id\": \"solid\",\n            \"filter\": \"readSTEP\",\n            \"options\": {\n              \"file\": {\n                \"$artifact\": \"cad\",\n                \"index\": 0\n              }\n            }\n          },\n          {\n            \"id\": \"mesh\",\n            \"filter\": \"tetrahedral\",\n            \"inputs\": {\n              \"input\": \"solid\"\n            },\n            \"options\": {\n              \"size\": {\n                \"$expr\": {\n                  \"op\": \"multiply\",\n                  \"args\": [\n                    {\n                      \"$value\": \"cad\",\n                      \"artifact\": 3,\n                      \"path\": \"/measurements/height/value\"\n                    },\n                    0.4\n                  ]\n                }\n              },\n              \"volumeTolerance\": 0.01\n            }\n          }\n        ],\n        \"output\": \"mesh\"\n      }\n    },\n    {\n      \"id\": \"table\",\n      \"document\": {\n        \"version\": \"schemaxis.octave/1\",\n        \"nodes\": [\n          {\n            \"id\": \"values\",\n            \"filter\": \"samples\",\n            \"options\": {\n              \"x\": [\n                0,\n                1,\n                2\n              ],\n              \"y\": [\n                {\n                  \"$value\": \"cad\",\n                  \"artifact\": 3,\n                  \"path\": \"/measurements/finishedVolume/value\"\n                },\n                {\n                  \"$value\": \"cad\",\n                  \"artifact\": 3,\n                  \"path\": \"/measurements/verticalEdgeLength/value\"\n                },\n                {\n                  \"$expr\": {\n                    \"op\": \"multiply\",\n                    \"args\": [\n                      {\n                        \"$value\": \"cad\",\n                        \"artifact\": 3,\n                        \"path\": \"/measurements/finishedVolume/value\"\n                      },\n                      0.001\n                    ]\n                  }\n                }\n              ]\n            }\n          }\n        ],\n        \"outputs\": [\n          \"values\"\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
