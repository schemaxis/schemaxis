{"id":"697d3acaf9a8a423b271","title":"freecad-driven-housing.json","source":"examples/schemaxis/freecad-driven-housing.json","format":"json","body":"{\n  \"version\": \"schemaxis.freecad/1\",\n  \"units\": \"mm\",\n  \"parameters\": {\n    \"thickness\": {\"kind\": \"length\", \"value\": 10, \"minimum\": 6, \"maximum\": 20},\n    \"bossRadius\": {\"kind\": \"length\", \"value\": 5, \"minimum\": 4, \"maximum\": 8},\n    \"bossHeight\": {\"kind\": \"length\", \"value\": 8, \"minimum\": 4, \"maximum\": 12}\n  },\n  \"nodes\": [\n    {\"id\": \"housing\", \"filter\": \"body\"},\n    {\"id\": \"outline\", \"filter\": \"rectangle\", \"options\": {\"width\": 40, \"height\": 30}, \"inputs\": {\"body\": \"housing\"}},\n    {\"id\": \"stock\", \"filter\": \"pad\", \"inputs\": {\"body\": \"housing\", \"profile\": \"outline\"}, \"drive\": {\"length\": {\"terms\": {\"thickness\": 1}}}},\n    {\"id\": \"bossProfile\", \"filter\": \"circle\", \"options\": {\"onFace\": {\"face\": \"top\"}}, \"inputs\": {\"body\": \"housing\", \"support\": \"stock\"}, \"drive\": {\"radius\": {\"terms\": {\"bossRadius\": 1}}}},\n    {\"id\": \"boss\", \"filter\": \"pad\", \"inputs\": {\"body\": \"housing\", \"profile\": \"bossProfile\", \"base\": \"stock\"}, \"drive\": {\"length\": {\"terms\": {\"bossHeight\": 1}}}},\n    {\"id\": \"boreProfile\", \"filter\": \"circle\", \"options\": {\"radius\": 2, \"onFace\": {\"face\": \"top\"}}, \"inputs\": {\"body\": \"housing\", \"support\": \"boss\"}},\n    {\"id\": \"finished\", \"filter\": \"pocket\", \"options\": {\"extent\": \"throughAll\", \"direction\": \"backward\"}, \"inputs\": {\"base\": \"boss\", \"profile\": \"boreProfile\"}}\n  ],\n  \"output\": \"finished\"\n}\n","headings":[],"links":{}}
