{"id":"5fb60edc2ebdaf7e1c47","title":"gmsh-analytic-refinement.json","source":"examples/schemaxis/gmsh-analytic-refinement.json","format":"json","body":"{\n  \"version\": \"schemaxis.gmsh/1\",\n  \"units\": \"mm\",\n  \"nodes\": [\n    {\n      \"id\": \"solid\",\n      \"filter\": \"box\",\n      \"options\": {\n        \"size\": [\n          10,\n          10,\n          10\n        ]\n      }\n    },\n    {\n      \"id\": \"mesh\",\n      \"filter\": \"tetrahedral\",\n      \"inputs\": {\n        \"input\": \"solid\"\n      },\n      \"options\": {\n        \"size\": {\n          \"$document\": \"/dimensions/initialSize\"\n        },\n        \"volumeName\": \"domain\",\n        \"boundaryName\": \"boundary\",\n        \"volumeTolerance\": 1e-06\n      }\n    }\n  ],\n  \"output\": \"mesh\",\n  \"refinement\": {\n    \"maxIterations\": 4,\n    \"reductionFactor\": 0.7,\n    \"minimumSize\": 1,\n    \"maxTetrahedra\": 20000,\n    \"requirements\": {\n      \"maximumEdgeLength\": {\n        \"$expr\": {\n          \"op\": \"multiply\",\n          \"args\": [\n            {\n              \"$document\": \"/dimensions/edgeLimit\"\n            },\n            1\n          ]\n        }\n      },\n      \"minimumMeanRatio\": 0.1\n    }\n  },\n  \"dimensions\": {\n    \"initialSize\": 3,\n    \"edgeLimit\": {\n      \"$analytic\": {\n        \"type\": \"values\",\n        \"values\": [\n          4.5,\n          3\n        ]\n      }\n    }\n  },\n  \"maxStates\": 2\n}\n","headings":[],"links":{}}
