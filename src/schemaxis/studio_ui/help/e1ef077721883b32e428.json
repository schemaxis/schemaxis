{"id":"e1ef077721883b32e428","title":"xarray-profile-plot-workflow.json","source":"examples/schemaxis/xarray-profile-plot-workflow.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"profile\",\n      \"document\": {\n        \"version\": \"schemaxis.xarray/1\",\n        \"operation\": \"reduceProfile\",\n        \"source\": \"/replace/with/xarray-cube.nc\",\n        \"variable\": {\n          \"name\": \"temperature\",\n          \"unit\": \"K\"\n        },\n        \"coordinates\": [\n          {\n            \"name\": \"time\",\n            \"unit\": \"h\"\n          },\n          {\n            \"name\": \"depth\",\n            \"unit\": \"m\"\n          },\n          {\n            \"name\": \"station\",\n            \"unit\": \"km\"\n          }\n        ],\n        \"retain\": \"depth\",\n        \"missing\": {\n          \"value\": -999.0,\n          \"policy\": \"refuse\"\n        }\n      }\n    },\n    {\n      \"id\": \"plot\",\n      \"document\": {\n        \"version\": \"schemaxis.gnuplot/1\",\n        \"operation\": \"plot\",\n        \"title\": \"Mean temperature by depth\",\n        \"source\": {\n          \"$artifact\": \"profile\",\n          \"index\": 1\n        },\n        \"columns\": [\n          {\n            \"name\": \"depth\",\n            \"unit\": \"m\"\n          },\n          {\n            \"name\": \"temperature\",\n            \"unit\": \"K\"\n          },\n          {\n            \"name\": \"validCount\",\n            \"unit\": \"count\"\n          },\n          {\n            \"name\": \"missingCount\",\n            \"unit\": \"count\"\n          }\n        ],\n        \"series\": [\n          {\n            \"label\": \"Mean temperature\",\n            \"x\": \"depth\",\n            \"y\": \"temperature\",\n            \"colour\": \"blue\"\n          }\n        ],\n        \"xAxis\": {\n          \"label\": \"Depth\",\n          \"unit\": \"m\",\n          \"range\": [\n            0,\n            30\n          ],\n          \"scale\": \"linear\"\n        },\n        \"yAxis\": {\n          \"label\": \"Temperature\",\n          \"unit\": \"K\",\n          \"range\": [\n            270,\n            300\n          ],\n          \"scale\": \"linear\"\n        }\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
