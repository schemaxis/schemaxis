{"id":"3ac915bb83dca3e80c10","title":"aseprite-animation.json","source":"examples/schemaxis/aseprite-animation.json","format":"json","body":"{\n  \"version\": \"schemaxis.aseprite/1\",\n  \"nodes\": [\n    {\"id\": \"canvas\", \"filter\": \"sprite\", \"options\": {\"width\": 16, \"height\": 16, \"durationMS\": 120}},\n    {\"id\": \"colours\", \"filter\": \"palette\", \"inputs\": {\"sprite\": \"canvas\"}, \"options\": {\"colours\": [[0,0,0,0],[20,40,80,255],[250,150,30,255],[255,255,255,255]]}},\n    {\"id\": \"background\", \"filter\": \"rect\", \"inputs\": {\"sprite\": \"colours\"}, \"options\": {\"layer\": \"base\", \"x\": 0, \"y\": 0, \"width\": 16, \"height\": 16, \"colour\": [20,40,80,255]}},\n    {\"id\": \"foreground\", \"filter\": \"layer\", \"inputs\": {\"sprite\": \"background\"}, \"options\": {\"name\": \"orb\"}},\n    {\"id\": \"orb1\", \"filter\": \"circle\", \"inputs\": {\"sprite\": \"foreground\"}, \"options\": {\"layer\": \"orb\", \"x\": 5, \"y\": 8, \"radius\": 3, \"colour\": [250,150,30,255]}},\n    {\"id\": \"highlight\", \"filter\": \"pixel\", \"inputs\": {\"sprite\": \"orb1\"}, \"options\": {\"layer\": \"orb\", \"x\": 4, \"y\": 7, \"colour\": [255,255,255,255]}},\n    {\"id\": \"second\", \"filter\": \"frame\", \"inputs\": {\"sprite\": \"highlight\"}, \"options\": {\"durationMS\": 200}},\n    {\"id\": \"background2\", \"filter\": \"rect\", \"inputs\": {\"sprite\": \"second\"}, \"options\": {\"layer\": \"base\", \"frame\": 2, \"x\": 0, \"y\": 0, \"width\": 16, \"height\": 16, \"colour\": [20,40,80,255]}},\n    {\"id\": \"orb2\", \"filter\": \"circle\", \"inputs\": {\"sprite\": \"background2\"}, \"options\": {\"layer\": \"orb\", \"frame\": 2, \"x\": 10, \"y\": 8, \"radius\": 3, \"colour\": [250,150,30,255]}},\n    {\"id\": \"bounce\", \"filter\": \"tag\", \"inputs\": {\"sprite\": \"orb2\"}, \"options\": {\"name\": \"bounce\", \"fromFrame\": 1, \"toFrame\": 2, \"direction\": \"pingPong\"}}\n  ],\n  \"output\": \"bounce\"\n}\n","headings":[],"links":{}}
