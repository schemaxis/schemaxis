{"id":"a135b36992ea481c8de5","title":"r-inference.json","source":"examples/schemaxis/r-inference.json","format":"json","body":"{\n  \"version\": \"schemaxis.r/1\",\n  \"operation\": \"linearRegression\",\n  \"predictors\": [\n    {\n      \"name\": \"temperature\",\n      \"unit\": \"degC\"\n    }\n  ],\n  \"response\": {\n    \"name\": \"reading\",\n    \"unit\": \"V\"\n  },\n  \"training\": [\n    [\n      -2,\n      6.1\n    ],\n    [\n      -1,\n      7.8\n    ],\n    [\n      1,\n      12.2\n    ],\n    [\n      2,\n      13.9\n    ]\n  ],\n  \"heldout\": [\n    [\n      0,\n      10.1\n    ],\n    [\n      3,\n      15.8\n    ]\n  ],\n  \"requirements\": [\n    {\n      \"name\": \"training_rmse\",\n      \"scope\": \"training\",\n      \"metric\": \"rmse\",\n      \"maximum\": 0.17\n    },\n    {\n      \"name\": \"heldout_error\",\n      \"scope\": \"heldout\",\n      \"metric\": \"maxAbsoluteError\",\n      \"maximum\": 0.21\n    },\n    {\n      \"name\": \"slope_interval\",\n      \"scope\": \"training\",\n      \"metric\": \"coefficientInterval\",\n      \"term\": \"temperature\",\n      \"minimum\": 1.5,\n      \"maximum\": 2.5\n    }\n  ],\n  \"inference\": {\n    \"level\": 0.95\n  }\n}\n","headings":[],"links":{}}
