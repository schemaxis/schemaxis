{"id":"cf9269df944297d3d384","title":"ngspice-step-requirements.json","source":"examples/schemaxis/ngspice-step-requirements.json","format":"json","body":"{\n  \"version\": \"schemaxis.ngspice/1\",\n  \"operation\": \"rcStep\",\n  \"circuit\": {\n    \"source\": \"in\",\n    \"resistors\": [\n      {\n        \"name\": \"r1\",\n        \"a\": \"in\",\n        \"b\": \"out\",\n        \"resistance\": 1000\n      }\n    ],\n    \"capacitors\": [\n      {\n        \"name\": \"c1\",\n        \"a\": \"out\",\n        \"b\": \"0\",\n        \"capacitance\": 1e-06\n      }\n    ],\n    \"probes\": [\n      \"out\"\n    ]\n  },\n  \"stop\": 0.005,\n  \"points\": 6,\n  \"amplitude\": 5,\n  \"requirements\": [\n    {\n      \"name\": \"settled_voltage\",\n      \"probe\": \"out\",\n      \"quantity\": \"voltage_V\",\n      \"axis\": \"time_s\",\n      \"window\": [\n        0.003,\n        0.005\n      ],\n      \"minimum\": 4.7,\n      \"maximum\": 5\n    }\n  ]\n}\n","headings":[],"links":{}}
