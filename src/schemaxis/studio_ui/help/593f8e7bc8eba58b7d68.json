{"id":"593f8e7bc8eba58b7d68","title":"oracle-report-documents.json","source":"examples/schemaxis/oracle-report-documents.json","format":"json","body":"{\n  \"version\": \"schemaxis.oracle/1\",\n  \"operation\": \"report\",\n  \"connection\": {\n    \"profile\": \"free_local\"\n  },\n  \"tables\": [\n    {\n      \"name\": \"documents\",\n      \"columns\": [\n        {\n          \"name\": \"id\",\n          \"type\": \"number\",\n          \"precision\": 10,\n          \"scale\": 0\n        },\n        {\n          \"name\": \"note\",\n          \"type\": \"clob\",\n          \"nullable\": true\n        },\n        {\n          \"name\": \"payload\",\n          \"type\": \"blob\",\n          \"nullable\": true\n        },\n        {\n          \"name\": \"metadata\",\n          \"type\": \"json\",\n          \"nullable\": true\n        }\n      ],\n      \"primaryKey\": [\n        \"id\"\n      ],\n      \"source\": {\n        \"path\": \"/replace/with/documents.json\"\n      }\n    }\n  ],\n  \"report\": {\n    \"selects\": [\n      {\n        \"from\": {\n          \"table\": \"documents\",\n          \"alias\": \"d\"\n        },\n        \"computed\": [\n          {\n            \"name\": \"value\",\n            \"function\": \"jsonNumber\",\n            \"arguments\": [\n              {\n                \"column\": \"d.metadata\"\n              }\n            ],\n            \"path\": \"$.samples[0].value\"\n          },\n          {\n            \"name\": \"label\",\n            \"function\": \"jsonText\",\n            \"arguments\": [\n              {\n                \"column\": \"d.metadata\"\n              }\n            ],\n            \"path\": \"$.name\"\n          },\n          {\n            \"name\": \"approved\",\n            \"function\": \"jsonBoolean\",\n            \"arguments\": [\n              {\n                \"column\": \"d.metadata\"\n              }\n            ],\n            \"path\": \"$.approved\"\n          }\n        ],\n        \"columns\": [\n          {\n            \"name\": \"id\",\n            \"operand\": {\n              \"column\": \"d.id\"\n            }\n          },\n          {\n            \"name\": \"note\",\n            \"operand\": {\n              \"column\": \"d.note\"\n            }\n          },\n          {\n            \"name\": \"payload\",\n            \"operand\": {\n              \"column\": \"d.payload\"\n            }\n          },\n          {\n            \"name\": \"metadata\",\n            \"operand\": {\n              \"column\": \"d.metadata\"\n            }\n          },\n          {\n            \"name\": \"value\",\n            \"operand\": {\n              \"derived\": \"value\"\n            }\n          },\n          {\n            \"name\": \"label\",\n            \"operand\": {\n              \"derived\": \"label\"\n            }\n          },\n          {\n            \"name\": \"approved\",\n            \"operand\": {\n              \"derived\": \"approved\"\n            }\n          }\n        ]\n      }\n    ],\n    \"orderBy\": [\n      {\n        \"column\": \"id\"\n      }\n    ]\n  }\n}\n","headings":[],"links":{}}
