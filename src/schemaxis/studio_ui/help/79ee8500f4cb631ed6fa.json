{"id":"79ee8500f4cb631ed6fa","title":"oracle-load.json","source":"examples/schemaxis/oracle-load.json","format":"json","body":"{\n  \"version\": \"schemaxis.oracle/1\",\n  \"operation\": \"load\",\n  \"connection\": {\"profile\": \"free_local\"},\n  \"setup\": {\"retain\": true},\n  \"tables\": [\n    {\n      \"name\": \"customers\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"name\", \"type\": \"varchar2\", \"length\": 40},\n        {\"name\": \"region\", \"type\": \"varchar2\", \"length\": 12, \"nullable\": true},\n        {\"name\": \"credit\", \"type\": \"number\", \"precision\": 12, \"scale\": 2}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"source\": {\"path\": \"/replace/with/customers.json\"}\n    },\n    {\n      \"name\": \"orders\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"customer_id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0, \"nullable\": true},\n        {\"name\": \"placed\", \"type\": \"date\"},\n        {\"name\": \"total\", \"type\": \"number\", \"precision\": 12, \"scale\": 2, \"nullable\": true}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"foreignKeys\": [{\"columns\": [\"customer_id\"], \"table\": \"customers\", \"references\": [\"id\"], \"onDelete\": \"setNull\"}],\n      \"source\": {\"path\": \"/replace/with/orders.json\"}\n    },\n    {\n      \"name\": \"order_lines\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"order_id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"sku\", \"type\": \"varchar2\", \"length\": 12},\n        {\"name\": \"quantity\", \"type\": \"number\", \"precision\": 6, \"scale\": 0},\n        {\"name\": \"unit_price\", \"type\": \"number\", \"precision\": 10, \"scale\": 2},\n        {\"name\": \"packed_at\", \"type\": \"timestampTz\", \"fraction\": 3, \"nullable\": true}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"foreignKeys\": [{\"columns\": [\"order_id\"], \"table\": \"orders\", \"references\": [\"id\"], \"onDelete\": \"cascade\"}],\n      \"source\": {\"path\": \"/replace/with/order_lines.csv\", \"format\": \"csv\"}\n    }\n  ]\n}\n","headings":[],"links":{}}
