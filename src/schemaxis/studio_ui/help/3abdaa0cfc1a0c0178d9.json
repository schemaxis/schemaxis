\",\n      \"options\": {\n        \"radius\": 2,\n        \"centre\": [\n          -14,\n          9\n        ],\n        \"onFace\": {\n          \"face\": \"top\",\n          \"position\": \"innermost\"\n        }\n      },\n      \"inputs\": {\n        \"body\": \"enclosure\",\n        \"support\": \"boss3\"\n      }\n    },\n    {\n      \"id\": \"boss4\",\n      \"filter\": \"pad\",\n      \"inputs\": {\n        \"body\": \"enclosure\",\n        \"base\": \"boss3\",\n        \"profile\": \"bossProfile4\"\n      },\n      \"drive\": {\n        \"length\": {\n          \"terms\": {\n            \"bossHeight\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"mountingLocations\",\n      \"filter\": \"boltGrid\",\n      \"options\": {\n        \"columns\": 2,\n        \"rows\": 2,\n        \"xPitch\": 28,\n        \"yPitch\": 18,\n        \"onFace\": {\n          \"face\": \"top\"\n        }\n      },\n      \"inputs\": {\n        \"body\": \"enclosure\",\n        \"support\": \"boss4\"\n      }\n    },\n    {\n      \"id\": \"finished\",\n      \"filter\": \"hole\",\n      \"inputs\": {\n        \"body\": \"enclosure\",\n        \"base\": \"boss4\",\n        \"profile\": \"mountingLocations\"\n      },\n      \"drive\": {\n        \"diameter\": {\n          \"terms\": {\n            \"mountDiameter\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"lid\",\n      \"filter\": \"body\"\n    },\n    {\n      \"id\": \"lidOutline\",\n      \"filter\": \"rectangle\",\n      \"options\": {\n        \"width\": 40,\n        \"height\": 30,\n        \"origin\": [\n          60,\n          0,\n          0\n        ]\n      },\n      \"inputs\": {\n        \"body\": \"lid\"\n      }\n    },\n    {\n      \"id\": \"lidStock\",\n      \"filter\": \"pad\",\n      \"inputs\": {\n        \"body\": \"lid\",\n        \"profile\": \"lidOutline\"\n      },\n      \"drive\": {\n        \"length\": {\n          \"terms\": {\n            \"wall\": 1\