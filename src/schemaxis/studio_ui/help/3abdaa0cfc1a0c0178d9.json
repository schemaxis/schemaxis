{"id":"3abdaa0cfc1a0c0178d9","title":"freecad-shell-enclosure.json","source":"examples/schemaxis/freecad-shell-enclosure.json","format":"json","body":"{\n  \"version\": \"schemaxis.freecad/1\",\n  \"units\": \"mm\",\n  \"parameters\": {\n    \"wall\": {\n      \"kind\": \"length\",\n      \"value\": 3,\n      \"minimum\": 2,\n      \"maximum\": 3.5\n    },\n    \"height\": {\n      \"kind\": \"length\",\n      \"value\": 20,\n      \"minimum\": 18,\n      \"maximum\": 24\n    },\n    \"bossHeight\": {\n      \"kind\": \"length\",\n      \"value\": 6,\n      \"minimum\": 4,\n      \"maximum\": 8\n    },\n    \"mountDiameter\": {\n      \"kind\": \"length\",\n      \"value\": 2,\n      \"minimum\": 1.5,\n      \"maximum\": 3\n    }\n  },\n  \"nodes\": [\n    {\n      \"id\": \"enclosure\",\n      \"filter\": \"body\"\n    },\n    {\n      \"id\": \"outline\",\n      \"filter\": \"rectangle\",\n      \"options\": {\n        \"width\": 40,\n        \"height\": 30\n      },\n      \"inputs\": {\n        \"body\": \"enclosure\"\n      }\n    },\n    {\n      \"id\": \"stock\",\n      \"filter\": \"pad\",\n      \"inputs\": {\n        \"body\": \"enclosure\",\n        \"profile\": \"outline\"\n      },\n      \"drive\": {\n        \"length\": {\n          \"terms\": {\n            \"height\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"cavity\",\n      \"filter\": \"shell\",\n      \"options\": {\n        \"openings\": [\n          {\n            \"face\": \"top\"\n          }\n        ]\n      },\n      \"inputs\": {\n        \"base\": \"stock\"\n      },\n      \"drive\": {\n        \"thickness\": {\n          \"terms\": {\n            \"wall\": 1\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"bossProfile1\",\n      \"filter\": \"circle\",\n      \"options\": {\n        \"radius\": 2,\n        \"centre\": [\n          -14,\n          -9\n        ],\n        \"onFace\": {\n          \"face\": \"top\",\n          \"position\": \"inn