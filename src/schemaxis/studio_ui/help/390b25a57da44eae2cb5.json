{"id":"390b25a57da44eae2cb5","title":"blender-geometry-resources.json","source":"examples/schemaxis/blender-geometry-resources.json","format":"json","body":"{\n  \"version\": \"schemaxis.blender.production/1\",\n  \"prepareOnly\": true,\n  \"visible\": [\n    \"consumer\"\n  ],\n  \"production\": {\n    \"objects\": [\n      {\n        \"id\": \"prototype\",\n        \"kind\": \"mesh\",\n        \"vertices\": [\n          [\n            0,\n            0,\n            0\n          ],\n          [\n            2,\n            0,\n            0\n          ],\n          [\n            0,\n            1,\n            0\n          ]\n        ],\n        \"faces\": [\n          [\n            0,\n            1,\n            2\n          ]\n        ],\n        \"location\": [\n          10,\n          3,\n          0\n        ],\n        \"collection\": \"parts\"\n      },\n      {\n        \"id\": \"consumer\",\n        \"kind\": \"mesh\",\n        \"vertices\": [\n          [\n            0,\n            0,\n            0\n          ],\n          [\n            1,\n            0,\n            0\n          ],\n          [\n            0,\n            1,\n            0\n          ]\n        ],\n        \"faces\": [\n          [\n            0,\n            1,\n            2\n          ]\n        ],\n        \"location\": [\n          4,\n          1,\n          0\n        ]\n      }\n    ],\n    \"collections\": [\n      {\n        \"id\": \"parts\"\n      }\n    ],\n    \"geometryResources\": [\n      {\n        \"id\": \"referencePart\",\n        \"kind\": \"object\",\n        \"object\": \"prototype\"\n      }\n    ],\n    \"geometryGraphs\": [\n      {\n        \"id\": \"copy\",\n        \"nodes\": [\n          {\n            \"id\": \"source\",\n            \"kind\": \"objectInfo\",\n            \"values\": {\n              \"object\": \"referencePart\",\n              \"asInstance\": false\n            },\n            \"properties\": {\n              \"space\": \"RELATIVE\"\n            }\n          },\n          {\n            \"id\": \"realise\",\n            \"kind\": \"realiseInstances\"\n          },\n          {\n            \"id\": \"out\",\n            \"kind\": \"output\"\n          }\n        ],\n        \"links\": [\n          {\n            \"from\": {\n              \"node\": \"source\",\n              \"socket\": \"geometry\"\n            },\n            \"to\": {\n              \"node\": \"realise\",\n              \"socket\": \"geometry\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"realise\",\n              \"socket\": \"geometry\"\n            },\n            \"to\": {\n              \"node\": \"out\",\n              \"socket\": \"geometry\"\n            }\n          }\n        ]\n      }\n    ],\n    \"geometryBindings\": [\n      {\n        \"object\": \"consumer\",\n        \"graph\": \"copy\"\n      }\n    ],\n    \"units\": \"millimetres\",\n    \"exports\": [\n      {\n        \"id\": \"resource-copy\",\n        \"format\": \"glb\",\n        \"objects\": [\n          \"consumer\"\n        ]\n      }\n    ]\n  }\n}\n","headings":[],"links":{}}
