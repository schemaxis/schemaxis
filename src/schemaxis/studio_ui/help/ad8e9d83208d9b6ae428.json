{"id":"ad8e9d83208d9b6ae428","title":"oracle-mutate-savepoint.json","source":"examples/schemaxis/oracle-mutate-savepoint.json","format":"json","body":"{\n  \"version\": \"schemaxis.oracle/1\",\n  \"operation\": \"mutate\",\n  \"connection\": {\"profile\": \"free_local\"},\n  \"tables\": [\n    {\n      \"name\": \"accounts\",\n      \"columns\": [\n        {\"name\": \"id\", \"type\": \"number\", \"precision\": 10, \"scale\": 0},\n        {\"name\": \"owner\", \"type\": \"varchar2\", \"length\": 20},\n        {\"name\": \"balance\", \"type\": \"number\", \"precision\": 12, \"scale\": 2}\n      ],\n      \"primaryKey\": [\"id\"],\n      \"unique\": [{\"columns\": [\"owner\"]}],\n      \"source\": {\"path\": \"/replace/with/accounts.json\"}\n    }\n  ],\n  \"transaction\": {\n    \"steps\": [\n      {\n        \"kind\": \"update\",\n        \"table\": \"accounts\",\n        \"computed\": [{\"name\": \"debited\", \"function\": \"subtract\", \"arguments\": [{\"column\": \"accounts.balance\"}, {\"literal\": {\"type\": \"number\", \"value\": \"25\"}}]}],\n        \"conditions\": [{\"name\": \"payer\", \"terms\": [{\"left\": {\"column\": \"accounts.id\"}, \"operator\": \"equals\", \"right\": {\"literal\": {\"type\": \"number\", \"value\": \"1\"}}}]}],\n        \"set\": [{\"column\": \"balance\", \"value\": {\"derived\": \"debited\"}}],\n        \"where\": \"payer\",\n        \"expectRows\": 1\n      },\n      {\"kind\": \"savepoint\", \"name\": \"after_debit\"},\n      {\"kind\": \"insert\", \"table\": \"accounts\", \"columns\": [\"id\", \"owner\", \"balance\"], \"rows\": [[4, \"dave\", \"10.00\"]], \"expectRows\": 1},\n      {\"kind\": \"rollbackTo\", \"name\": \"after_debit\"},\n      {\n        \"kind\": \"check\",\n        \"table\": \"accounts\",\n        \"conditions\": [{\"name\": \"everyone\", \"terms\": [{\"left\": {\"column\": \"accounts.id\"}, \"operator\": \"isNull\", \"negate\": true}]}],\n        \"where\": \"everyone\",\n        \"expectRows\": 3\n      }\n    ],\n    \"isolation\": \"serializable\",\n    \"finish\": \"commit\"\n  }\n}\n","headings":[],"links":{}}
