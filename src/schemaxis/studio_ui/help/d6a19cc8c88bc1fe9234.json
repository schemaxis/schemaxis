{"id":"d6a19cc8c88bc1fe9234","title":"aseprite-import-workflow.json","source":"examples/schemaxis/aseprite-import-workflow.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"icon\",\n      \"document\": {\n        \"version\": \"schemaxis.aseprite/1\",\n        \"nodes\": [\n          {\n            \"id\": \"canvas\",\n            \"filter\": \"sprite\",\n            \"options\": {\n              \"width\": 8,\n              \"height\": 8\n            }\n          },\n          {\n            \"id\": \"square\",\n            \"filter\": \"rect\",\n            \"inputs\": {\n              \"sprite\": \"canvas\"\n            },\n            \"options\": {\n              \"layer\": \"base\",\n              \"x\": 1,\n              \"y\": 1,\n              \"width\": 6,\n              \"height\": 6,\n              \"colour\": [\n                30,\n                130,\n                230,\n                255\n              ]\n            }\n          },\n          {\n            \"id\": \"cutout\",\n            \"filter\": \"circle\",\n            \"inputs\": {\n              \"sprite\": \"square\"\n            },\n            \"options\": {\n              \"layer\": \"base\",\n              \"x\": 3,\n              \"y\": 3,\n              \"radius\": 1,\n              \"colour\": [\n                0,\n                0,\n                0,\n                0\n              ]\n            }\n          }\n        ],\n        \"output\": \"cutout\"\n      }\n    },\n    {\n      \"id\": \"framed\",\n      \"document\": {\n        \"version\": \"schemaxis.aseprite/1\",\n        \"nodes\": [\n          {\n            \"id\": \"canvas\",\n            \"filter\": \"sprite\",\n            \"options\": {\n              \"width\": 10,\n              \"height\": 10,\n              \"layer\": \"art\"\n            }\n          },\n          {\n            \"id\": \"place\",\n            \"filter\": \"importImage\",\n            \"inputs\": {\n              \"sprite\": \"canvas\"\n            },\n            \"options\": {\n              \"source\": {\n                \"$artifact\": \"icon\",\n                \"index\": 1\n              },\n              \"layer\": \"art\",\n              \"x\": 1,\n              \"y\": 1,\n              \"width\": 8,\n              \"height\": 8\n            }\n          }\n        ],\n        \"output\": \"place\"\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
