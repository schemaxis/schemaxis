 {\n              \"node\": \"out\",\n              \"socket\": \"surface\"\n            }\n          }\n        ]\n      }\n    ],\n    \"geometryGraphs\": [\n      {\n        \"id\": \"deform\",\n        \"nodes\": [\n          {\n            \"id\": \"in\",\n            \"kind\": \"input\"\n          },\n          {\n            \"id\": \"field\",\n            \"kind\": \"namedAttribute\",\n            \"properties\": {\n              \"dataType\": \"FLOAT_VECTOR\"\n            },\n            \"values\": {\n              \"name\": \"displacement\"\n            }\n          },\n          {\n            \"id\": \"move\",\n            \"kind\": \"setPosition\"\n          },\n          {\n            \"id\": \"out\",\n            \"kind\": \"output\"\n          }\n        ],\n        \"links\": [\n          {\n            \"from\": {\n              \"node\": \"in\",\n              \"socket\": \"geometry\"\n            },\n            \"to\": {\n              \"node\": \"move\",\n              \"socket\": \"geometry\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"field\",\n              \"socket\": \"attribute\"\n            },\n            \"to\": {\n              \"node\": \"move\",\n              \"socket\": \"offset\"\n            }\n          },\n          {\n            \"from\": {\n              \"node\": \"move\",\n              \"socket\": \"geometry\"\n            },\n            \"to\": {\n              \"node\": \"out\",\n              \"socket\": \"geometry\"\n            }\n          }\n        ]\n      }\n    ],\n    \"geometryBindings\": [\n      {\n        \"object\": \"panel\",\n        \"graph\": \"deform\"\n      }\n    ],\n    \"exports\": [\n      {\n        \"id\": \"field-panel\",\n        \"format\": \"glb\",\n        \"objects\": [\n          \"panel\"\n        ],\n        \"frame\": 1\n      }\n    ]\n  }\n}\n","headings":[],"links":{}}
