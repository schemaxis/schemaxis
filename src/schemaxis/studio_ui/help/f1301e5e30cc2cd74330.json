{"id":"f1301e5e30cc2cd74330","title":"blender-mesh-fields.json","source":"examples/schemaxis/blender-mesh-fields.json","format":"json","body":"{\n  \"version\": \"schemaxis.blender.production/1\",\n  \"id\": \"field-panel\",\n  \"prepareOnly\": true,\n  \"production\": {\n    \"units\": \"millimetres\",\n    \"objects\": [\n      {\n        \"id\": \"panel\",\n        \"kind\": \"mesh\",\n        \"vertices\": [\n          [\n            0,\n            0,\n            0\n          ],\n          [\n            40,\n            0,\n            0\n          ],\n          [\n            40,\n            30,\n            0\n          ],\n          [\n            0,\n            30,\n            0\n          ]\n        ],\n        \"faces\": [\n          [\n            0,\n            1,\n            2,\n            3\n          ]\n        ],\n        \"material\": \"fieldColour\"\n      }\n    ],\n    \"meshData\": [\n      {\n        \"object\": \"panel\",\n        \"attributes\": [\n          {\n            \"name\": \"displacement\",\n            \"kind\": \"vector\",\n            \"domain\": \"POINT\",\n            \"mode\": \"dense\",\n            \"values\": [\n              [\n                0,\n                0,\n                0\n              ],\n              [\n                0,\n                0,\n                2\n              ],\n              [\n                0,\n                0,\n                4\n              ],\n              [\n                0,\n                0,\n                2\n              ]\n            ]\n          },\n          {\n            \"name\": \"temperature\",\n            \"kind\": \"float\",\n            \"domain\": \"POINT\",\n            \"mode\": \"dense\",\n            \"values\": [\n              300,\n              310,\n              320,\n              310\n            ]\n          },\n          {\n            \"name\": \"fieldColour\",\n            \"kind\": \"colour\",\n            \"domain\": \"POINT\",