{"id":"314b297ff81345045e65","title":"freecad-gmsh-bores.json","source":"examples/schemaxis/freecad-gmsh-bores.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"cad\",\n      \"document\": {\n        \"version\": \"schemaxis.freecad/1\",\n        \"units\": \"mm\",\n        \"nodes\": [\n          {\n            \"id\": \"plate\",\n            \"filter\": \"box\",\n            \"options\": {\n              \"length\": 60,\n              \"width\": 40,\n              \"height\": 8\n            }\n          },\n          {\n            \"id\": \"leftHole\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 4,\n              \"height\": 10,\n              \"origin\": [\n                15,\n                20,\n                -1\n              ]\n            }\n          },\n          {\n            \"id\": \"rightHole\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 4,\n              \"height\": 10,\n              \"origin\": [\n                45,\n                20,\n                -1\n              ]\n            }\n          },\n          {\n            \"id\": \"drilled\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"plate\",\n              \"tool\": \"leftHole\"\n            }\n          },\n          {\n            \"id\": \"part\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"drilled\",\n              \"tool\": \"rightHole\"\n            }\n          }\n        ],\n        \"output\": \"part\"\n      }\n    },\n    {\n      \"id\": \"mesh\",\n      \"document\": {\n        \"version\": \"schemaxis.gmsh/1\",\n        \"units\": \"mm\",\n        \"nodes\": [\n          {\n            \"id\": \"solid\",\n            \"filter\": \"readSTEP\",\n            \"options\": {\n              \"file\": {\n                \"$artifact\": \"cad\",\n                \"index\": 0\n              }\n            }\n          },\n          {\n            \"id\": \"mesh\",\n            \"filter\": \"tetrahedral\",\n            \"inputs\": {\n              \"input\": \"solid\"\n            },\n            \"options\": {\n              \"size\": 3,\n              \"volumeName\": \"plate\",\n              \"boundaryName\": \"free\",\n              \"volumeTolerance\": 0.02,\n              \"faceGroups\": [\n                {\n                  \"name\": \"base\",\n                  \"axis\": \"z\",\n                  \"coordinate\": 0,\n                  \"areaTolerance\": 0.02\n                }\n              ],\n              \"cylinderGroups\": [\n                {\n                  \"name\": \"fixedBore\",\n                  \"axis\": \"z\",\n                  \"centre\": [\n                    15,\n                    20,\n                    0\n                  ],\n                  \"radius\": 4,\n                  \"side\": \"inner\"\n                },\n                {\n                  \"name\": \"loadBore\",\n                  \"axis\": \"z\",\n                  \"centre\": [\n                    45,\n                    20,\n                    0\n                  ],\n                  \"radius\": 4,\n                  \"side\": \"inner\"\n                }\n              ],\n              \"nearBoundaries\": [\n                {\n                  \"boundary\": \"loadBore\",\n                  \"size\": 0.9,\n                  \"distance\": 4\n                }\n              ]\n            }\n          }\n        ],\n        \"output\": \"mesh\"\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
