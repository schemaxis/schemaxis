{"id":"6248d8c6dce8c61a6092","title":"calculix-to-calc.json","source":"examples/schemaxis/calculix-to-calc.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"beam\",\n      \"document\": {\n        \"version\": \"schemaxis.calculix/1\",\n        \"operation\": \"cantileverBeam\",\n        \"beam\": {\n          \"length_m\": 0.4,\n          \"width_m\": 0.02,\n          \"height_m\": 0.02\n        },\n        \"material\": {\n          \"youngsModulus_Pa\": 210000000000.0,\n          \"poissonRatio\": 0.3\n        },\n        \"load\": {\n          \"tipForceZ_N\": -100\n        },\n        \"mesh\": {\n          \"lengthCells\": 12,\n          \"sectionCells\": 2\n        },\n        \"requirements\": [\n          {\n            \"name\": \"tip_serviceability\",\n            \"quantity\": \"absTipAreaMeanUz_m\",\n            \"maximum\": 0.0008\n          },\n          {\n            \"name\": \"interior_samples\",\n            \"quantity\": \"maxInteriorSampleNormalStress_Pa\",\n            \"maximum\": 20000000.0\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"workbook\",\n      \"document\": {\n        \"version\": \"schemaxis.calc/1\",\n        \"nodes\": [\n          {\n            \"id\": \"stress\",\n            \"filter\": \"readCSV\",\n            \"options\": {\n              \"file\": {\n                \"$artifact\": \"beam\",\n                \"index\": 1\n              }\n            }\n          }\n        ],\n        \"requirements\": [\n          {\n            \"name\": \"interior_sample_count\",\n            \"type\": \"cellBounds\",\n            \"cell\": {\n              \"sheet\": \"Summary\",\n              \"cell\": \"B7\"\n            },\n            \"minimum\": 1280,\n            \"maximum\": 1280\n          },\n          {\n            \"name\": \"compression_sample\",\n            \"type\": \"cellBounds\",\n            \"cell\": {\n              \"sheet\": \"Summary\",\n              \"cell\": \"E7\"\n            },\n            \"minimum\": -20000000.0,\n            \"maximum\": -10000000.0\n          },\n          {\n            \"name\": \"tension_sample\",\n            \"type\": \"cellBounds\",\n            \"cell\": {\n              \"sheet\": \"Summary\",\n              \"cell\": \"F7\"\n            },\n            \"minimum\": 10000000.0,\n            \"maximum\": 20000000.0\n          },\n          {\n            \"name\": \"symmetric_extrema\",\n            \"type\": \"reconcile\",\n            \"terms\": [\n              {\n                \"sheet\": \"Summary\",\n                \"cell\": \"E7\",\n                \"coefficient\": 1\n              },\n              {\n                \"sheet\": \"Summary\",\n                \"cell\": \"F7\",\n                \"coefficient\": 1\n              }\n            ],\n            \"target\": 0,\n            \"absoluteTolerance\": 10\n          }\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
