{"id":"fd144c970417326bf181","title":"blender-production.json","source":"examples/schemaxis/blender-production.json","format":"json","body":"{\n  \"version\": \"schemaxis.blender/1\",\n  \"nodes\": [\n    {\"id\": \"paint\", \"filter\": \"material\"},\n    {\"id\": \"box\", \"filter\": \"cube\", \"inputs\": {\"material\": \"paint\"}, \"options\": {\"size\": 2}}\n  ],\n  \"scenes\": [{\n    \"id\": \"studio\", \"visible\": [\"box\"], \"prepareOnly\": true,\n    \"render\": {\"samples\": 1, \"threads\": 1},\n    \"images\": [{\"id\": \"preview\", \"size\": [32, 32], \"cameras\": [{\"direction\": [1, -2, 1]}]}],\n    \"production\": {\n      \"frameStart\": 1, \"frameEnd\": 11, \"fps\": 24, \"currentFrame\": 6, \"units\": \"metres\",\n      \"collections\": [{\"id\": \"product\"}],\n      \"objects\": [\n        {\"id\": \"motion\", \"kind\": \"empty\", \"collection\": \"product\"},\n        {\"id\": \"copy\", \"kind\": \"instance\", \"source\": \"box\", \"location\": [0, 3, 0], \"collection\": \"product\"},\n        {\"id\": \"label\", \"kind\": \"text\", \"body\": \"Product\", \"size\": 0.5, \"location\": [0, -2, 0], \"material\": \"paint\", \"collection\": \"product\"},\n        {\"id\": \"fill\", \"kind\": \"light\", \"type\": \"AREA\", \"energy\": 500, \"location\": [-3, -4, 5], \"rotation\": [0.5, 0, -0.5], \"collection\": \"product\"}\n      ],\n      \"hierarchy\": [{\"object\": \"box\", \"parent\": \"motion\", \"keepWorld\": false}, {\"object\": \"copy\", \"parent\": \"motion\", \"keepWorld\": false}],\n      \"tracks\": [{\"object\": \"motion\", \"channel\": \"location\", \"interpolation\": \"LINEAR\", \"keys\": [{\"frame\": 1, \"value\": [0, 0, 0]}, {\"frame\": 11, \"value\": [4, 0, 0]}]}],\n      \"materialGraphs\": [{\"id\": \"ceramic\", \"nodes\": [\n        {\"id\": \"checker\", \"kind\": \"checker\", \"values\": {\"a\": [0.05, 0.1, 0.8, 1], \"b\": [0.9, 0.9, 0.9, 1], \"scale\": 4}},\n        {\"id\": \"surface\", \"kind\": \"principled\", \"values\": {\"roughness\": 0.2}},\n        {\"id\": \"finish\", \"kind\": \"output\"}\n      ], \"links\": [{\"from\": {\"node\": \"checker\", \"socket\": \"colour\"}, \"to\": {\"node\": \"surface\", \"socket\": \"colour\"}}, {\"from\": {\"node\": \"surface\", \"socket\": \"shader\"}, \"to\": {\"node\": \"finish\", \"socket\": \"surface\"}}]}],\n      \"materialBindings\": [{\"object\": \"box\", \"material\": \"ceramic\"}],\n      \"renderFrames\": [1, 6, 11],\n      \"exports\": [{\"id\": \"moving-product\", \"format\": \"glb\", \"objects\": [\"box\", \"copy\"], \"frame\": 6}, {\"id\": \"mesh\", \"format\": \"obj\", \"objects\": [\"box\"], \"frame\": 11}]\n    }\n  }]\n}\n","headings":[],"links":{}}
