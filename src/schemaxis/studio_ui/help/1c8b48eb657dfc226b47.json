{"id":"1c8b48eb657dfc226b47","title":"blender-showcase.json","source":"examples/schemaxis/blender-showcase.json","format":"json","body":"{\n  \"version\": \"schemaxis.blender/1\",\n  \"nodes\": [\n    {\"id\": \"paint\", \"filter\": \"material\", \"options\": {\n      \"colour\": {\"$analytic\": {\"type\": \"values\", \"sync\": \"shape\",\n        \"values\": [[0.05, 0.3, 0.8, 1], [0.8, 0.2, 0.05, 1]]}}}},\n    {\"id\": \"box\", \"filter\": \"cube\", \"inputs\": {\"material\": {\"$object\": \"paint\"}}, \"options\": {\n      \"size\": {\"$analytic\": {\"type\": \"linear\", \"sync\": \"shape\", \"start\": 2, \"end\": 3, \"count\": 2}}}},\n    {\"id\": \"rounded\", \"filter\": \"bevel\", \"inputs\": {\"input\": \"box\"}, \"options\": {\"width\": 0.15, \"segments\": 3}},\n    {\"id\": \"unusedPaint\", \"filter\": \"material\"}\n  ],\n  \"scenes\": [{\"id\": \"demo\", \"visible\": [\"rounded\"], \"images\": [{\n    \"id\": \"orbit\", \"size\": [240, 180],\n    \"cameras\": {\"$analytic\": {\"type\": \"orbit\", \"start\": 30, \"end\": 150, \"count\": 3, \"elevation\": 25}}\n  }]}]\n}\n","headings":[],"links":{}}
