{"id":"cb29f4919fd22872757d","title":"paraview-resources.json","source":"examples/schemaxis/paraview-resources.json","format":"json","body":"{\n  \"version\": \"schemaxis/1\",\n  \"nodes\": [\n    {\n      \"id\": \"wave\",\n      \"filter\": \"pvWavelet\",\n      \"options\": {\n        \"WholeExtent\": [\n          -2,\n          2,\n          -2,\n          2,\n          -2,\n          2\n        ]\n      }\n    },\n    {\n      \"id\": \"opacity\",\n      \"filter\": \"pvResourcePiecewiseFunction\",\n      \"options\": {\n        \"Points\": [\n          0,\n          1,\n          0.5,\n          0,\n          300,\n          1,\n          0.5,\n          0\n        ]\n      }\n    },\n    {\n      \"id\": \"colours\",\n      \"filter\": \"pvResourcePVLookupTable\",\n      \"inputs\": {\n        \"ScalarOpacityFunction\": \"opacity\",\n        \"TransferFunction2D\": \"transfer2d\"\n      },\n      \"options\": {\n        \"RGBPoints\": {\n          \"$axis\": \"palette\"\n        },\n        \"ColorSpace\": \"RGB\"\n      }\n    },\n    {\n      \"id\": \"coloured\",\n      \"filter\": \"pvColorByArray\",\n      \"inputs\": {\n        \"Input\": \"wave\",\n        \"LookupTable\": \"colours\"\n      },\n      \"options\": {\n        \"ColorBy\": [\n          \"POINTS\",\n          \"RTData\"\n        ],\n        \"OutputFormat\": \"RGBA\"\n      }\n    },\n    {\n      \"id\": \"colouredRgb\",\n      \"filter\": \"pvColorByArray\",\n      \"inputs\": {\n        \"Input\": \"wave\",\n        \"LookupTable\": \"colours\"\n      },\n      \"options\": {\n        \"ColorBy\": [\n          \"POINTS\",\n          \"RTData\"\n        ],\n        \"OutputFormat\": \"RGB\"\n      }\n    },\n    {\n      \"id\": \"transfer2d\",\n      \"filter\": \"pvResourceTransferFunction2D\",\n      \"options\": {\n        \"Range\": [\n          0,\n          300,\n          0,\n          1\n        ],\n        \"OutputDimensions\": [\n          16,\n          16\n        ]\n      }\n    }\n  ],\n  \"scenes\": [\n    {\n      \"id\": \"resources\",\n      \"geometry\": [\n        \"coloured\",\n        \"colouredRgb\"\n      ]\n    }\n  ],\n  \"axes\": [\n    {\n      \"name\": \"palette\",\n      \"values\": [\n        [\n          0,\n          0,\n          0,\n          1,\n          300,\n          1,\n          0,\n          0\n        ],\n        [\n          0,\n          1,\n          0,\n          0,\n          300,\n          0,\n          0,\n          1\n        ]\n      ]\n    }\n  ]\n}\n","headings":[],"links":{}}
