{"id":"f0ce993dab5a6761b69a","title":"foam-native-parallel.json","source":"examples/schemaxis/foam-native-parallel.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"execution\": {\n    \"maxWorkers\": 1,\n    \"cpus\": 2,\n    \"memoryMB\": 12000,\n    \"gpus\": 0\n  },\n  \"operations\": [\n    {\n      \"id\": \"cfd\",\n      \"execution\": {\n        \"ranks\": 2,\n        \"threads\": 1,\n        \"memoryMB\": 12000,\n        \"mpiexec\": \"/absolute/path/to/matching/mpi/bin/mpiexec\"\n      },\n      \"document\": {\n        \"version\": \"schemaxis/1\",\n        \"times\": {\n          \"source\": \"case\",\n          \"select\": {\n            \"latest\": 1\n          }\n        },\n        \"nodes\": [\n          {\n            \"id\": \"case\",\n            \"filter\": \"foam\",\n            \"options\": {\n              \"file\": \"/absolute/path/to/decomposed/case.foam\",\n              \"cellArrays\": [\n                \"U\",\n                \"p\"\n              ]\n            }\n          },\n          {\n            \"id\": \"mesh\",\n            \"filter\": \"merge\",\n            \"inputs\": {\n              \"input\": \"case\"\n            }\n          },\n          {\n            \"id\": \"speed\",\n            \"filter\": \"calculator\",\n            \"inputs\": {\n              \"input\": \"mesh\"\n            },\n            \"options\": {\n              \"expression\": \"mag(U)\",\n              \"result\": \"Umag\",\n              \"association\": \"Cell Data\"\n            }\n          },\n          {\n            \"id\": \"cut\",\n            \"filter\": \"slice\",\n            \"inputs\": {\n              \"input\": \"speed\"\n            },\n            \"options\": {\n              \"origin\": [\n                0,\n                0,\n                0\n              ],\n              \"normal\": [\n                0,\n                1,\n                0\n              ]\n            }\n          },\n          {\n            \"id\": \"totals\",\n            \"filter\": \"integrate\",\n            \"inputs\": {\n              \"input\": \"speed\"\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"flow\",\n            \"geometry\": [\n              \"speed\",\n              \"cut\"\n            ],\n            \"visible\": {\n              \"cut\": {\n                \"field\": [\n                  \"CELLS\",\n                  \"p\"\n                ],\n                \"range\": [\n                  -500,\n                  500\n                ],\n                \"legend\": true,\n                \"legendTitle\": \"Pressure\"\n              }\n            },\n            \"appearances\": [\n              {}\n            ],\n            \"images\": [\n              {\n                \"id\": \"overview\",\n                \"size\": [\n                  640,\n                  360\n                ],\n                \"cameras\": [\n                  {\n                    \"direction\": [\n                      0,\n                      -1,\n                      0\n                    ],\n                    \"focalPoint\": [\n                      2.5,\n                      0,\n                      1.4\n                    ],\n                    \"scale\": 3,\n                    \"distance\": 30\n                  }\n                ]\n              }\n            ],\n            \"measurements\": [\n              {\n                \"node\": \"totals\",\n                \"association\": \"CELLS\"\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"reuse\",\n      \"execution\": {\n        \"ranks\": 2,\n        \"threads\": 1,\n        \"memoryMB\": 12000,\n        \"mpiexec\": \"/absolute/path/to/matching/mpi/bin/mpiexec\"\n      },\n      \"document\": {\n        \"version\": \"schemaxis/1\",\n        \"nodes\": [\n          {\n            \"id\": \"volume\",\n            \"filter\": \"readParallelUnstructuredGrid\",\n            \"options\": {\n              \"files\": [\n                {\n                  \"$artifact\": \"cfd\",\n                  \"index\": 0\n                }\n              ]\n            }\n          },\n          {\n            \"id\": \"totals\",\n            \"filter\": \"integrate\",\n            \"inputs\": {\n              \"input\": \"volume\"\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"check\",\n            \"measurements\": [\n              {\n                \"node\": \"totals\",\n                \"association\": \"CELLS\"\n              }\n            ]\n          }\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
