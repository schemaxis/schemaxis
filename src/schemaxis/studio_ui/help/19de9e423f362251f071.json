{"id":"19de9e423f362251f071","title":"freecad-to-blender.json","source":"examples/schemaxis/freecad-to-blender.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"execution\": {\n    \"maxWorkers\": 2,\n    \"cpus\": 8,\n    \"memoryMB\": 8192,\n    \"gpus\": 0\n  },\n  \"operations\": [\n    {\n      \"id\": \"bracket\",\n      \"document\": {\n        \"version\": \"schemaxis.freecad/1\",\n        \"units\": \"mm\",\n        \"linearDeflection\": 0.05,\n        \"nodes\": [\n          {\n            \"id\": \"foot\",\n            \"filter\": \"box\",\n            \"options\": {\n              \"length\": 100,\n              \"width\": 70,\n              \"height\": 8,\n              \"origin\": [\n                0,\n                0,\n                0\n              ]\n            }\n          },\n          {\n            \"id\": \"upright\",\n            \"filter\": \"box\",\n            \"options\": {\n              \"length\": 100,\n              \"width\": 8,\n              \"height\": 60,\n              \"origin\": [\n                0,\n                62,\n                0\n              ]\n            }\n          },\n          {\n            \"id\": \"blank\",\n            \"filter\": \"fuse\",\n            \"inputs\": {\n              \"base\": \"foot\",\n              \"tool\": \"upright\"\n            }\n          },\n          {\n            \"id\": \"drill0\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 5,\n              \"height\": 10,\n              \"origin\": [\n                25,\n                25,\n                -1\n              ],\n              \"axis\": [\n                0,\n                0,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"cut0\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"blank\",\n              \"tool\": \"drill0\"\n            }\n          },\n          {\n            \"id\": \"drill1\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 5,\n              \"height\": 10,\n              \"origin\": [\n                75,\n                25,\n                -1\n              ],\n              \"axis\": [\n                0,\n                0,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"cut1\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"cut0\",\n              \"tool\": \"drill1\"\n            }\n          },\n          {\n            \"id\": \"drill2\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 6,\n              \"height\": 10,\n              \"origin\": [\n                25,\n                61,\n                35\n              ],\n              \"axis\": [\n                0,\n                1,\n                0\n              ]\n            }\n          },\n          {\n            \"id\": \"cut2\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"cut1\",\n              \"tool\": \"drill2\"\n            }\n          },\n          {\n            \"id\": \"drill3\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 6,\n              \"height\": 10,\n              \"origin\": [\n                75,\n                61,\n                35\n              ],\n              \"axis\": [\n                0,\n                1,\n                0\n              ]\n            }\n          },\n          {\n            \"id\": \"cut3\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"cut2\",\n              \"tool\": \"drill3\"\n            }\n          }\n        ],\n        \"output\": \"cut3\"\n      }\n    },\n    {\n      \"id\": \"bracketMesh\",\n      \"document\": {\n        \"version\": \"schemaxis/1\",\n        \"nodes\": [\n          {\n            \"id\": \"mesh\",\n            \"filter\": \"readSTL\",\n            \"options\": {\n              \"files\": [\n                {\n                  \"$artifact\": \"bracket\",\n                  \"index\": 1\n                }\n              ]\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"cad\",\n            \"visible\": {\n              \"mesh\": {\n                \"colour\": [\n                  0.12,\n                  0.4,\n                  0.68\n                ]\n              }\n            },\n            \"gltf\": true\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"bracketRender\",\n      \"execution\": {\n        \"threads\": 4,\n        \"memoryMB\": 2048\n      },\n      \"document\": {\n        \"version\": \"schemaxis.blender/1\",\n        \"nodes\": [\n          {\n            \"id\": \"part\",\n            \"filter\": \"readGltf\",\n            \"options\": {\n              \"file\": {\n                \"$artifact\": \"bracketMesh\",\n                \"index\": 0\n              }\n            }\n          },\n          {\n            \"id\": \"engineeringFrame\",\n            \"filter\": \"transform\",\n            \"inputs\": {\n              \"input\": \"part\"\n            },\n            \"options\": {\n              \"rotation\": [\n                -90,\n                0,\n                0\n              ],\n              \"scale\": [\n                0.001,\n                0.001,\n                0.001\n              ]\n            }\n          },\n          {\n            \"id\": \"finish\",\n            \"filter\": \"material\",\n            \"options\": {\n              \"colour\": [\n                0.055,\n                0.24,\n                0.43,\n                1\n              ],\n              \"metallic\": 0.45,\n              \"roughness\": 0.28\n            }\n          },\n          {\n            \"id\": \"styled\",\n            \"filter\": \"assignMaterial\",\n            \"inputs\": {\n              \"input\": \"engineeringFrame\",\n              \"material\": \"finish\"\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"presentation\",\n            \"visible\": [\n              \"styled\"\n            ],\n            \"render\": {\n              \"threads\": 4,\n              \"samples\": 64,\n              \"denoise\": true,\n              \"worldStrength\": 0.5,\n              \"lightPosition\": [\n                0.15,\n                -0.2,\n                0.3\n              ],\n              \"lightEnergy\": 20,\n              \"lightSize\": 0.15\n            },\n            \"images\": [\n              {\n                \"id\": \"views\",\n                \"size\": [\n                  960,\n                  720\n                ],\n                \"cameras\": [\n                  {\n                    \"direction\": [\n                      1,\n                      -1.7,\n                      1.2\n                    ],\n                    \"padding\": 0.08\n                  },\n                  {\n                    \"direction\": [\n                      -1,\n                      -1,\n                      1.7\n                    ],\n                    \"padding\": 0.08\n                  }\n                ]\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"flange\",\n      \"document\": {\n        \"version\": \"schemaxis.freecad/1\",\n        \"units\": \"mm\",\n        \"linearDeflection\": 0.05,\n        \"nodes\": [\n          {\n            \"id\": \"flange\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 35,\n              \"height\": 8,\n              \"origin\": [\n                0,\n                0,\n                0\n              ],\n              \"axis\": [\n                0,\n                0,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"neck\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 18,\n              \"height\": 60,\n              \"origin\": [\n                0,\n                0,\n                0\n              ],\n              \"axis\": [\n                0,\n                0,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"blank\",\n            \"filter\": \"fuse\",\n            \"inputs\": {\n              \"base\": \"flange\",\n              \"tool\": \"neck\"\n            }\n          },\n          {\n            \"id\": \"bore\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 12,\n              \"height\": 62,\n              \"origin\": [\n                0,\n                0,\n                -1\n              ],\n              \"axis\": [\n                0,\n                0,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"hollow\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"blank\",\n              \"tool\": \"bore\"\n            }\n          },\n          {\n            \"id\": \"bolt0\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 3.5,\n              \"height\": 10,\n              \"origin\": [\n                27,\n                0,\n                -1\n              ],\n              \"axis\": [\n                0,\n                0,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"cut0\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"hollow\",\n              \"tool\": \"bolt0\"\n            }\n          },\n          {\n            \"id\": \"bolt1\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 3.5,\n              \"height\": 10,\n              \"origin\": [\n                0,\n                27,\n                -1\n              ],\n              \"axis\": [\n                0,\n                0,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"cut1\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"cut0\",\n              \"tool\": \"bolt1\"\n            }\n          },\n          {\n            \"id\": \"bolt2\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 3.5,\n              \"height\": 10,\n              \"origin\": [\n                -27,\n                0,\n                -1\n              ],\n              \"axis\": [\n                0,\n                0,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"cut2\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"cut1\",\n              \"tool\": \"bolt2\"\n            }\n          },\n          {\n            \"id\": \"bolt3\",\n            \"filter\": \"cylinder\",\n            \"options\": {\n              \"radius\": 3.5,\n              \"height\": 10,\n              \"origin\": [\n                0,\n                -27,\n                -1\n              ],\n              \"axis\": [\n                0,\n                0,\n                1\n              ]\n            }\n          },\n          {\n            \"id\": \"cut3\",\n            \"filter\": \"cut\",\n            \"inputs\": {\n              \"base\": \"cut2\",\n              \"tool\": \"bolt3\"\n            }\n          }\n        ],\n        \"output\": \"cut3\"\n      }\n    },\n    {\n      \"id\": \"flangeMesh\",\n      \"document\": {\n        \"version\": \"schemaxis/1\",\n        \"nodes\": [\n          {\n            \"id\": \"mesh\",\n            \"filter\": \"readSTL\",\n            \"options\": {\n              \"files\": [\n                {\n                  \"$artifact\": \"flange\",\n                  \"index\": 1\n                }\n              ]\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"cad\",\n            \"visible\": {\n              \"mesh\": {\n                \"colour\": [\n                  0.8,\n                  0.36,\n                  0.09\n                ]\n              }\n            },\n            \"gltf\": true\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"flangeRender\",\n      \"execution\": {\n        \"threads\": 4,\n        \"memoryMB\": 2048\n      },\n      \"document\": {\n        \"version\": \"schemaxis.blender/1\",\n        \"nodes\": [\n          {\n            \"id\": \"part\",\n            \"filter\": \"readGltf\",\n            \"options\": {\n              \"file\": {\n                \"$artifact\": \"flangeMesh\",\n                \"index\": 0\n              }\n            }\n          },\n          {\n            \"id\": \"engineeringFrame\",\n            \"filter\": \"transform\",\n            \"inputs\": {\n              \"input\": \"part\"\n            },\n            \"options\": {\n              \"rotation\": [\n                -90,\n                0,\n                0\n              ],\n              \"scale\": [\n                0.001,\n                0.001,\n                0.001\n              ]\n            }\n          },\n          {\n            \"id\": \"finish\",\n            \"filter\": \"material\",\n            \"options\": {\n              \"colour\": [\n                0.6,\n                0.22,\n                0.045,\n                1\n              ],\n              \"metallic\": 0.45,\n              \"roughness\": 0.28\n            }\n          },\n          {\n            \"id\": \"styled\",\n            \"filter\": \"assignMaterial\",\n            \"inputs\": {\n              \"input\": \"engineeringFrame\",\n              \"material\": \"finish\"\n            }\n          }\n        ],\n        \"scenes\": [\n          {\n            \"id\": \"presentation\",\n            \"visible\": [\n              \"styled\"\n            ],\n            \"render\": {\n              \"threads\": 4,\n              \"samples\": 64,\n              \"denoise\": true,\n              \"worldStrength\": 0.5,\n              \"lightPosition\": [\n                0.15,\n                -0.2,\n                0.3\n              ],\n              \"lightEnergy\": 20,\n              \"lightSize\": 0.15\n            },\n            \"images\": [\n              {\n                \"id\": \"views\",\n                \"size\": [\n                  960,\n                  720\n                ],\n                \"cameras\": [\n                  {\n                    \"direction\": [\n                      1,\n                      -1.7,\n                      1.2\n                    ],\n                    \"padding\": 0.08\n                  },\n                  {\n                    \"direction\": [\n                      -1,\n                      -1,\n                      1.7\n                    ],\n                    \"padding\": 0.08\n                  }\n                ]\n              }\n            ]\n          }\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
