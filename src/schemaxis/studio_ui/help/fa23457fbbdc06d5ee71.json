{"id":"fa23457fbbdc06d5ee71","title":"ffmpeg-review-workflow.json","source":"examples/schemaxis/ffmpeg-review-workflow.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"clip\",\n      \"document\": {\n        \"version\": \"schemaxis.ffmpeg/1\",\n        \"nodes\": [\n          {\n            \"id\": \"clip\",\n            \"filter\": \"encodeVideo\",\n            \"options\": {\n              \"file\": \"/replace-with-your-input/source.mkv\",\n              \"startFrame\": 0,\n              \"endFrame\": 6,\n              \"fps\": 10,\n              \"codec\": \"ffv1\",\n              \"threads\": 1\n            }\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"review\",\n      \"document\": {\n        \"version\": \"schemaxis.ffmpeg/1\",\n        \"nodes\": [\n          {\n            \"id\": \"review\",\n            \"filter\": \"muxReview\",\n            \"options\": {\n              \"video\": {\n                \"$artifact\": \"clip\",\n                \"index\": 0\n              },\n              \"audio\": \"/replace-with-your-input/speech.wav\",\n              \"captions\": \"/replace-with-your-input/captions.srt\",\n              \"captionStatus\": \"machineDraft\",\n              \"threads\": 1\n            }\n          }\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
