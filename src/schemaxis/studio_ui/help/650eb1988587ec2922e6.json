{"id":"650eb1988587ec2922e6","title":"apachearrow-sqlite-workflow.json","source":"examples/schemaxis/apachearrow-sqlite-workflow.json","format":"json","body":"{\n  \"version\": \"schemaxis.workflow/1\",\n  \"operations\": [\n    {\n      \"id\": \"summary\",\n      \"document\": {\n        \"version\": \"schemaxis.sqlite/1\",\n        \"operation\": \"summarise\",\n        \"tables\": [\n          {\n            \"name\": \"departments\",\n            \"source\": \"/replace/with/departments.json\",\n            \"columns\": [\n              {\n                \"name\": \"id\",\n                \"type\": \"INTEGER\"\n              },\n              {\n                \"name\": \"region\",\n                \"type\": \"TEXT\",\n                \"nullable\": true\n              }\n            ],\n            \"primaryKey\": \"id\"\n          },\n          {\n            \"name\": \"sales\",\n            \"source\": \"/replace/with/sales.json\",\n            \"columns\": [\n              {\n                \"name\": \"id\",\n                \"type\": \"INTEGER\"\n              },\n              {\n                \"name\": \"department\",\n                \"type\": \"INTEGER\",\n                \"nullable\": true\n              },\n              {\n                \"name\": \"amount\",\n                \"type\": \"INTEGER\",\n                \"nullable\": true\n              }\n            ],\n            \"primaryKey\": \"id\",\n            \"foreignKeys\": [\n              {\n                \"column\": \"department\",\n                \"table\": \"departments\",\n                \"target\": \"id\"\n              }\n            ]\n          }\n        ],\n        \"from\": \"sales\",\n        \"join\": {\n          \"table\": \"departments\",\n          \"local\": \"department\",\n          \"remote\": \"id\"\n        },\n        \"where\": {\n          \"column\": \"sales.id\",\n          \"minimum\": 1\n        },\n        \"groupBy\": [\n          \"departments.region\"\n        ],\n        \"sum\": \"sales.amount\"\n      }\n    },\n    {\n      \"id\": \"parquet\",\n      \"document\": {\n        \"version\": \"schemaxis.apachearrow/1\",\n        \"operation\": \"prepareTable\",\n        \"source\": {\n          \"$artifact\": \"summary\",\n          \"index\": 2\n        },\n        \"columns\": [\n          {\n            \"name\": \"g0\",\n            \"type\": \"utf8\",\n            \"nullable\": true\n          },\n          {\n            \"name\": \"row_count\",\n            \"type\": \"int64\"\n          },\n          {\n            \"name\": \"total\",\n            \"type\": \"int64\",\n            \"nullable\": true\n          }\n        ],\n        \"select\": [\n          {\n            \"column\": \"g0\",\n            \"name\": \"region\"\n          },\n          {\n            \"column\": \"row_count\",\n            \"name\": \"count\"\n          },\n          {\n            \"column\": \"total\",\n            \"name\": \"total\"\n          }\n        ]\n      }\n    }\n  ]\n}\n","headings":[],"links":{}}
