{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemaxis.tool/1",
  "title": "Declared Schemaxis tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "revision", "title", "summary", "description", "tags", "author", "licence", "template", "display", "execution", "requirements", "provenance"],
  "properties": {
    "version": {"const": "schemaxis.tool/1"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "description": {"type": "string", "minLength": 1, "maxLength": 32768},
    "tags": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "author": {"type": "string", "minLength": 1, "maxLength": 128},
    "licence": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9.-]+$"},
    "template": {"type": "string", "minLength": 1, "maxLength": 512},
    "display": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "parameterGroups": {}, "parameterOrder": {}, "units": {}, "widgets": {},
        "examples": {}, "outputs": {}, "thumbnail": {}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["tier", "durationClass", "uploadedInputs"],
      "properties": {"tier": {"enum": ["browser", "local", "runner"]}, "durationClass": {"enum": ["short", "medium", "long", "unknown"]}, "uploadedInputs": {"type": "boolean"}}
    },
    "requirements": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["adaptor", "application", "versionRange"],
      "properties": {"adaptor": {"type": "string"}, "application": {"type": "string"}, "versionRange": {"type": "string"}, "image": {"type": "string"}}
    }},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["files"], "properties": {
      "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }}
  }
}
